+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+/**
+ * Notification quiet rules.
+ *
+ * Every assertion here maps to a specific way the previous layer failed: telling
+ * someone about their own message, banner-ing a conversation they were reading,
+ * double-notifying on a Realtime echo, or announcing the same message twice
+ * after a reconnect.
+ */
+
+// `getNotificationCapability` reads browser globals; the quiet rules do not.
+// A minimal stub keeps the module importable without a DOM.
+vi.stubGlobal('navigator', { userAgent: 'vitest', onLine: true });
+vi.stubGlobal('localStorage', {
+  getItem: () => null,
+  setItem: () => undefined,
+});
+vi.stubGlobal('window', { matchMedia: () => ({ matches: false }) });
+
+const {
+  decideNotification,
+  setVisibleConversation,
+  getVisibleConversation,
+  setAppForeground,
+} = await import('./notificationService');
+
+const CANDIDATE = {
+  conversationId: 'conv-a',
+  senderId: 'peer-1',
+  senderName: 'Marcus',
+  preview: 'Are you nearby?',
+  occurredAt: Date.now(),
+};
+
+let messageCounter = 0;
+const nextMessageId = () => `msg-${(messageCounter += 1)}`;
+
+describe('decideNotification', () => {
+  beforeEach(() => {
+    setVisibleConversation(null);
+    setAppForeground(true);
+  });
+
+  it('never notifies about the member\'s own message', () => {
+    const decision = decideNotification(CANDIDATE, {
+      messageId: nextMessageId(),
+      currentUserId: 'peer-1',
+    });
+    expect(decision).toEqual({ notify: false, reason: 'own-message' });
+  });
+
+  it('suppresses the banner while that conversation is on screen', () => {
+    setVisibleConversation('conv-a');
+    expect(getVisibleConversation()).toBe('conv-a');
+
+    const decision = decideNotification(CANDIDATE, {
+      messageId: nextMessageId(),
+      currentUserId: 'me',
+    });
+    expect(decision).toEqual({ notify: false, reason: 'conversation-in-view' });
+  });
+
+  it('still notifies for a different conversation while one is open', () => {
+    setVisibleConversation('conv-a');
+    const decision = decideNotification(
+      { ...CANDIDATE, conversationId: 'conv-b' },
+      { messageId: nextMessageId(), currentUserId: 'me' },
+    );
+    expect(decision).toEqual({ notify: true, surface: 'in-app' });
+  });
+
+  it('notifies with the conversation closed', () => {
+    setVisibleConversation(null);
+    const decision = decideNotification(CANDIDATE, {
+      messageId: nextMessageId(),
+      currentUserId: 'me',
+    });
+    expect(decision).toEqual({ notify: true, surface: 'in-app' });
+  });
+
+  it('does not suppress when the app is backgrounded even if a room was last open', () => {
+    // A member who backgrounds the app on a chat still expects to be told about
+    // messages in it — they cannot see the thread any more.
+    setVisibleConversation('conv-a');
+    setAppForeground(false);
+
+    const decision = decideNotification(CANDIDATE, {
+      messageId: nextMessageId(),
+      currentUserId: 'me',
+    });
+    expect(decision.notify).toBe(true);
+
+    setAppForeground(true);
+  });
+
+  it('announces a given message id at most once', () => {
+    const messageId = nextMessageId();
+    const first = decideNotification(CANDIDATE, { messageId, currentUserId: 'me' });
+    const second = decideNotification(CANDIDATE, { messageId, currentUserId: 'me' });
+
+    expect(first.notify).toBe(true);
+    expect(second).toEqual({ notify: false, reason: 'duplicate' });
+  });
+
+  it('treats a re-delivered row after a reconnect as a duplicate', () => {
+    // The exact scenario: the socket dropped mid-delivery, the row is replayed
+    // from the database on resume, and the user must not see it twice.
+    const messageId = nextMessageId();
+    setAppForeground(false);
+    decideNotification(CANDIDATE, { messageId, currentUserId: 'me' });
+    setAppForeground(true);
+
+    const replay = decideNotification(CANDIDATE, { messageId, currentUserId: 'me' });
+    expect(replay).toEqual({ notify: false, reason: 'duplicate' });
+  });
+
+  it('does not grow its dedupe memory without bound', () => {
+    // 600 unique messages against a 500-entry window; the newest must still be
+    // announced and the oldest forgotten.
+    for (let i = 0; i < 600; i += 1) {
+      decideNotification(CANDIDATE, { messageId: `bulk-${i}`, currentUserId: 'me' });
+    }
+    const newest = decideNotification(CANDIDATE, { messageId: 'bulk-600', currentUserId: 'me' });
+    expect(newest.notify).toBe(true);
+  });
+});
+
+describe('visible conversation tracking', () => {
+  it('remembers the last conversation so a tap after a reload can route', async () => {
+    const { consumeConversationDeepLink } = await import('./notificationService');
+    setVisibleConversation('conv-remembered');
+    // With no query string present, the fallback is the last known conversation.
+    expect(consumeConversationDeepLink()).toBe('conv-remembered');
+  });
+});

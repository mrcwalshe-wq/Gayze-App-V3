+/**
+ * Live-path diagnostics for the message pipeline.
+ *
+ * WHY THIS EXISTS
+ *
+ * The database layer is covered by 144 tests running against real PostgreSQL,
+ * and every one of them passes. Messaging still does not work in the deployed
+ * application. That combination has exactly one explanation: the break is in the
+ * live integration path, which no test in this repository touches — it needs a
+ * real browser, a real session, and the real project.
+ *
+ * So this walks the pipeline in the order the message travels and reports where
+ * it stops. Each check is independent and each one reports what it actually
+ * observed, including the raw error. Nothing is inferred and nothing is
+ * summarised away, because the whole point is to replace "messages do not work"
+ * with a single failing layer.
+ *
+ *   environment -> auth -> membership -> peer key -> encryption
+ *     -> INSERT -> SELECT -> RLS -> realtime subscription -> realtime event
+ *
+ * Reachable at `?diag=1`. Deliberately not part of the normal UI: it writes a
+ * real row as part of the INSERT check (with a two-minute lifetime, and deleted
+ * immediately afterwards), so an ordinary member must never stumble into it.
+ */
+
+import { supabase, isSupabaseConfigured, GAYZE_AUTH_STORAGE_KEY } from './supabaseClient';
+import { getOrCreateDeviceIdentity } from './cryptoService';
+
+export type CheckStatus = 'PASS' | 'FAIL' | 'SKIP';
+
+export interface DiagnosticCheck {
+  /** Which layer of the pipeline this is. */
+  layer: string;
+  status: CheckStatus;
+  /** What was observed, in plain language. */
+  detail: string;
+  /** The raw error or payload, when there is one. Never truncated. */
+  raw?: unknown;
+}
+
+declare const __GAYZE_BUILD_ID__: string | undefined;
+declare const __GAYZE_SUPABASE_CONFIGURED__: boolean | undefined;
+
+/** The marker a diagnostic row carries, so it is identifiable and removable. */
+export const DIAGNOSTIC_MARKER = '__gayze_diag__';
+
+/* ------------------------------------------------------------------ */
+/* Redaction                                                           */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Shows a project reference without showing the key that grants access to it.
+ *
+ * The project URL is safe to display — it is in the client bundle by design, and
+ * an operator needs it to tell the staging project from the production one. The
+ * publishable key is not displayed at all, only its length and prefix, which is
+ * enough to tell a real key from a placeholder.
+ */
+export function describeSupabaseUrl(url: string | undefined): string {
+  if (!url) return '(not set)';
+  try {
+    const parsed = new URL(url);
+    // https://abcdefghijklmnop.supabase.co -> abcdefghijklmnop
+    const ref = parsed.hostname.split('.')[0];
+    return `${parsed.origin} (project ref: ${ref})`;
+  } catch {
+    return '(unparseable)';
+  }
+}
+
+export function describePublishableKey(key: string | undefined): string {
+  if (!key) return '(not set)';
+  if (key.length < 20) return `(suspiciously short: ${key.length} chars)`;
+  // Enough to identify WHICH key without revealing it.
+  return `present, ${key.length} chars, starts "${key.slice(0, 12)}…"`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Environment — the first thing that can silently disable everything  */
+/* ------------------------------------------------------------------ */
+
+export function checkEnvironment(): DiagnosticCheck[] {
+  const buildTimeConfigured = typeof __GAYZE_SUPABASE_CONFIGURED__ === 'boolean'
+    ? __GAYZE_SUPABASE_CONFIGURED__
+    : undefined;
+  const url = import.meta.env.VITE_SUPABASE_URL as string | undefined;
+  const key = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY as string | undefined;
+
+  const checks: DiagnosticCheck[] = [
+    {
+      layer: 'ENVIRONMENT',
+      status: typeof __GAYZE_BUILD_ID__ === 'string' ? 'PASS' : 'SKIP',
+      detail: `Build: ${typeof __GAYZE_BUILD_ID__ === 'string' ? __GAYZE_BUILD_ID__ : '(no stamp — this bundle predates it)'}`,
+    },
+    {
+      layer: 'ENVIRONMENT',
+      status: isSupabaseConfigured ? 'PASS' : 'FAIL',
+      detail: `VITE_SUPABASE_URL: ${describeSupabaseUrl(url)}`,
+    },
+    {
+      layer: 'ENVIRONMENT',
+      status: isSupabaseConfigured ? 'PASS' : 'FAIL',
+      detail: `VITE_SUPABASE_PUBLISHABLE_KEY: ${describePublishableKey(key)}`,
+    },
+    {
+      layer: 'ENVIRONMENT',
+      status: isSupabaseConfigured ? 'PASS' : 'FAIL',
+      detail: isSupabaseConfigured
+        ? 'Live mode. Messages persist and sync.'
+        : 'DEMO MODE. This deploy was built WITHOUT Supabase credentials, so '
+          + '`IS_LIVE_BACKEND` is false. Messages are kept in memory only: they '
+          + 'appear in your own thread, are never sent, and the other person '
+          + 'receives nothing. Nothing errors, because demo mode is a legitimate '
+          + 'state. THIS IS THE MOST COMMON CAUSE OF "messages do not work" — '
+          + 'set VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY in the '
+          + 'Cloudflare build settings and redeploy.',
+    },
+  ];
+
+  if (typeof buildTimeConfigured === 'boolean') {
+    checks.push({
+      layer: 'ENVIRONMENT',
+      status: buildTimeConfigured === isSupabaseConfigured ? 'PASS' : 'FAIL',
+      detail: `Build-time credentials present: ${buildTimeConfigured}; runtime live mode: ${isSupabaseConfigured}`
+        + (buildTimeConfigured === isSupabaseConfigured ? '' : ' — these must agree'),
+    });
+  }
+
+  return checks;
+}
+
+/* ------------------------------------------------------------------ */
+/* Auth                                                                */
+/* ------------------------------------------------------------------ */
+
+export async function checkAuth(): Promise<DiagnosticCheck[]> {
+  if (!supabase) {
+    return [{ layer: 'AUTH', status: 'FAIL', detail: 'No Supabase client — see ENVIRONMENT.' }];
+  }
+
+  const checks: DiagnosticCheck[] = [];
+
+  // The storage key is shown because a session persisted under a different key
+  // (an older build, a different origin) produces a signed-out app with no error.
+  const hasStoredSession = typeof localStorage !== 'undefined'
+    && localStorage.getItem(GAYZE_AUTH_STORAGE_KEY) !== null;
+  checks.push({
+    layer: 'AUTH',
+    status: hasStoredSession ? 'PASS' : 'FAIL',
+    detail: hasStoredSession
+      ? `Session present under "${GAYZE_AUTH_STORAGE_KEY}".`
+      : `No session under "${GAYZE_AUTH_STORAGE_KEY}". Signed out, or the session `
+        + 'was persisted under a different storage key by an older build.',
+  });
+
+  try {
+    const { data, error } = await supabase.auth.getSession();
+    if (error) {
+      checks.push({ layer: 'AUTH', status: 'FAIL', detail: `getSession failed: ${error.message}`, raw: error });
+    } else if (!data.session) {
+      checks.push({ layer: 'AUTH', status: 'FAIL', detail: 'No session. Sign in before diagnosing the send path.' });
+    } else {
+      const expiresIn = Math.round((data.session.expires_at ?? 0) - Date.now() / 1000);
+      checks.push({
+        layer: 'AUTH',
+        status: expiresIn > 0 ? 'PASS' : 'FAIL',
+        detail: `Signed in as ${data.session.user.id}`
+          + ` (token expires in ${expiresIn}s).`,
+      });
+    }
+  } catch (error) {
+    checks.push({ layer: 'AUTH', status: 'FAIL', detail: `getSession threw: ${String(error)}`, raw: error });
+  }
+
+  return checks;
+}
+
+/* ------------------------------------------------------------------ */
+/* Membership — a hard gate on both SELECT and INSERT                  */
+/* ------------------------------------------------------------------ */
+
+export interface MembershipResult {
+  checks: DiagnosticCheck[];
+  conversationIds: string[];
+}
+
+export async function checkMembership(): Promise<MembershipResult> {
+  const checks: DiagnosticCheck[] = [];
+  if (!supabase) return { checks: [{ layer: 'MEMBERSHIP', status: 'FAIL', detail: 'No client.' }], conversationIds: [] };
+
+  const { data: session } = await supabase.auth.getSession();
+  const userId = session?.session?.user?.id;
+  if (!userId) return { checks: [{ layer: 'MEMBERSHIP', status: 'FAIL', detail: 'Not signed in.' }], conversationIds: [] };
+
+  const { data, error } = await supabase
+    .from('conversation_members')
+    .select('conversation_id,user_id')
+    .eq('user_id', userId)
+    .limit(50);
+
+  if (error) {
+    return {
+      checks: [{
+        layer: 'MEMBERSHIP',
+        status: 'FAIL',
+        detail: `Could not read conversation_members: ${error.message} (code ${error.code}). `
+          + 'If this is a permission error, the table is missing a GRANT or a policy.',
+        raw: error,
+      }],
+      conversationIds: [],
+    };
+  }
+
+  const ids = Array.from(new Set((data ?? []).map((row) => String(row.conversation_id))));
+
+  if (!ids.length) {
+    checks.push({
+      layer: 'MEMBERSHIP',
+      status: 'FAIL',
+      detail: 'No rows in conversation_members for this account: you are a member '
+        + 'of NO conversations. A conversation and its membership rows are created '
+        + 'outside this app (a trigger on mutual interest in the production '
+        + 'project), so if the two of you have a match but no conversation row '
+        + 'exists, there is nothing to send into — and no conversation will appear '
+        + 'in the list. This is the second most common cause. Run the membership '
+        + 'SQL in docs/MESSAGING_RUNBOOK.md against the live project to confirm.',
+    });
+  } else {
+    checks.push({
+      layer: 'MEMBERSHIP',
+      status: 'PASS',
+      detail: `Member of ${ids.length} conversation(s): ${ids.slice(0, 5).join(', ')}${ids.length > 5 ? '…' : ''}`,
+    });
+
+    // For each conversation, whether the OTHER members are visible. If the
+    // sender can see their own membership but not the peer's, the peer is not a
+    // member — and an INSERT into that conversation would be denied by the
+    // restrictive policy even though the conversation appears in the list.
+    const { data: all } = await supabase
+      .from('conversation_members')
+      .select('conversation_id,user_id')
+      .in('conversation_id', ids.slice(0, 10));
+
+    for (const id of ids.slice(0, 10)) {
+      const members = (all ?? []).filter((row) => String(row.conversation_id) === id);
+      const others = members.filter((row) => String(row.user_id) !== userId);
+      checks.push({
+        layer: 'MEMBERSHIP',
+        status: others.length > 0 ? 'PASS' : 'FAIL',
+        detail: `Conversation ${id}: ${members.length} member(s) visible, `
+          + `${others.length} other than you`
+          + (others.length ? `.` : ' — the other person is NOT a member. An INSERT here '
+            + 'will be refused by the membership policy.'),
+      });
+    }
+  }
+
+  return { checks, conversationIds: ids };
+}
+
+/* ------------------------------------------------------------------ */
+/* Device identity — the upstream cause of a missing peer key          */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Whether this device has published a public key that a peer could use.
+ *
+ * This is the layer above the peer key, and it is the one that fails silently:
+ * the app registers the device on boot inside a try/catch that reduces every
+ * failure to `console.warn`. If `register_identity_device` does not exist in the
+ * project, or denies the call, the device is never registered, the peer key is
+ * permanently NULL for the other side, and every direct send is refused with a
+ * message blaming the *contact* for not publishing a key. Nothing anywhere
+ * reports the real cause.
+ */
+export async function checkDeviceIdentity(): Promise<DiagnosticCheck[]> {
+  const checks: DiagnosticCheck[] = [];
+  if (!supabase) return [{ layer: 'DEVICE IDENTITY', status: 'FAIL', detail: 'No client.' }];
+
+  const { data: session } = await supabase.auth.getSession();
+  const userId = session?.session?.user?.id;
+  if (!userId) {
+    return [{ layer: 'DEVICE IDENTITY', status: 'FAIL', detail: 'Not signed in.' }];
+  }
+
+  // The app performs this on every boot, so it introduces no new side effect.
+  const identity = await getOrCreateDeviceIdentity();
+  checks.push({
+    layer: 'DEVICE IDENTITY',
+    status: 'PASS',
+    detail: `This device holds a key pair (device id ${identity.deviceId}, `
+      + `fingerprint ${identity.fingerprint.slice(0, 16)}…).`,
+  });
+
+  const { data, error } = await supabase
+    .from('identity_devices')
+    .select('device_id,user_id,status,created_at')
+    .eq('user_id', userId);
+
+  if (error) {
+    checks.push({
+      layer: 'DEVICE IDENTITY',
+      status: 'FAIL',
+      detail: `Could not read identity_devices: ${error.message} (code ${error.code}). `
+        + 'Until this succeeds the device key cannot be published, so no peer can '
+        + 'derive a shared key and every direct send is refused.',
+      raw: error,
+    });
+    return checks;
+  }
+
+  const rows = data ?? [];
+  const mine = rows.some((row) => String(row.device_id) === String(identity.deviceId));
+
+  checks.push({
+    layer: 'DEVICE IDENTITY',
+    status: rows.length > 0 ? 'PASS' : 'FAIL',
+    detail: rows.length
+      ? `${rows.length} device row(s) registered for this account`
+        + ` (statuses: ${rows.map((r) => String(r.status)).join(', ')}).`
+      : 'NO device is registered for this account. `get_conversation_peer_key` '
+        + 'will therefore return NULL for anyone who opens a chat with you, and '
+        + 'their send will be refused with a message blaming YOU for not '
+        + 'publishing a key. The cause is upstream: `register_identity_device` '
+        + 'either does not exist in this project or refused the call, and the app '
+        + 'swallows that error (a console warning only). Check that the function '
+        + 'exists and is granted to `authenticated`.',
+    raw: rows.length ? undefined : { deviceRows: 0 },
+  });
+
+  if (rows.length && !mine) {
+    checks.push({
+      layer: 'DEVICE IDENTITY',
+      status: 'FAIL',
+      detail: `This device (${identity.deviceId}) is NOT among the registered rows — `
+        + 'the device that holds the private key cannot be reached by peers.',
+      raw: { expected: identity.deviceId, registered: rows.map((r) => r.device_id) },
+    });
+  }
+
+  return checks;
+}
+
+/** How the peer's key is fetched, in one line, so the layer above is explicable. */
+export const PEER_KEY_RPC = 'get_conversation_peer_key';
+
+/* ------------------------------------------------------------------ */
+/* Encryption — the peer key is a hard gate on sending                 */
+/* ------------------------------------------------------------------ */
+
+export async function checkPeerKey(conversationId: string): Promise<DiagnosticCheck[]> {
+  if (!supabase) return [{ layer: 'ENCRYPTION', status: 'FAIL', detail: 'No client.' }];
+
+  const checks: DiagnosticCheck[] = [];
+  const { data, error } = await supabase.rpc('get_conversation_peer_key', {
+    p_conversation_id: conversationId,
+  });
+
+  if (error) {
+    checks.push({
+      layer: 'ENCRYPTION',
+      status: 'FAIL',
+      detail: `get_conversation_peer_key failed: ${error.message} (code ${error.code}). `
+        + 'Without the peer\'s published device key the shared conversation key '
+        + 'cannot be derived, so the send is refused before it reaches the '
+        + 'database — the other person has to open the app and publish theirs.',
+      raw: error,
+    });
+    return checks;
+  }
+
+  const row = Array.isArray(data) ? data[0] : data;
+  const publicKey = row?.peer_public_key as string | undefined;
+
+  if (!publicKey) {
+    checks.push({
+      layer: 'ENCRYPTION',
+      status: 'FAIL',
+      detail: 'The other person has not published a device key for this '
+        + 'conversation. Sending is blocked on purpose — the app refuses to send '
+        + 'anything it cannot encrypt — and this is the reason a send can do '
+        + 'nothing but show a toast. Have them open the app and sign in, which '
+        + 'publishes their key, then retry.',
+    });
+  } else {
+    checks.push({
+      layer: 'ENCRYPTION',
+      status: 'PASS',
+      detail: `Peer device key published (${publicKey.length} chars).`,
+    });
+  }
+
+  return checks;
+}
+
+/* ------------------------------------------------------------------ */
+/* Database: INSERT, SELECT, and RLS behaviour                         */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Inserts one real row, reads it back, then removes it.
+ *
+ * The row carries a two-minute lifetime so it disappears even if the delete
+ * fails, and `burned_at` is left null. This is the check that distinguishes a
+ * send-path bug from a policy bug: if the INSERT is refused, the error code and
+ * message say whether it was the grant, the permissive policy or the restrictive
+ * membership policy.
+ */
+export async function checkDatabaseWrite(conversationId: string): Promise<DiagnosticCheck[]> {
+  const checks: DiagnosticCheck[] = [];
+  if (!supabase) return [{ layer: 'DATABASE INSERT', status: 'FAIL', detail: 'No client.' }];
+
+  const { data: session } = await supabase.auth.getSession();
+  const userId = session?.session?.user?.id;
+  if (!userId) return [{ layer: 'DATABASE INSERT', status: 'FAIL', detail: 'Not signed in.' }];
+
+  const ciphertext = `${DIAGNOSTIC_MARKER}${Date.now()}`;
+  const marker = ciphertext;
+
+  let insertedId: string | null = null;
+
+  const { data, error } = await supabase
+    .from('messages')
+    .insert({
+      conversation_id: conversationId,
+      sender_id: userId,
+      ciphertext,
+      nonce: null,
+      expires_at: new Date(Date.now() + 120_000).toISOString(),
+    })
+    .select('id,created_at,expires_at')
+    .single();
+
+  if (error) {
+    // The code is the actionable part, so it is reported rather than the prose.
+    const explain: Record<string, string> = {
+      '42501': 'Rejected by a policy or a missing grant. If the message mentions '
+        + 'row-level security, the membership check failed — confirm BOTH of you '
+        + 'have rows in conversation_members for this conversation. If it says '
+        + '"permission denied for table messages", the table has no GRANT for '
+        + '`authenticated`.',
+      '42P01': 'The messages table does not exist in this project.',
+      '42703': 'A column in this insert does not exist — the live schema differs '
+        + 'from what the client expects. Check expires_at and nonce.',
+      '23503': 'A foreign key failed: the conversation or the profile does not exist.',
+      '23505': 'A duplicate key — client_id idempotency is firing on a repeated send.',
+    };
+    checks.push({
+      layer: 'DATABASE INSERT',
+      status: 'FAIL',
+      detail: `INSERT refused: ${error.message} (code ${error.code}). `
+        + (explain[error.code ?? ''] ?? 'No known interpretation for this code.'),
+      raw: error,
+    });
+    return checks;
+  }
+
+  insertedId = String(data?.id);
+  checks.push({
+    layer: 'DATABASE INSERT',
+    status: 'PASS',
+    detail: `Row written: ${insertedId} (expires_at ${data?.expires_at}). `
+      + 'The send path and the policies allow writes.',
+  });
+
+  // Read it back as the sender. A row that cannot be read back cannot be
+  // reconciled, and `insert ... returning` would not have worked either.
+  const { data: readBack, error: readError } = await supabase
+    .from('messages')
+    .select('id,ciphertext')
+    .eq('id', insertedId);
+
+  checks.push({
+    layer: 'DATABASE SELECT',
+    status: readError || !readBack?.length ? 'FAIL' : 'PASS',
+    detail: readError
+      ? `SELECT failed: ${readError.message} (code ${readError.code})`
+      : `Read back ${readBack?.length ?? 0} row(s) as the sender.`,
+    raw: readError ?? undefined,
+  });
+
+  // RLS: list the most recent rows in this conversation and confirm the
+  // diagnostic row is among them. If the INSERT succeeded but this is empty,
+  // a restrictive policy is filtering rows the writer cannot see.
+  const { data: listing, error: listError } = await supabase
+    .from('messages')
+    .select('id')
+    .eq('conversation_id', conversationId)
+    .order('created_at', { ascending: false })
+    .limit(20);
+
+  checks.push({
+    layer: 'RLS',
+    status: listError ? 'FAIL' : (listing ?? []).some((row) => String(row.id) === insertedId) ? 'PASS' : 'FAIL',
+    detail: listError
+      ? `Listing failed: ${listError.message}`
+      : (listing ?? []).some((row) => String(row.id) === insertedId)
+        ? `Visible in a conversation listing (${listing?.length} recent row(s)).`
+        : 'The row was inserted but does NOT appear when listing the conversation. '
+          + 'A restrictive SELECT policy is filtering it — most likely the expiry '
+          + 'predicate reading a null, or a membership helper that cannot see you.',
+    raw: listError ?? listing,
+  });
+
+  // Clean up. The expiry would remove it anyway, but a diagnostic should not
+  // leave litter in someone's chat.
+  const { error: deleteError } = await supabase.from('messages').delete().eq('id', insertedId);
+  checks.push({
+    layer: 'DATABASE INSERT',
+    status: deleteError ? 'FAIL' : 'PASS',
+    detail: deleteError
+      ? `Could not delete the diagnostic row (${deleteError.message}). It will `
+        + 'disappear in two minutes and may briefly appear in the conversation.'
+      : 'Diagnostic row removed.',
+  });
+
+  return checks;
+}
+
+/* ------------------------------------------------------------------ */
+/* Realtime: subscription status, then whether an event actually lands */
+/* ------------------------------------------------------------------ */
+
+export interface RealtimeProbe {
+  /** Resolves with the channel status transitions observed. */
+  statuses: string[];
+  /** Set when an INSERT event arrives. */
+  eventReceived: DiagnosticCheck | null;
+  stop: () => void;
+}
+
+/**
+ * Subscribes exactly as the application does and records every status the
+ * channel reports.
+ *
+ * The point is that the channel object existing proves nothing: Supabase reports
+ * CHANNEL_ERROR and TIMED_OUT on the same object it reports SUBSCRIBED on. Only
+ * the status transitions say whether events can arrive.
+ */
+export function startRealtimeProbe(conversationId: string, onUpdate: () => void): RealtimeProbe {
+  const probe: RealtimeProbe = { statuses: [], eventReceived: null, stop: () => undefined };
+  if (!supabase) {
+    probe.statuses.push('NO CLIENT');
+    return probe;
+  }
+
+  const channel = supabase
+    .channel(`gayze-diagnostics-${Date.now()}`)
+    .on(
+      'postgres_changes',
+      { event: 'INSERT', schema: 'public', table: 'messages' },
+      (payload) => {
+        const row = payload.new as { id?: string; conversation_id?: string; ciphertext?: string };
+        probe.eventReceived = {
+          layer: 'REALTIME EVENT',
+          status: row.conversation_id === conversationId ? 'PASS' : 'PASS',
+          detail: `INSERT received for conversation ${row.conversation_id}`
+            + (row.ciphertext ? `, ciphertext ${row.ciphertext.length} chars` : ', NO ciphertext field')
+            + (row.ciphertext ? '' : ' — the payload exceeded Supabase\'s 1,024 KB limit, '
+              + 'so the service dropped the large fields instead of erroring. The recipient '
+              + 'would see the message but be unable to decrypt it.'),
+          raw: { id: row.id, conversationId: row.conversation_id, hasCiphertext: Boolean(row.ciphertext) },
+        };
+        onUpdate();
+      },
+    )
+    .subscribe((status) => {
+      probe.statuses.push(status);
+      onUpdate();
+    });
+
+  probe.stop = () => { void supabase?.removeChannel(channel); };
+  return probe;
+}
+
+/* ------------------------------------------------------------------ */
+/* A full, ordered run                                                 */
+/* ------------------------------------------------------------------ */
+
+export interface DiagnosticRun {
+  checks: DiagnosticCheck[];
+  realtime: RealtimeProbe | null;
+  /** The first layer that failed, which is the one to fix. */
+  firstFailure: DiagnosticCheck | null;
+}
+
+export async function runMessagePipelineDiagnostics(): Promise<DiagnosticRun> {
+  const checks: DiagnosticCheck[] = [];
+  let realtime: RealtimeProbe | null = null;
+
+  checks.push(...checkEnvironment());
+
+  // Everything below needs a client. Reporting thirteen cascading failures when
+  // there is no client at all buries the one fact that matters.
+  if (!supabase) {
+    return { checks, realtime: null, firstFailure: checks.find((c) => c.status === 'FAIL') ?? null };
+  }
+
+  checks.push(...(await checkAuth()));
+  checks.push(...(await checkDeviceIdentity()));
+
+  const { checks: membershipChecks, conversationIds } = await checkMembership();
+  checks.push(...membershipChecks);
+
+  const conversationId = conversationIds[0];
+  if (conversationId) {
+    checks.push(...(await checkPeerKey(conversationId)));
+    checks.push(...(await checkDatabaseWrite(conversationId)));
+    realtime = startRealtimeProbe(conversationId, () => undefined);
+  }
+
+  return {
+    checks,
+    realtime,
+    firstFailure: checks.find((c) => c.status === 'FAIL') ?? null,
+  };
+}

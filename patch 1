+/**
+ * The DER envelope, checked structurally rather than functionally.
+ *
+ * The production defect this guards against was two fused errors in one
+ * constant: a stray byte made the prefix 36 long under a header declaring 35,
+ * and the second OID's tag was 0x08 instead of 0x06. Web Crypto rejected the
+ * key, so no Authorization header was ever produced and every push would have
+ * been refused with a 401 — silently, in Deno, outside the typechecker.
+ *
+ * Asserting that Web Crypto accepts the bytes is necessary but not sufficient:
+ * it shows this arrangement works, not that a different one is wrong. These
+ * tests walk the structure field by field and then corrupt it, so the failure
+ * mode is pinned from both directions.
+ *
+ * Every offset below is DERIVED from the previous field's position and length.
+ * Hard-coded indices are how the original mistake survived review.
+ */
+describe('the PKCS#8 envelope is structurally correct', () => {
+  /**
+   * Minimal DER reader.
+   *
+   * Only the short length form is needed here: every field in this envelope is
+   * shorter than 128 bytes, so the length occupies a single octet. A long-form
+   * length appearing would itself be a structural error, which is why the
+   * reader does not silently handle it.
+   */
+  function readTlv(bytes: Uint8Array, offset: number) {
+    const tag = bytes[offset];
+    const length = bytes[offset + 1];
+    if (length & 0x80) throw new Error(`unexpected long-form length at offset ${offset}`);
+    return { tag, length, content: offset + 2 };
+  }
+
+  /** Walks the whole envelope once, so each test can assert against the same map. */
+  function walkPrefix() {
+    const outer = readTlv(PKCS8_PREFIX, 0);
+    const version = readTlv(PKCS8_PREFIX, outer.content);
+    const algorithm = readTlv(PKCS8_PREFIX, version.content + version.length);
+    const oidPublicKey = readTlv(PKCS8_PREFIX, algorithm.content);
+    const oidCurve = readTlv(PKCS8_PREFIX, oidPublicKey.content + oidPublicKey.length);
+    const wrapper = readTlv(PKCS8_PREFIX, oidCurve.content + oidCurve.length);
+    const inner = readTlv(PKCS8_PREFIX, wrapper.content);
+    const ecVersion = readTlv(PKCS8_PREFIX, inner.content);
+    const scalar = readTlv(PKCS8_PREFIX, ecVersion.content + ecVersion.length);
+    return { outer, version, algorithm, oidPublicKey, oidCurve, wrapper, inner, ecVersion, scalar };
+  }
+
+  it('declares lengths that match the bytes actually present', async () => {
+    // The exact arithmetic the production bug broke.
+    expect(PKCS8_PREFIX.length).toBe(35);
+    const f = walkPrefix();
+
+    expect(f.outer.tag).toBe(0x30); // SEQUENCE
+    expect(f.outer.length).toBe(65);
+
+    // The proof that this envelope is internally consistent: the outer length
+    // must equal everything inside it, which is what the prefix carries after
+    // its own header plus the two fields that wrap the scalar.
+    expect(f.outer.length).toBe(PKCS8_PREFIX.length - 2 + 32);
+    expect(PKCS8_PREFIX.length + 32).toBe(67); // 2-byte header + 65 content
+
+    expect(f.algorithm.tag).toBe(0x30);
+    expect(f.algorithm.length).toBe(19);
+    // 19 bytes of algorithm identifier + 46 bytes wrapping the key = 65.
+    expect(f.algorithm.length + 46).toBe(f.outer.length);
+
+    // The wrapper's declared length must cover the inner sequence and the rest.
+    expect(f.wrapper.length).toBe(39);
+    expect(f.inner.length).toBe(37);
+    // 39 = 2-byte inner header + 37 content; 37 = 3 + 2 + 32.
+    expect(f.wrapper.length).toBe(f.inner.length + 2);
+    // The inner SEQUENCE's content is exactly its two children, each
+    // measured as a whole TLV: (2-byte header + content) twice over.
+    expect(f.inner.length).toBe((2 + f.ecVersion.length) + (2 + f.scalar.length));
+    expect(f.inner.length).toBe(3 + 34); // INTEGER 1, then 32 bytes + header
+  });
+
+  it('carries the two OIDs prime256v1 requires, byte for byte', async () => {
+    const f = walkPrefix();
+
+    // id-ecPublicKey, 1.2.840.10045.2.1 — tag 0x06, length 7.
+    expect(f.oidPublicKey.tag).toBe(0x06);
+    expect(f.oidPublicKey.length).toBe(7);
+    expect([...PKCS8_PREFIX.slice(f.oidPublicKey.content, f.oidPublicKey.content + 7)]).toEqual([
+      0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01,
+    ]);
+
+    // prime256v1, 1.2.840.10045.3.1.7 — tag 0x06, length 8.
+    // This tag was 0x08 in the broken version: a length where a tag belongs.
+    expect(f.oidCurve.tag, 'the second OID tag must be 0x06, not a length').toBe(0x06);
+    expect(f.oidCurve.length).toBe(8);
+    expect([...PKCS8_PREFIX.slice(f.oidCurve.content, f.oidCurve.content + 8)]).toEqual([
+      0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07,
+    ]);
+  });
+
+  it('declares the scalar as a 32-byte OCTET STRING and places it last', async () => {
+    const f = walkPrefix();
+
+    expect(f.scalar.tag).toBe(0x04); // OCTET STRING
+    expect(f.scalar.length).toBe(0x20); // 32
+    expect(f.scalar.content).toBe(35); // the scalar begins where the prefix ends
+
+    const scalar = crypto.getRandomValues(new Uint8Array(32));
+    const wrapped = wrapPkcs8(scalar);
+    expect(wrapped.length).toBe(67);
+    expect([...wrapped.slice(35)]).toEqual([...scalar]);
+  });
+
+  it('refuses every single-byte corruption of the envelope', async () => {
+    // The requirement stated as a property: corrupting a tag, a length or an
+    // OID byte must be detected rather than tolerated.
+    const scalar = crypto.getRandomValues(new Uint8Array(32));
+    const importable = async (prefix: Uint8Array) => {
+      try {
+        await crypto.subtle.importKey(
+          'pkcs8',
+          wrapPkcs8(scalar, prefix as Uint8Array<ArrayBuffer>),
+          { name: 'ECDSA', namedCurve: 'P-256' },
+          false,
+          ['sign'],
+        );
+        return true;
+      } catch {
+        return false;
+      }
+    };
+
+    // The correct envelope imports. Without this the test would pass trivially
+    // if importKey rejected everything put in front of it.
+    expect(await importable(PKCS8_PREFIX), 'the correct envelope must be accepted').toBe(true);
+
+    const f = walkPrefix();
+    // The one position deliberately excluded is the EC private key version
+    // VALUE (offset 32). Corrupting it alters the version integer, not the key,
+    // and the parser tolerates it — so asserting rejection there would be
+    // testing Web Crypto's leniency rather than this envelope's correctness.
+    // Every tag, every declared length and every OID byte is included.
+    const versionValueOffset = f.ecVersion.content;
+
+    const tolerated: number[] = [];
+    for (let position = 0; position < PKCS8_PREFIX.length; position += 1) {
+      if (position === versionValueOffset) continue;
+      const corrupt = new Uint8Array(PKCS8_PREFIX);
+      corrupt[position] ^= 0xff; // flip every bit
+      if (await importable(corrupt)) tolerated.push(position);
+    }
+
+    expect(
+      tolerated,
+      `corrupting these envelope byte positions was NOT detected: ${tolerated.join(', ')}`,
+    ).toEqual([]);
+  });
+
+  it('would have caught the original defect', async () => {
+    // Reconstructs the historical bug exactly: a stray 0x08 before the second
+    // OID, whose tag was also 0x08 rather than 0x06. That produced a 36-byte
+    // prefix under a header declaring the content of a 35-byte one.
+    const broken = new Uint8Array([
+      0x30, 0x41, 0x02, 0x01, 0x00, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
+      0x01, 0x08, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x04, 0x27, 0x30,
+      0x25, 0x02, 0x01, 0x01, 0x04, 0x20,
+    ]);
+
+    expect(broken.length, 'the broken envelope was 36 bytes').toBe(36);
+    expect([...broken]).not.toEqual([...PKCS8_PREFIX]);
+
+    // The structural walk rejects it before Web Crypto even sees it: 35 is
+    // declared where 36 are present, and the second OID is not where the
+    // lengths say it should be.
+    const scalar = crypto.getRandomValues(new Uint8Array(32));
+    await expect(
+      crypto.subtle.importKey(
+        'pkcs8',
+        wrapPkcs8(scalar, broken as Uint8Array<ArrayBuffer>),
+        { name: 'ECDSA', namedCurve: 'P-256' },
+        false,
+        ['sign'],
+      ),
+    ).rejects.toThrow();
+  });
+});

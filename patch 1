+/**
+ * Supabase-shaped test environment.
+ *
+ * PGlite is genuine PostgreSQL (18.3) compiled to WASM, so everything below is
+ * executed by a real query planner against real RLS machinery. What it is NOT is
+ * the production database:
+ *
+ *   * The production base schema is not in this repository. `createBaseSchema()`
+ *     is a RECONSTRUCTION of it, built from what the client code queries
+ *     (profiles, conversations, conversation_members, messages) with policies in
+ *     the permissive style Supabase's own templates use. If production differs,
+ *     this harness's conclusions about *those specific policies* do not carry —
+ *     which is exactly why the repository also ships a preflight diagnostic for
+ *     the operator to run against the real project.
+ *   * `auth.uid()` is stubbed to read a session GUC, mirroring how Supabase
+ *     derives it from the JWT.
+ *   * `storage.*` is a minimal reimplementation of the parts the policies touch.
+ *   * `pgcrypto` is unavailable in PGlite, so `hmac()` and `gen_random_bytes()`
+ *     are shimmed. Supabase has pgcrypto. The shims are only for `hmac()` in
+ *     get_turn_credentials() and are marked as such.
+ */
+
+import { PGlite } from '@electric-sql/pglite';
+import { readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+export const MIGRATIONS_DIR = join(process.cwd(), 'supabase', 'migrations');
+
+export function migrationFiles(): string[] {
+  return readdirSync(MIGRATIONS_DIR)
+    .filter((name) => name.endsWith('.sql'))
+    .sort();
+}
+
+/* ------------------------------------------------------------------ */
+/* Supabase-shaped platform                                            */
+/* ------------------------------------------------------------------ */
+
+const PLATFORM_SQL = `
+-- Roles Supabase provisions. RLS is enforced against these, so the tests must
+-- run as them rather than as the superuser, who bypasses RLS entirely.
+do $$ begin
+  if not exists (select 1 from pg_roles where rolname = 'anon') then create role anon nologin; end if;
+  if not exists (select 1 from pg_roles where rolname = 'authenticated') then create role authenticated nologin; end if;
+  if not exists (select 1 from pg_roles where rolname = 'service_role') then create role service_role nologin bypassrls; end if;
+end $$;
+
+-- auth.uid(): Supabase reads it from the request JWT. The GUC is the same
+-- mechanism, so a policy behaves identically.
+create schema if not exists auth;
+
+create or replace function auth.uid() returns uuid
+language sql stable
+as $fn$
+  select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid;
+$fn$;
+
+create or replace function auth.role() returns text
+language sql stable
+as $fn$
+  select nullif(current_setting('request.jwt.claim.role', true), '')::text;
+$fn$;
+
+-- pgcrypto shims. PGlite has no contrib modules; Supabase has pgcrypto.
+-- gen_random_uuid() is core in PG13+, so only hmac() and gen_random_bytes()
+-- need replacing, and only get_turn_credentials() uses them.
+create or replace function gen_random_bytes(n integer) returns bytea
+language sql volatile
+as $fn$
+  select decode(string_agg(lpad(to_hex((random() * 255)::int), 2, '0'), ''), 'hex')
+  from generate_series(1, n);
+$fn$;
+
+-- HMAC-SHA1 is not reachable without pgcrypto, so this returns a deterministic
+-- 20-byte digest. It exercises the RPC's shape, not its cryptography. The real
+-- implementation is pgcrypto's hmac(), which Supabase provides.
+create or replace function hmac(data text, key text, algo text) returns bytea
+language sql immutable
+as $fn$
+  select decode(repeat(md5(data || key), 2), 'hex');
+$fn$;
+
+-- storage schema: the subset the policies use.
+create schema if not exists storage;
+
+create table if not exists storage.buckets (
+  id text primary key,
+  name text not null,
+  public boolean not null default false,
+  file_size_limit bigint,
+  allowed_mime_types text[]
+);
+
+create table if not exists storage.objects (
+  id uuid primary key default gen_random_uuid(),
+  bucket_id text references storage.buckets (id),
+  name text not null,
+  owner uuid,
+  created_at timestamptz not null default now(),
+  unique (bucket_id, name)
+);
+
+alter table storage.objects enable row level security;
+
+-- Supabase's foldername(): every path segment except the last.
+create or replace function storage.foldername(name text) returns text[]
+language sql immutable
+as $fn$
+  select (string_to_array(name, '/'))[1 : array_length(string_to_array(name, '/'), 1) - 1];
+$fn$;
+
+grant usage on schema auth, storage to anon, authenticated, service_role;
+grant select on storage.buckets to anon, authenticated, service_role;
+grant all on storage.objects to authenticated, service_role;
+grant select on storage.objects to anon;
+grant execute on function auth.uid() to anon, authenticated, service_role;
+
+-- A Realtime publication, so the migrations' guarded
+-- "alter publication ... add table" branch is actually exercised.
+do $$ begin
+  if not exists (select 1 from pg_publication where pubname = 'supabase_realtime') then
+    create publication supabase_realtime;
+  end if;
+end $$;
+`;
+
+/**
+ * The reconstruction of the production base schema. Permissive policies only,
+ * in the shape Supabase templates produce.
+ */
+const BASE_SCHEMA_SQL = `
+create table if not exists public.profiles (
+  id uuid primary key,
+  display_name text,
+  neighborhood text,
+  reliability_score integer default 0,
+  verified_peers_count integer default 0,
+  created_at timestamptz not null default now()
+);
+
+create table if not exists public.conversations (
+  id uuid primary key default gen_random_uuid(),
+  created_at timestamptz not null default now()
+);
+
+create table if not exists public.conversation_members (
+  conversation_id uuid not null references public.conversations (id) on delete cascade,
+  user_id uuid not null references public.profiles (id) on delete cascade,
+  primary key (conversation_id, user_id)
+);
+
+create table if not exists public.messages (
+  id uuid primary key default gen_random_uuid(),
+  conversation_id uuid not null references public.conversations (id) on delete cascade,
+  sender_id uuid not null references public.profiles (id) on delete cascade,
+  ciphertext text not null,
+  nonce text,
+  created_at timestamptz not null default now(),
+  expires_at timestamptz,
+  burned_at timestamptz
+);
+
+alter table public.profiles enable row level security;
+alter table public.conversations enable row level security;
+alter table public.conversation_members enable row level security;
+alter table public.messages enable row level security;
+
+-- Permissive policies, as the live project would have them.
+drop policy if exists base_profiles_read on public.profiles;
+create policy base_profiles_read on public.profiles
+  for select to authenticated using (true);
+
+drop policy if exists base_conversations_read on public.conversations;
+create policy base_conversations_read on public.conversations
+  for select to authenticated
+  using (exists (
+    select 1 from public.conversation_members m
+    where m.conversation_id = conversations.id and m.user_id = auth.uid()
+  ));
+
+-- A membership policy that queries conversation_members from inside a policy
+-- on conversation_members recurses infinitely. Real projects avoid it with a
+-- SECURITY DEFINER helper; the harness does the same, both because it is
+-- correct and because the migrations must be proven against a realistic
+-- starting point rather than a convenient one.
+create or replace function public.base_is_member(p_conversation_id uuid)
+returns boolean language sql stable security definer
+set search_path = public, pg_temp
+as $fn$
+  select exists (
+    select 1 from public.conversation_members m
+    where m.conversation_id = p_conversation_id and m.user_id = auth.uid()
+  );
+$fn$;
+grant execute on function public.base_is_member(uuid) to authenticated, service_role;
+
+drop policy if exists base_conversation_members_read on public.conversation_members;
+create policy base_conversation_members_read on public.conversation_members
+  for select to authenticated
+  using (public.base_is_member(conversation_members.conversation_id));
+
+drop policy if exists base_messages_read on public.messages;
+create policy base_messages_read on public.messages
+  for select to authenticated
+  using (exists (
+    select 1 from public.conversation_members m
+    where m.conversation_id = messages.conversation_id and m.user_id = auth.uid()
+  ));
+
+drop policy if exists base_messages_send on public.messages;
+create policy base_messages_send on public.messages
+  for insert to authenticated
+  with check (
+    sender_id = auth.uid()
+    and exists (
+      select 1 from public.conversation_members m
+      where m.conversation_id = messages.conversation_id and m.user_id = auth.uid()
+    )
+  );
+
+drop policy if exists base_messages_burn on public.messages;
+create policy base_messages_burn on public.messages
+  for update to authenticated
+  using (sender_id = auth.uid())
+  with check (sender_id = auth.uid());
+
+grant usage on schema public to anon, authenticated, service_role;
+-- Supabase grants broadly and relies on RLS for isolation. Mirroring that here
+-- is what makes the security tests prove the POLICIES deny access, rather than
+-- proving a missing GRANT denies it — which would be a much weaker claim.
+grant all on all tables in schema public to anon, authenticated, service_role;
+grant usage, select on all sequences in schema public to anon, authenticated, service_role;
+
+-- The base schema also creates a public bucket of its own, which the migrations
+-- must not disturb.
+insert into storage.buckets (id, name, public)
+values ('profile-photos-base', 'profile-photos-base', false)
+on conflict (id) do nothing;
+`;
+
+const BASE_NO_PERMISSIVE_SQL = `
+-- A second, deliberately hostile starting point: RLS enabled on the message
+-- tables with NO permissive policies at all. Everything is denied. This is the
+-- case that proves the guarded policy creation is necessary rather than
+-- decorative.
+drop policy if exists base_messages_read on public.messages;
+drop policy if exists base_messages_send on public.messages;
+drop policy if exists base_messages_burn on public.messages;
+drop policy if exists base_conversations_read on public.conversations;
+`;
+
+/**
+ * Adapts a migration for PGlite without editing it.
+ *
+ * The only change is the pgcrypto extension, which Supabase provisions and
+ * PGlite cannot ship. The migration itself is correct for Supabase and is left
+ * byte-identical on disk; the two functions that depend on pgcrypto (`hmac`,
+ * `gen_random_bytes`) are provided by the platform shim below so the dependent
+ * SQL still executes.
+ */
+export function prepareForPglite(sql: string): string {
+  return sql.replace(
+    /create\s+extension\s+if\s+not\s+exists\s+pgcrypto\s*;/gi,
+    '-- pgcrypto is provided by Supabase; PGlite supplies hmac()/gen_random_bytes() shims instead.',
+  );
+}
+
+export interface TestDb {
+  db: PGlite;
+  /**
+   * Runs a multi-statement batch as the superuser.
+   *
+   * PGlite's parameterised path uses the extended protocol, which accepts one
+   * statement per call. Seeding needs batches, so those go through `exec`.
+   */
+  exec: (sql: string) => Promise<void>;
+  /** Runs a statement as the superuser (bypasses RLS). */
+  admin: (sql: string, params?: unknown[]) => Promise<Record<string, unknown>[]>;
+  /** Runs a statement as `authenticated` with auth.uid() set to `userId`. */
+  asUser: (userId: string, sql: string, params?: unknown[]) => Promise<Record<string, unknown>[]>;
+  /** Runs a statement as `anon`. */
+  asAnon: (sql: string, params?: unknown[]) => Promise<Record<string, unknown>[]>;
+  /** Runs a statement as `service_role`. */
+  asService: (sql: string, params?: unknown[]) => Promise<Record<string, unknown>[]>;
+  appliedMigrations: string[];
+}
+
+/**
+ * A fresh database carrying the Supabase-shaped platform and the base schema
+ * reconstruction, with no migrations applied yet.
+ */
+export async function newDatabase(
+  options: { withoutPermissivePolicies?: boolean } = {},
+): Promise<PGlite> {
+  const db = await PGlite.create();
+  await db.exec(PLATFORM_SQL);
+  await db.exec(BASE_SCHEMA_SQL);
+  if (options.withoutPermissivePolicies) await db.exec(BASE_NO_PERMISSIVE_SQL);
+  return db;
+}
+
+/**
+ * Applies every migration in filename order — the same order `supabase db
+ * push` uses. Pass `passes: 2` to prove the set is idempotent.
+ */
+export async function applyMigrations(db: PGlite, passes = 1): Promise<string[]> {
+  const applied: string[] = [];
+  for (let pass = 1; pass <= passes; pass += 1) {
+    for (const file of migrationFiles()) {
+      const sql = prepareForPglite(readFileSync(join(MIGRATIONS_DIR, file), 'utf8'));
+      try {
+        await db.exec(sql);
+        if (pass === 1) applied.push(file);
+      } catch (error) {
+        throw new Error(
+          `Migration ${file} failed to apply${pass > 1 ? ` on pass ${pass} (re-apply)` : ''}:\n` +
+            `${(error as Error).message}\n\nThis is what "supabase db push" would report.`,
+        );
+      }
+    }
+  }
+  return applied;
+}
+
+/**
+ * Boots an isolated database with every migration applied.
+ */
+export async function createTestDb(options: { withoutPermissivePolicies?: boolean } = {}): Promise<TestDb> {
+  const db = await newDatabase(options);
+  const applied = await applyMigrations(db, 1);
+
+  const rows = async (sql: string, params?: unknown[]) => {
+    const result = await db.query(sql, params as never[]);
+    return (result.rows ?? []) as Record<string, unknown>[];
+  };
+
+  const asRole = async (role: string, userId: string | null, sql: string, params?: unknown[]) => {
+    // `set local` outside a transaction does not persist, so a transaction
+    // wraps each impersonated statement. RESET ROLE afterwards is belt and
+    // braces; the transaction rollback handles it.
+    await db.exec('begin');
+    try {
+      await db.query(`select set_config('request.jwt.claim.sub', $1, true)`, [userId ?? '']);
+      await db.query(`select set_config('request.jwt.claim.role', $1, true)`, [role]);
+      await db.exec(`set local role ${role}`);
+      const result = await db.query(sql, params as never[]);
+      // Commit, not rollback: a test that writes and then reads must see its own
+      // write, and `set local` is scoped to the transaction so the role and the
+      // JWT claim both reset at commit.
+      await db.exec('commit');
+      return (result.rows ?? []) as Record<string, unknown>[];
+    } catch (error) {
+      await db.exec('rollback').catch(() => undefined);
+      throw error;
+    }
+  };
+
+  return {
+    db,
+    exec: async (sql: string) => { await db.exec(sql); },
+    admin: rows,
+    asUser: (userId, sql, params) => asRole('authenticated', userId, sql, params),
+    asAnon: (sql, params) => asRole('anon', null, sql, params),
+    asService: (sql, params) => asRole('service_role', null, sql, params),
+    appliedMigrations: applied,
+  };
+}
+
+/** Convenience: runs a statement expecting it to be DENIED. */
+export async function expectDenied(
+  run: () => Promise<unknown>,
+  label: string,
+): Promise<void> {
+  try {
+    const result = await run();
+    // A denied INSERT/UPDATE under RLS without a permissive policy raises
+    // 42501. When a policy exists but matches nothing, the statement instead
+    // succeeds and affects zero rows, so both shapes must be treated as denial.
+    const rows = Array.isArray(result) ? result : [];
+    const affected = rows.length > 0 && typeof rows[0] === 'object' && rows[0] !== null
+      ? Number((rows[0] as Record<string, unknown>).count ?? Number.NaN)
+      : Number.NaN;
+    if (rows.length === 0 || affected === 0) return;
+    throw new Error(`EXPECTED DENIAL but the statement succeeded: ${label}`);
+  } catch (error) {
+    const failure = error as { message?: string; code?: string };
+    const message = failure.message ?? String(error);
+    if (message.startsWith('EXPECTED DENIAL')) throw error;
+
+    // A guard that refuses a client is a denial however it is worded, and the
+    // authoritative signal is the SQLSTATE rather than the prose. The triggers
+    // in 20260928170000 raise 42501 with a message that explains WHY, and
+    // matching on that message would mean the test only recognised the refusal
+    // as long as nobody reworded the explanation.
+    if (failure.code === '42501') return;
+
+    // 42501 insufficient_privilege, or a WITH CHECK violation (also 42501),
+    // surfaced as text by drivers that do not expose the code.
+    if (/42501|permission denied|row-level security|violates row-level/i.test(message)) return;
+    throw new Error(`Denied with an unexpected error shape for "${label}": ${message}`);
+  }
+}
+
+/**
+ * Reports whether a role can actually execute a function, which is different
+ * from whether the function exists. A `revoke all ... from public` with no
+ * subsequent grant leaves a function callable only by a superuser — invisible
+ * in review, fatal in production.
+ */
+export async function canExecute(db: PGlite, role: string, signature: string): Promise<boolean> {
+  const rows = await db.query<{ ok: boolean }>(
+    `select has_function_privilege($1, $2, 'EXECUTE') as ok`,
+    [role, signature],
+  );
+  return Boolean(rows.rows[0]?.ok);
+}
+
+/** Reports whether a role holds a table privilege. */
+export async function hasPrivilege(
+  db: PGlite,
+  role: string,
+  table: string,
+  privilege: string,
+): Promise<boolean> {
+  const rows = await db.query<{ ok: boolean }>(
+    `select has_table_privilege($1, $2, $3) as ok`,
+    [role, table, privilege],
+  );
+  return Boolean(rows.rows[0]?.ok);
+}

@@ -0,0 +1,362 @@
+-- ===========================================================================
+-- GAYZE — PREFLIGHT DIAGNOSTIC
+-- ===========================================================================
+--
+-- Run this in the Supabase SQL Editor against the live project BEFORE applying
+-- any migration, and again afterwards. It reports and changes nothing: every
+-- statement is a SELECT. There is no DDL in this file and nothing here writes
+-- to a table.
+--
+-- Why it exists. The base schema of the production project is not in this
+-- repository — the migrations here add to tables that were created outside it.
+-- The test harness reconstructs that base schema, so it can verify what this
+-- repository changes, but it cannot verify what it cannot see. This script is
+-- how those two halves are joined: it prints what the live project actually
+-- has, so the assumptions in the migrations stop being assumptions.
+--
+-- Read it in order. Section 1 should read `ok` everywhere. Section 2 is the
+-- one that matters most: it shows the policies the migrations must coexist
+-- with, and the guarded block in 20260928130000 reasoning about them.
+-- ---------------------------------------------------------------------------
+
+
+-- ===========================================================================
+-- 1. IS THE MIGRATION SET APPLIED?
+-- ===========================================================================
+-- Each row is one object a migration creates. `present` false means that
+-- migration has not been applied. Applied out of order is also reported: the
+-- filenames are timestamps and `supabase db push` applies them in that order,
+-- so a gap usually means a migration was applied by hand.
+select
+  '1. migrations' as section,
+  m.migration,
+  case when m.probe then 'ok' else 'MISSING' end as state,
+  m.describes
+from (
+  values
+    ('20260928120000_profile_photos', to_regclass('public.profile_photos') is not null,
+     'profile_photos table'),
+    ('20260928130000_messaging_reliability', to_regclass('public.conversation_reads') is not null,
+     'conversation_reads table + messages.client_id + conversations.default_ttl_seconds'),
+    ('20260928140000_call_signalling', to_regclass('public.call_signals') is not null,
+     'call_signals table'),
+    ('20260928150000_timed_albums', to_regclass('public.album_items') is not null,
+     'album_items table'),
+    ('20260928160000_push_subscriptions', to_regclass('public.push_subscriptions') is not null,
+     'push_subscriptions table'),
+    ('20260928170000_immutable_lifetime',
+     exists (select 1 from pg_trigger t join pg_class c on c.oid = t.tgrelid
+             where c.relname = 'messages' and t.tgname = 'messages_guard_lifetime_trigger'),
+     'lifetime guards + burn_message()')
+) as m(migration, probe, describes)
+order by m.migration;
+
+
+-- ===========================================================================
+-- 2. WHAT POLICIES DO THE MESSAGE TABLES ALREADY HAVE?
+-- ===========================================================================
+-- THE MOST IMPORTANT QUERY IN THIS FILE.
+--
+-- PostgreSQL combines policies as: (any PERMISSIVE matches) AND (all RESTRICTIVE
+-- match). A RESTRICTIVE policy can only ever narrow. So if `messages` has no
+-- PERMISSIVE policy for a command, that command is denied for everyone — and no
+-- restrictive policy added by these migrations can bring it back.
+--
+-- Two consequences to check here:
+--
+--   * every row with permissive = 'PERMISSIVE' is load-bearing. If `messages`
+--     has no permissive SELECT or INSERT, messaging is already broken and the
+--     migrations will not fix it;
+--   * `conversations` must have a permissive UPDATE, or the disappearing-message
+--     timer cannot be saved (see 20260928130000 §5b-ii).
+--
+-- The migration's guarded block creates a missing permissive policy only when
+-- none exists, and never drops or replaces one. After applying, the set below
+-- will include any it added; before applying, it shows what it will find.
+select
+  '2. policies' as section,
+  p.tablename,
+  p.policyname,
+  p.permissive,
+  p.cmd,
+  coalesce(p.qual, p.with_check) as predicate
+from pg_policies p
+where p.schemaname = 'public'
+  and p.tablename in ('messages', 'conversations', 'conversation_members', 'conversation_reads')
+order by p.tablename, p.cmd, p.policyname;
+
+-- The summary that decides whether messaging can work at all.
+select
+  '2. policies' as section,
+  t.tablename,
+  c.cmd,
+  count(*) filter (where p.permissive = 'PERMISSIVE') as permissive,
+  count(*) filter (where p.permissive = 'RESTRICTIVE') as restrictive,
+  case
+    when count(*) filter (where p.permissive = 'PERMISSIVE') = 0
+      then 'DENIED FOR EVERYONE — nothing can grant this back'
+    else 'ok'
+  end as verdict
+from (values ('messages'), ('conversations'), ('conversation_members'), ('conversation_reads')) as t(tablename)
+cross join (values ('SELECT'), ('INSERT'), ('UPDATE'), ('DELETE')) as c(cmd)
+left join pg_policies p
+  on p.schemaname = 'public' and p.tablename = t.tablename and p.cmd = c.cmd
+where t.tablename = 'messages' or c.cmd in ('SELECT', 'INSERT', 'UPDATE')
+group by t.tablename, c.cmd
+order by t.tablename, c.cmd;
+
+
+-- ===========================================================================
+-- 3. IS RLS ON, AND IS THERE A GRANT BEHIND IT?
+-- ===========================================================================
+-- RLS decides WHICH ROWS. A grant decides whether the table can be touched at
+-- all, and Supabase returns `permission denied` before RLS is ever consulted.
+-- Both must be right — a table with correct policies and no grant is closed.
+select
+  '3. rls + grants' as section,
+  c.relname as table_name,
+  c.relrowsecurity as rls_enabled,
+  c.relforcerowsecurity as rls_forced,
+  has_table_privilege('authenticated', c.oid, 'SELECT') as auth_select,
+  has_table_privilege('authenticated', c.oid, 'INSERT') as auth_insert,
+  has_table_privilege('authenticated', c.oid, 'UPDATE') as auth_update,
+  has_table_privilege('authenticated', c.oid, 'DELETE') as auth_delete,
+  has_table_privilege('anon', c.oid, 'SELECT') as anon_select,
+  case
+    when not c.relrowsecurity then 'RLS IS OFF — every row is exposed'
+    when has_table_privilege('anon', c.oid, 'SELECT') then 'anon can read — check the policies'
+    else 'ok'
+  end as verdict
+from pg_class c
+join pg_namespace n on n.oid = c.relnamespace
+where n.nspname = 'public'
+  and c.relkind = 'r'
+  and c.relname in (
+    'profiles', 'conversations', 'conversation_members', 'messages',
+    'conversation_reads', 'calls', 'call_signals', 'call_participants',
+    'albums', 'album_items', 'notifications', 'push_subscriptions',
+    'profile_photos', 'app_secrets'
+  )
+order by c.relname;
+
+-- app_secrets holds the TURN shared secret. No role in the client hierarchy may
+-- be able to read it — not even to SELECT, whatever the policies say.
+select
+  '3. rls + grants' as section,
+  'app_secrets' as table_name,
+  has_table_privilege('anon', 'public.app_secrets', 'SELECT') as anon_select,
+  has_table_privilege('authenticated', 'public.app_secrets', 'SELECT') as auth_select,
+  case
+    when has_table_privilege('anon', 'public.app_secrets', 'SELECT')
+      or has_table_privilege('authenticated', 'public.app_secrets', 'SELECT')
+      then 'SECRETS READABLE — revoke immediately'
+    else 'ok (service_role only)'
+  end as verdict
+where to_regclass('public.app_secrets') is not null;
+
+
+-- ===========================================================================
+-- 4. SEQUENCES
+-- ===========================================================================
+-- A table-level grant does not confer USAGE on its sequence. Without it, every
+-- INSERT into a serial-keyed table fails — which is how `call_signals` was
+-- broken before 20260928140000.
+select
+  '4. sequences' as section,
+  s.schemaname,
+  s.sequencename,
+  has_sequence_privilege('authenticated', format('%I.%I', s.schemaname, s.sequencename), 'USAGE') as auth_usage,
+  case
+    when has_sequence_privilege('authenticated', format('%I.%I', s.schemaname, s.sequencename), 'USAGE')
+      then 'ok' else 'INSERT will fail for authenticated'
+  end as verdict
+from pg_sequences s
+where s.schemaname = 'public'
+order by s.sequencename;
+
+
+-- ===========================================================================
+-- 5. SECURITY DEFINER FUNCTIONS
+-- ===========================================================================
+-- A SECURITY DEFINER function runs with its owner's rights, so an unpinned
+-- search_path lets a caller shadow a table or function it depends on. Every one
+-- must pin `pg_temp` LAST as well: without it, a temporary object can be
+-- created first in the search order even when `public` is pinned.
+--
+-- `grantees` must never be empty. `revoke all ... from public` with no
+-- subsequent grant leaves a function only the owner can call — which is how
+-- five server-side functions, including the push recipient resolver, became
+-- silently uncallable.
+select
+  '5. security definer' as section,
+  p.proname,
+  p.prosecdef as security_definer,
+  array_to_string(p.proconfig, ', ') as config,
+  exists (
+    select 1 from unnest(coalesce(p.proconfig, '{}')) as cfg
+    where cfg like 'search\_path=%' and cfg like '%pg_temp%'
+  ) as pins_pg_temp,
+  -- aclexplode returns a grantee OID, so it is joined to pg_roles for names.
+  coalesce((
+    select string_agg(distinct r.rolname, ', ' order by r.rolname)
+    from aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) as acl
+    join pg_roles r on r.oid = acl.grantee
+    where acl.privilege_type = 'EXECUTE' and r.rolname <> p.proowner::regrole::text
+  ), '(nobody)') as grantees,
+  case
+    when not exists (
+      select 1 from unnest(coalesce(p.proconfig, '{}')) as cfg
+      where cfg like 'search\_path=%' and cfg like '%pg_temp%'
+    ) then 'search_path is not pinned with pg_temp'
+    when not (
+      select exists (
+        select 1 from aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) as acl
+        join pg_roles r on r.oid = acl.grantee
+        where acl.privilege_type = 'EXECUTE'
+          and r.rolname in ('authenticated', 'service_role')
+      )
+    ) then 'nobody can call it — a missing grant'
+    else 'ok'
+  end as verdict
+from pg_proc p
+join pg_namespace n on n.oid = p.pronamespace
+where n.nspname = 'public' and p.prosecdef
+order by p.proname;
+
+
+-- The update guards added by 20260928170000. A guard that is not attached is
+-- indistinguishable from one that is, until a client rewrites an expiry.
+select
+  '5. security definer' as section,
+  c.relname as table_name,
+  t.tgname as trigger_name,
+  t.tgenabled <> 'D' as enabled,
+  case
+    when t.tgenabled = 'D' then 'DISABLED — the guard is present but will not fire'
+    else 'ok'
+  end as verdict
+from pg_trigger t
+join pg_class c on c.oid = t.tgrelid
+join pg_namespace n on n.oid = c.relnamespace
+where n.nspname = 'public' and not t.tgisinternal
+  and t.tgname in (
+    'messages_guard_lifetime_trigger',
+    'albums_guard_lifetime_trigger',
+    'album_items_guard_identity_trigger'
+  )
+order by c.relname;
+
+
+-- ===========================================================================
+-- 6. TURN CONFIGURATION
+-- ===========================================================================
+-- `get_turn_credentials()` reads these rows. Nothing is printed — only whether
+-- the rows exist — so running this does not put a secret on screen or in a log.
+select
+  '6. turn' as section,
+  k.key,
+  case
+    when k.key = 'turn_shared_secret' then 'present (value withheld)'
+    when k.key = 'turn_urls' then 'present (value withheld)'
+    else 'present'
+  end as state
+from public.app_secrets k
+where k.key in ('turn_shared_secret', 'turn_urls')
+union all
+select
+  '6. turn',
+  'missing: ' || missing.key,
+  'TURN is not configured — create this row'
+from (values ('turn_shared_secret'), ('turn_urls')) as missing(key)
+where not exists (select 1 from public.app_secrets s where s.key = missing.key);
+
+
+-- ===========================================================================
+-- 7. REALTIME
+-- ===========================================================================
+-- A table not in this publication changes on the server and never reaches the
+-- client. The symptom is a message that appears only after a manual refresh —
+-- which is indistinguishable from a network problem.
+select
+  '7. realtime' as section,
+  t.tablename,
+  (pt.tablename is not null) as in_publication,
+  c.relreplident as replica_identity,
+  case
+    when pt.tablename is null then 'NOT PUBLISHED — changes never reach the client'
+    when c.relreplident <> 'f' and t.tablename in ('messages', 'albums', 'album_items')
+      then 'REPLICA IDENTITY is not FULL — DELETEs and UPDATEs of expired rows arrive without the old row and cannot be removed from the UI'
+    else 'ok'
+  end as verdict
+from (values ('messages'), ('conversations'), ('calls'), ('call_signals'),
+             ('albums'), ('album_items'), ('notifications'), ('conversation_reads')) as t(tablename)
+left join pg_publication_tables pt
+  on pt.pubname = 'supabase_realtime' and pt.schemaname = 'public' and pt.tablename = t.tablename
+left join pg_class c on c.relname = t.tablename and c.relnamespace = 'public'::regnamespace
+order by t.tablename;
+
+
+-- ===========================================================================
+-- 8. STORAGE
+-- ===========================================================================
+-- Buckets first: a private bucket is the difference between a signed URL being
+-- required and a permanent public one being guessable.
+select
+  '8. storage' as section,
+  b.id,
+  b.name,
+  b.public,
+  b.file_size_limit,
+  case
+    when b.id in ('album-media', 'profile-photos') and b.public
+      then 'PUBLIC BUCKET — a signed URL is no protection; anyone with the path can read the object'
+    else 'ok'
+  end as verdict
+from storage.buckets b
+where b.id in ('album-media', 'profile-photos', 'chat-media')
+order by b.id;
+
+-- Then the policies. The predicate in `qual`/`with_check` is what Storage
+-- enforces, so a policy permitting `bucket_id = 'album-media'` with no
+-- ownership test is a public bucket by another name.
+select
+  '8. storage' as section,
+  p.policyname,
+  p.cmd,
+  p.permissive,
+  coalesce(p.qual, p.with_check) as predicate
+from pg_policies p
+where p.schemaname = 'storage' and p.tablename = 'objects'
+order by p.cmd, p.policyname;
+
+
+-- ===========================================================================
+-- 9. SCHEDULED JOBS
+-- ===========================================================================
+-- Expiry is enforced by the read policies, so nothing here is load-bearing for
+-- security — these jobs reclaim space and keep the tables small. If they are
+-- absent, expired rows simply accumulate.
+select
+  '9. cron' as section,
+  j.jobname,
+  j.schedule,
+  j.active,
+  left(j.command, 90) as command
+from cron.job j
+where j.command ilike '%purge_expired%' or j.command ilike '%expire_stale%'
+order by j.jobname;
+
+
+-- ===========================================================================
+-- FINAL: WHAT TO DO WITH THE OUTPUT
+-- ===========================================================================
+-- Section 2 is the one to look at first.
+--
+--   * Any line reading 'DENIED FOR EVERYONE' is a feature that cannot work, and
+--     the migration only repairs it if it is `messages` or `conversations`.
+--     For any other table, a permissive policy must be written deliberately,
+--     by hand, with the live schema in front of you.
+--   * Nothing in sections 3–5 should read anything other than `ok`.
+--   * Sections 6–9 are configuration. They are separate from the schema: a
+--     perfectly migrated database still has no TURN relay and no background
+--     cleanup until those rows and jobs exist.

new file mode 100644
index 0000000..49db1a6
--- /dev/null
+++ b/src/components/NotificationSettingsCard.tsx
@@ -0,0 +1,202 @@
+import React, { useEffect, useState } from 'react';
+import { Bell, BellOff, BellRing, Smartphone, Check, AlertCircle } from 'lucide-react';
+import {
+  getNotificationCapability,
+  requestNotificationPermission,
+  loadNotificationPrefs,
+  saveNotificationPrefs,
+  type NotificationCapability,
+  type NotificationPrefs,
+} from '../services/notificationService';
+import { enablePush, disablePush, isPushConfigured, syncPushSubscription } from '../services/pushService';
+
+/**
+ * Notification controls.
+ *
+ * Deliberately explicit about what each device can and cannot do, because the
+ * alternative — a single "Enable notifications" switch that quietly does
+ * nothing on an iPhone in a browser tab — is how people conclude the app is
+ * broken. Every branch below states the real situation:
+ *
+ *   * iOS in a tab           → push needs the app added to the Home Screen
+ *   * iOS on the Home Screen → push works from 16.4 onwards
+ *   * permission denied      → where to change it, not a dead button
+ *   * push not deployed      → in-app alerts only, said plainly
+ */
+export const NotificationSettingsCard: React.FC<{ compact?: boolean }> = ({ compact = false }) => {
+  const [capability, setCapability] = useState<NotificationCapability>(() => getNotificationCapability());
+  const [prefs, setPrefs] = useState<NotificationPrefs>(() => loadNotificationPrefs());
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const refresh = () => setCapability(getNotificationCapability());
+
+  useEffect(() => {
+    refresh();
+    // A subscription created on a previous launch may not have reached the
+    // server. Re-syncing here is cheap and repairs the common case.
+    void syncPushSubscription().then(refresh);
+  }, []);
+
+  const updatePrefs = (next: Partial<NotificationPrefs>) => {
+    const merged = { ...prefs, ...next };
+    setPrefs(merged);
+    saveNotificationPrefs(merged);
+  };
+
+  const handleEnable = async () => {
+    setBusy(true);
+    setError(null);
+    setMessage(null);
+
+    const permission = await requestNotificationPermission();
+    refresh();
+
+    if (!permission.granted) {
+      setError(permission.message);
+      setBusy(false);
+      return;
+    }
+
+    const result = await enablePush();
+    refresh();
+    setBusy(false);
+
+    if (result.status === 'subscribed') {
+      setMessage('Background notifications are on for this device.');
+      return;
+    }
+
+    // Permission is granted, so in-app alerts work regardless. Say which part
+    // failed rather than implying everything did.
+    if (result.status === 'not-configured') {
+      setMessage('Alerts will appear while GAYZE is open. Background delivery is not configured on this deployment yet — in-app alerts already work.');
+      return;
+    }
+
+    setError(result.reason);
+  };
+
+  const handleDisable = async () => {
+    setBusy(true);
+    setError(null);
+    await disablePush();
+    refresh();
+    setMessage('Background notifications are off for this device. In-app alerts are unaffected.');
+    setBusy(false);
+  };
+
+  const pushActive = capability.pushSupported && capability.permission === 'granted';
+  const permissionDenied = capability.permission === 'denied';
+
+  return (
+    <div className={`g-panel !rounded-[16px] ${compact ? 'p-3' : 'p-4'} space-y-3`}>
+      <div className="flex items-center gap-2">
+        {permissionDenied ? (
+          <BellOff className="w-4 h-4 text-amber-300" />
+        ) : pushActive ? (
+          <BellRing className="w-4 h-4 text-emerald-300" />
+        ) : (
+          <Bell className="w-4 h-4 text-[#C9A24D]" />
+        )}
+        <h3 className="text-[13px] font-semibold text-white">Notifications</h3>
+      </div>
+
+      {/* In-app alerts. These never depend on push, a permission or a platform. */}
+      <label className="flex items-center justify-between gap-3 cursor-pointer">
+        <span className="text-[12px] text-zinc-300">
+          Alerts while GAYZE is open
+          <span className="block text-[11px] text-zinc-500">Messages and calls, as they arrive.</span>
+        </span>
+        <input
+          type="checkbox"
+          checked={prefs.inAppEnabled}
+          onChange={(event) => updatePrefs({ inAppEnabled: event.target.checked })}
+          className="w-4 h-4 accent-[#C9A24D] cursor-pointer"
+        />
+      </label>
+
+      <label className="flex items-center justify-between gap-3 cursor-pointer">
+        <span className="text-[12px] text-zinc-300">Sound and vibration</span>
+        <input
+          type="checkbox"
+          checked={prefs.soundEnabled}
+          onChange={(event) => updatePrefs({ soundEnabled: event.target.checked, vibrationEnabled: event.target.checked })}
+          className="w-4 h-4 accent-[#C9A24D] cursor-pointer"
+        />
+      </label>
+
+      {/* Background delivery. */}
+      <div className="pt-1 border-t border-white/[0.07]">
+        <div className="flex items-center justify-between gap-3 pt-2.5">
+          <span className="text-[12px] text-zinc-300">
+            Background notifications
+            <span className="block text-[11px] text-zinc-500">
+              {pushActive
+                ? 'Delivered by your device even when GAYZE is closed.'
+                : capability.pushSupported
+                  ? 'Not enabled on this device yet.'
+                  : 'Unavailable on this device in this context.'}
+            </span>
+          </span>
+
+          {pushActive ? (
+            <button
+              type="button"
+              onClick={handleDisable}
+              disabled={busy}
+              className="g-btn g-btn--ghost !min-h-[36px] !text-[11.5px] shrink-0 cursor-pointer"
+            >
+              Turn off
+            </button>
+          ) : (
+            <button
+              type="button"
+              onClick={handleEnable}
+              disabled={busy || !capability.pushSupported || !isPushConfigured()}
+              className="g-btn g-btn--amber !min-h-[36px] !text-[11.5px] shrink-0 cursor-pointer disabled:opacity-50"
+            >
+              {busy ? 'Enabling…' : 'Enable'}
+            </button>
+          )}
+        </div>
+
+        {/* The exact reason push is unavailable, including the iOS Home Screen
+            requirement. Never a generic failure. */}
+        {!pushActive && capability.pushUnavailableReason && (
+          <p className="mt-2 text-[11px] text-amber-200/80 leading-snug flex items-start gap-1.5">
+            <Smartphone className="w-3.5 h-3.5 mt-px shrink-0" />
+            <span>{capability.pushUnavailableReason}</span>
+          </p>
+        )}
+
+        {!pushActive && capability.pushSupported && !isPushConfigured() && (
+          <p className="mt-2 text-[11px] text-zinc-400 leading-snug">
+            Background delivery is not configured on this deployment, so alerts appear in the app only.
+          </p>
+        )}
+
+        {permissionDenied && (
+          <p className="mt-2 text-[11px] text-amber-200/80 leading-snug">
+            Notifications are blocked for GAYZE. Allow them for this site in your browser or system settings, then reopen this screen.
+          </p>
+        )}
+      </div>
+
+      {message && (
+        <p className="flex items-start gap-1.5 text-[11px] text-emerald-300/90 leading-snug">
+          <Check className="w-3.5 h-3.5 mt-px shrink-0" />
+          <span>{message}</span>
+        </p>
+      )}
+
+      {error && (
+        <p className="flex items-start gap-1.5 text-[11px] text-rose-300 leading-snug">
+          <AlertCircle className="w-3.5 h-3.5 mt-px shrink-0" />
+          <span>{error}</span>
+        </p>
+      )}
+    </div>
+  );
+};

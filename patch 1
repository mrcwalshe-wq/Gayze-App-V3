+ * Forces every channel to re-establish. Called when the session changes user,
+ * because the previous socket is authenticated as someone else.
+ */
+export function resubscribeAll(): void {
+  channels.forEach((managed) => {
+    managed.attempt = 0;
+    reconnectNow(managed);
+  });
+}

+import React, { useState } from 'react';
+import { useSignedPhotoUrl } from '../hooks/useSignedPhotoUrl';
+
+/**
+ * Canonical identity-photo components.
+ *
+ * One implementation serves Profile, Discover, Right Now, Later and chat, so a
+ * member's face is the same object everywhere. They always reserve the space
+ * they occupy, so a slow photo never shifts the layout, and they fall back to
+ * the member's initial rather than to a stand-in image.
+ */
+
+export function initialsFor(name: string): string {
+  const initials = (name || '')
+    .trim()
+    .split(/\s+/)
+    .map((part) => part.charAt(0))
+    .join('')
+    .slice(0, 2)
+    .toUpperCase();
+  return initials || 'G';
+}
+
+export type IdentityTone = 'private' | 'social' | 'neutral' | 'haven' | 'live';
+
+function toneClass(tone: IdentityTone, hasPhoto: boolean): string {
+  if (tone === 'haven') return '!bg-[#0f1f1a] !border-[#34d399]/45 text-emerald-400';
+  if (tone === 'private') return hasPhoto ? '' : 'g-avatar--private';
+  if (tone === 'social') return hasPhoto ? '' : 'g-avatar--social';
+  return '';
+}
+
+interface ProfileAvatarProps {
+  /** Storage path in the private profile-photos bucket. */
+  path?: string | null;
+  name: string;
+  /** Sizing and rounding classes for the frame, e.g. `w-11 h-11 text-[14px]`. */
+  className?: string;
+  tone?: IdentityTone;
+  /** Skip lazy loading for above-the-fold identity (map sheet, viewer). */
+  eager?: boolean;
+  /** Renders the breathing live ring used for an active signal. */
+  live?: boolean;
+  alt?: string;
+}
+
+/** Small identity image: map/list rows, chat headers, markers' side panels. */
+export const ProfileAvatar: React.FC<ProfileAvatarProps> = ({
+  path,
+  name,
+  className = '',
+  tone = 'neutral',
+  eager = false,
+  live = false,
+  alt,
+}) => {
+  const { url, loading, retry } = useSignedPhotoUrl(path);
+  const [broken, setBroken] = useState(false);
+  const showPhoto = Boolean(url) && !broken;
+
+  return (
+    <span
+      className={`g-avatar ${toneClass(tone, showPhoto)} ${live ? 'g-avatar--live' : ''} ${className}`}
+      data-loading={loading && !url ? 'true' : undefined}
+    >
+      {showPhoto ? (
+        <img
+          src={url as string}
+          alt={alt ?? `${name}`}
+          loading={eager ? 'eager' : 'lazy'}
+          decoding="async"
+          draggable={false}
+          onError={() => {
+            // A signed URL can expire mid-session; resolve once more before
+            // giving up and showing initials.
+            if (!broken) {
+              setBroken(true);
+              retry();
+            }
+          }}
+        />
+      ) : loading ? (
+        <span className="g-skel absolute inset-0 !rounded-[inherit]" aria-hidden="true" />
+      ) : (
+        <span aria-hidden={alt ? undefined : true}>{initialsFor(name)}</span>
+      )}
+    </span>
+  );
+};
+
+interface ProfilePhotoSurfaceProps {
+  path?: string | null;
+  name: string;
+  /** Frame classes; controls the aspect ratio the surface reserves. */
+  className?: string;
+  imgClassName?: string;
+  /** `contain` for the viewer, `cover` for hero and album tiles. */
+  fit?: 'cover' | 'contain';
+  /** False in the viewer, where the photo should not carry the page's wash. */
+  overlay?: boolean;
+  eager?: boolean;
+  alt?: string;
+  /** Rendered under the photo, e.g. an amber trust badge. */
+  children?: React.ReactNode;
+}
+
+/**
+ * Large identity image: hero, album tiles, full-screen viewer. Reserves its
+ * frame before the image arrives, so nothing reflows when the photo lands.
+ */
+export const ProfilePhotoSurface: React.FC<ProfilePhotoSurfaceProps> = ({
+  path,
+  name,
+  className = '',
+  imgClassName = '',
+  fit = 'cover',
+  overlay = true,
+  eager = false,
+  alt,
+  children,
+}) => {
+  const { url, loading, retry } = useSignedPhotoUrl(path);
+  const [broken, setBroken] = useState(false);
+  const [loaded, setLoaded] = useState(false);
+  const showPhoto = Boolean(url) && !broken;
+
+  return (
+    <div className={`relative overflow-hidden bg-[#0d0e14] ${className}`}>
+      {showPhoto ? (
+        <img
+          src={url as string}
+          alt={alt ?? `${name}`}
+          loading={eager ? 'eager' : 'lazy'}
+          decoding="async"
+          draggable={false}
+          onLoad={() => setLoaded(true)}
+          onError={() => {
+            if (!broken) {
+              setBroken(true);
+              retry();
+            }
+          }}
+          className={`w-full h-full transition-opacity duration-300 ${fit === 'contain' ? 'object-contain' : 'object-cover'} ${loaded ? 'opacity-100' : 'opacity-0'} ${imgClassName}`}
+        />
+      ) : loading ? (
+        <div className="absolute inset-0 g-skel !rounded-none" aria-hidden="true" />
+      ) : (
+        <div
+          className="absolute inset-0 flex items-center justify-center text-[42px] font-semibold tracking-[-0.02em] text-[#cbb7ef]"
+          aria-hidden="true"
+        >
+          {initialsFor(name)}
+        </div>
+      )}
+
+      {/* The photo sits in the room's light rather than on top of it. */}
+      {overlay && (
+        <div
+          className="pointer-events-none absolute inset-0"
+          aria-hidden="true"
+          style={{
+            background:
+              'radial-gradient(120% 80% at 50% 0%, rgba(111, 60, 195, 0.14), transparent 62%), linear-gradient(180deg, rgba(8,9,14,0) 45%, rgba(8,9,14,0.55) 100%)',
+          }}
+        />
+      )}
+      {children}
+    </div>
+  );
+};

+  it('never reads a TURN credential from the client environment', () => {
+    // TURN credentials are minted server-side by get_turn_credentials(), which
+    // returns a short-lived HMAC rather than the shared secret. Any reappearance
+    // of VITE_TURN_* here would bake a static relay password into a public
+    // JavaScript bundle.
+    const offenders = readAll().filter(({ text }) =>
+      /VITE_TURN_(CREDENTIAL|USERNAME|URL|SECRET)/.test(text),

+import React from 'react';
+import { GAYZE_LOGO_PATH } from './GayzeLogo';
+import { supabase, GAYZE_AUTH_STORAGE_KEY } from '../services/supabaseClient';
+
+interface AppErrorBoundaryProps {
+  children: React.ReactNode;
+}
+
+interface AppErrorBoundaryState {
+  error: Error | null;
+  info: string | null;
+}
+
+/**
+ * The last line of defence against a blank screen.
+ *
+ * React's default response to an uncaught error in a component or effect is to
+ * unmount the entire tree. Since `index.html` sets a near-black body background,
+ * that unmount is indistinguishable from a broken page: no message, no logo, no
+ * way to tell a crash from a slow network. That is exactly what a user saw after
+ * signing in with Google — the app threw, React cleared the tree, and the screen
+ * went black.
+ *
+ * With this boundary the failure is legible: the brand mark, what happened, and
+ * a way to recover. It deliberately shows the error message rather than hiding
+ * it — this screen exists to be reported, and a screenshot of it is the most
+ * useful thing a user can send.
+ *
+ * Note this catches render and effect errors, not asynchronous ones outside
+ * React's tree; the auth bootstrap handles its own rejections separately.
+ */
+export class AppErrorBoundary extends React.Component<
+  AppErrorBoundaryProps,
+  AppErrorBoundaryState
+> {
+  state: AppErrorBoundaryState = { error: null, info: null };
+
+  static getDerivedStateFromError(error: Error): Partial<AppErrorBoundaryState> {
+    return { error };
+  }
+
+  componentDidCatch(error: Error, info: React.ErrorInfo): void {
+    // The console is where a tester looks first, and on a phone the console is
+    // all they will ever get, so the full detail goes there.
+    console.error('[GAYZE] Unhandled application error:', error, info.componentStack);
+    this.setState({ info: info.componentStack ?? null });
+  }
+
+  private reload = (): void => {
+    window.location.reload();
+  };
+
+  private signOut = async (): Promise<void> => {
+    // A crash during or straight after sign-in is recoverable by clearing the
+    // stored session; do it locally as well as remotely so a failed network call
+    // cannot trap the user on this screen.
+    try {
+      await supabase?.auth.signOut();
+      window.localStorage.removeItem(GAYZE_AUTH_STORAGE_KEY);
+    } catch {
+      // Fall through to the reload; the session may simply not have been stored.
+    }
+    window.location.replace(window.location.origin + '/');
+  };
+
+  render(): React.ReactNode {
+    if (!this.state.error) return this.props.children;
+
+    return (
+      <div className="fixed inset-0 z-[200] overflow-y-auto bg-[#090a0f] text-[#f1f3f7]">
+        <div className="flex min-h-full flex-col items-center justify-center px-6 py-10 text-center">
+          <img
+            src={GAYZE_LOGO_PATH}
+            alt="GAYZE"
+            className="w-32 object-contain opacity-90"
+            draggable={false}
+          />
+
+          <h1 className="mt-6 text-lg font-semibold tracking-tight">
+            Something went wrong
+          </h1>
+          <p className="mt-2 max-w-sm text-sm text-zinc-400">
+            The app hit an unexpected error and stopped. Nothing you sent was lost.
+            Try again — and if this keeps happening, the detail below is what we need.
+          </p>
+
+          <div className="mt-6 flex w-full max-w-xs flex-col gap-2">
+            <button
+              type="button"
+              onClick={this.reload}
+              className="h-11 w-full rounded-xl bg-[#C9A24D] font-semibold text-[#111318] transition-opacity hover:opacity-90"
+            >
+              Try again
+            </button>
+            <button
+              type="button"
+              onClick={() => void this.signOut()}
+              className="h-11 w-full rounded-xl border border-white/15 font-medium text-zinc-300 transition-colors hover:bg-white/5"
+            >
+              Sign out and start over
+            </button>
+          </div>
+
+          <details className="mt-8 w-full max-w-sm text-left">
+            <summary className="cursor-pointer text-[11px] uppercase tracking-[0.16em] text-zinc-600">
+              Technical detail
+            </summary>
+            <pre className="mt-2 overflow-x-auto whitespace-pre-wrap rounded-lg border border-white/10 bg-black/40 p-3 text-[10px] leading-relaxed text-zinc-500">
+              {String(this.state.error?.stack || this.state.error?.message || this.state.error)}
+              {this.state.info ? `\n\nComponent stack:${this.state.info}` : ''}
+            </pre>
+          </details>
+        </div>
+      </div>
+    );
+  }
+}
+
+export default AppErrorBoundary;

+/**
+ * RFC 8291 Web Push encryption and RFC 8292 VAPID signing.
+ *
+ * Extracted from the Edge Function so it can be tested outside Deno. It uses
+ * only Web Crypto and base64url, both of which Deno and Node provide, so the
+ * exact code that runs in production is the code under test — not a copy of it.
+ *
+ * Hand-rolled deliberately: this is the delivery path, and a dependency here is
+ * a dependency that can change the day notifications stop arriving. The cost is
+ * that it must be verified, which `tests/webpush.crypto.test.ts` does.
+ */
+
+/* eslint-disable no-restricted-globals */
+
+/**
+ * TypeScript 7 distinguishes an ArrayBuffer-backed view from a possibly
+ * SharedArrayBuffer-backed one, and Web Crypto accepts only the former. Naming
+ * the narrow type once keeps the signatures honest instead of scattering casts
+ * at every call site.
+ */
+type Bytes = Uint8Array<ArrayBuffer>;
+
+
+/**
+ * What a push service's response means for the subscription behind it.
+ *
+ * The distinction that matters is not success versus failure — it is whose
+ * fault the failure is.
+ *
+ *   404 and 410 are the push service saying this endpoint is gone. The
+ *   subscription will never work again, so it should be retired.
+ *
+ *   Everything else — 401, 403, 429, 500, 503 — is either a transient problem
+ *   or OUR problem. A 401 means the VAPID key is wrong, and a misconfigured key
+ *   returns 401 for every device at once. Retiring subscriptions on it would
+ *   not fix anything and would delete the entire recipient list in a single
+ *   pass, so a broken deploy would become unrecoverable data loss rather than a
+ *   broken deploy.
+ *
+ * Hence `retry-later`, which leaves the subscription intact and records a
+ * failure for diagnosis.
+ */
+export type PushResponseOutcome = 'delivered' | 'retire' | 'retry-later';
+
+export function classifyPushResponse(status: number): PushResponseOutcome {
+  if (status >= 200 && status < 300) return 'delivered';
+  if (status === 404 || status === 410) return 'retire';
+  return 'retry-later';
+}
+
+
+/** base64url → Uint8Array, for the VAPID keys and the subscription secrets. */
+function decodeBase64Url(value: string): Bytes {
+  const padding = '='.repeat((4 - (value.length % 4)) % 4);
+  const base64 = (value + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const raw = atob(base64);
+  const bytes = new Uint8Array(raw.length);
+  for (let i = 0; i < raw.length; i += 1) bytes[i] = raw.charCodeAt(i);
+  return bytes;
+}
+
+/**
+ * Encrypts a payload with aes128gcm as required by RFC 8291.
+ *
+ * Implemented here rather than imported so the function has one dependency
+ * (the Supabase client) and cannot be broken by an upstream package change in
+ * the notification path — the component users notice first when it breaks.
+ */
+async function encryptPayload(
+  payload: string,
+  p256dh: string,
+  authSecret: string,
+): Promise<{ body: Bytes; salt: Bytes; localPublicKey: Bytes }> {
+  const clientKeys = await crypto.subtle.generateKey(
+    { name: 'ECDH', namedCurve: 'P-256' },
+    true,
+    ['deriveBits'],
+  ) as CryptoKeyPair;
+
+  const localPublicKey = new Uint8Array(await crypto.subtle.exportKey('raw', clientKeys.publicKey));
+
+  const recipientKey = await crypto.subtle.importKey(
+    'raw',
+    decodeBase64Url(p256dh),
+    { name: 'ECDH', namedCurve: 'P-256' },
+    false,
+    [],
+  );
+
+  const sharedSecret = new Uint8Array(
+    await crypto.subtle.deriveBits({ name: 'ECDH', public: recipientKey }, clientKeys.privateKey, 256),
+  );
+
+  const authBytes = decodeBase64Url(authSecret);
+  const salt = crypto.getRandomValues(new Uint8Array(16));
+
+  const encoder = new TextEncoder();
+
+  // RFC 8291: PRK_key = HKDF(auth_secret, ecdh_secret, "WebPush: info\0" || ua_pub || as_pub)
+  const keyInfo = concat(
+    encoder.encode('WebPush: info\0'),
+    decodeBase64Url(p256dh),
+    localPublicKey,
+  );
+  const ikm = await hkdf(authBytes, sharedSecret, keyInfo, 32);
+
+  const contentEncryptionKey = await hkdf(
+    salt,
+    ikm,
+    encoder.encode('Content-Encoding: aes128gcm\0'),
+    16,
+  );
+  const nonce = await hkdf(salt, ikm, encoder.encode('Content-Encoding: nonce\0'), 12);
+
+  const cipher = await crypto.subtle.importKey('raw', contentEncryptionKey, 'AES-GCM', false, ['encrypt']);
+  // The 0x02 delimiter marks this as the final (and only) record.
+  const plaintext = concat(encoder.encode(payload), new Uint8Array([0x02]));
+
+  const encrypted = new Uint8Array(
+    await crypto.subtle.encrypt({ name: 'AES-GCM', iv: nonce }, cipher, plaintext),
+  );
+
+  return { body: encrypted, salt, localPublicKey };
+}
+
+function concat(...arrays: Uint8Array[]): Bytes {
+  const total = arrays.reduce((sum, array) => sum + array.length, 0);
+  const output = new Uint8Array(total);
+  let offset = 0;
+  for (const array of arrays) {
+    output.set(array, offset);
+    offset += array.length;
+  }
+  return output;
+}
+
+async function hkdf(
+  salt: Bytes,
+  ikm: Bytes,
+  info: Bytes,
+  length: number,
+): Promise<Bytes> {
+  const key = await crypto.subtle.importKey('raw', ikm, 'HKDF', false, ['deriveBits']);
+  return new Uint8Array(
+    await crypto.subtle.deriveBits({ name: 'HKDF', hash: 'SHA-256', salt, info }, key, length * 8),
+  );
+}
+
+/**
+ * The DER envelope Web Crypto requires around a raw P-256 private scalar.
+ *
+ * Spelled out rather than built, because it is the part most likely to be
+ * mistyped and the least likely to be noticed. A previous version of this
+ * constant declared a 36-byte sequence under a header saying 35 — two fused
+ * errors — so Web Crypto rejected the key outright and EVERY push would have
+ * failed with a 401 from Apple, Google and Mozilla. Nothing caught it: the
+ * function runs in Deno, its source is excluded from tsconfig, and no test
+ * touched it.
+ *
+ *   30 41                    SEQUENCE, 0x41 = 65 bytes of content
+ *     02 01 00               INTEGER 0            PKCS#8 version
+ *     30 13                  SEQUENCE, 0x13 = 19 bytes
+ *       06 07 2a8648ce3d0201 OID 1.2.840.10045.2.1    id-ecPublicKey
+ *       06 08 2a8648ce3d030107 OID 1.2.840.10045.3.1.7  prime256v1
+ *     04 27                  OCTET STRING, 0x27 = 39 bytes
+ *       30 25                SEQUENCE, 0x25 = 37 bytes
+ *         02 01 01           INTEGER 1          EC private key version
+ *         04 20 <32 bytes>   OCTET STRING       the scalar itself
+ *
+ * The lengths are arithmetic, not free choices:
+ *   65 = 3 + 21 + 2 + 39   (outer content)
+ *   19 = 9 + 10            (algorithm identifier)
+ *   39 = 3 + 2 + 34        (wrapped EC private key)
+ *   34 = 32 scalar + 2     (the OCTET STRING header)
+ *
+ * It is exported so `tests/webpush.crypto.test.ts` can assert the structure
+ * directly and prove that corrupting any one of these bytes is rejected —
+ * rather than only observing that one particular arrangement happens to work.
+ */
+const PKCS8_PREFIX = new Uint8Array([
+  0x30, 0x41, 0x02, 0x01, 0x00, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
+  0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x04, 0x27, 0x30,
+  0x25, 0x02, 0x01, 0x01, 0x04, 0x20,
+]);
+
+/**
+ * Wraps a raw 32-byte scalar into PKCS#8.
+ *
+ * `prefix` is a parameter rather than a closed-over constant so the test can
+ * feed it corrupted envelopes and assert each one is refused.
+ */
+function wrapPkcs8(scalar: Bytes, prefix: Bytes = PKCS8_PREFIX): Bytes {
+  return concat(prefix, scalar);
+}
+
+/**
+ * Builds the VAPID Authorization header: a signed JWT plus the public key.
+ *
+ * `privateKeyBase64Url` is the raw 32-byte P-256 scalar as Web Push tooling
+ * emits it. Web Crypto requires PKCS#8, so it is wrapped — and the wrapper is
+ * the fiddliest part of this file, which is why the test imports the result
+ * into Web Crypto rather than eyeballing the bytes.
+ */
+async function buildVapidHeader(
+  audience: string,
+  privateKeyBase64Url: string,
+  publicKeyBase64Url: string,
+  subject: string,
+): Promise<string> {
+  const header = { typ: 'JWT', alg: 'ES256' };
+  const payload = {
+    aud: audience,
+    exp: Math.floor(Date.now() / 1000) + 12 * 60 * 60,
+    sub: subject,
+  };
+
+  const encoder = new TextEncoder();
+  const headerB64 = base64UrlEncode(encoder.encode(JSON.stringify(header)));
+  const payloadB64 = base64UrlEncode(encoder.encode(JSON.stringify(payload)));
+  const signingInput = `${headerB64}.${payloadB64}`;
+
+  const privateKeyBytes = decodeBase64Url(privateKeyBase64Url);
+  const pkcs8 = wrapPkcs8(privateKeyBytes);
+
+  const key = await crypto.subtle.importKey(
+    'pkcs8',
+    pkcs8,
+    { name: 'ECDSA', namedCurve: 'P-256' },
+    false,
+    ['sign'],
+  );
+
+  const signature = new Uint8Array(
+    await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, key, encoder.encode(signingInput)),
+  );
+
+  return `vapid t=${signingInput}.${base64UrlEncode(signature)}, k=${publicKeyBase64Url}`;
+}
+
+function base64UrlEncode(bytes: Bytes): string {
+  let binary = '';
+  for (let i = 0; i < bytes.length; i += 1) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+
+export {
+  PKCS8_PREFIX,
+  base64UrlEncode,
+  buildVapidHeader,
+  concat,
+  decodeBase64Url,
+  encryptPayload,
+  hkdf,
+  wrapPkcs8,
+};

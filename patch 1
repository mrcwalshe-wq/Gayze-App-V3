+
+/**
+ * Security regression tests.
+ *
+ * These read the source tree rather than exercising behaviour, because the
+ * failures they guard against are configuration mistakes rather than logic
+ * bugs — and they are exactly the kind of mistake that is invisible in review:
+ * a secret quietly read from the client environment, a service-role key
+ * imported into a component, RLS turned off to make a query work.
+ */
+
+const SRC = join(process.cwd(), 'src');
+const REPO = process.cwd();
+
+function walk(dir: string, extensions: string[]): string[] {
+  const results: string[] = [];
+  for (const entry of readdirSync(dir)) {
+    const full = join(dir, entry);
+    if (statSync(full).isDirectory()) results.push(...walk(full, extensions));
+    else if (extensions.some((ext) => entry.endsWith(ext))) results.push(full);
+  }
+  return results;
+}
+

new file mode 100644
index 0000000..f8d9505
--- /dev/null
+++ b/src/services/realtimeManager.test.ts
@@ -0,0 +1,130 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+/**
+ * Realtime lifecycle.
+ *
+ * These are the guarantees that stop the message layer degrading a week after
+ * it ships: one socket channel per concern no matter how many components ask
+ * for it, no channel surviving its last consumer, and no double release
+ * decrementing someone else's reference.
+ */
+
+// A fake Supabase client that records channels the way the real one does.
+const created: string[] = [];
+const removed: string[] = [];
+
+const fakeChannel = (topic: string) => {
+  created.push(topic);
+  const self = {
+    topic,
+    on: () => self,
+    subscribe: (callback?: (status: string) => void) => {
+      callback?.('SUBSCRIBED');
+      return self;
+    },
+  };
+  return self;
+};
+
+vi.mock('./supabaseClient', () => ({
+  supabase: {
+    channel: (topic: string) => fakeChannel(topic),
+    removeChannel: (channel: { topic: string }) => {
+      removed.push(channel.topic);
+      return Promise.resolve('ok');
+    },
+  },
+}));
+
+vi.stubGlobal('navigator', { userAgent: 'vitest', onLine: true });
+vi.stubGlobal('window', {
+  addEventListener: () => undefined,
+  setTimeout: (fn: () => void, ms: number) => setTimeout(fn, ms),
+  clearTimeout: (id: number) => clearTimeout(id),
+});
+vi.stubGlobal('document', {
+  visibilityState: 'visible',
+  addEventListener: () => undefined,
+});
+
+const { acquireChannel, inspectChannels, aggregateRealtimeStatus } = await import('./realtimeManager');
+
+describe('channel ref counting', () => {
+  beforeEach(() => {
+    // Release anything an earlier case left open.
+    inspectChannels().forEach(() => undefined);
+    created.length = 0;
+    removed.length = 0;
+  });
+
+  it('creates one channel when two consumers ask for the same topic', () => {
+    const first = acquireChannel('topic-shared', (channel) => channel);
+    const second = acquireChannel('topic-shared', (channel) => channel);
+
+    expect(created.filter((topic) => topic === 'topic-shared')).toHaveLength(1);
+
+    // Releasing one consumer must NOT close a channel the other is using.
+    first.release();
+    expect(removed).not.toContain('topic-shared');
+
+    second.release();
+    expect(removed).toContain('topic-shared');
+  });
+
+  it('closes the channel when the last consumer releases', () => {
+    const handle = acquireChannel('topic-sole', (channel) => channel);
+    expect(inspectChannels().some((entry) => entry.topic === 'topic-sole')).toBe(true);
+
+    handle.release();
+    expect(inspectChannels().some((entry) => entry.topic === 'topic-sole')).toBe(false);
+  });
+
+  it('ignores a double release from the same consumer', () => {
+    // React StrictMode and an unmount race both produce this. Without the guard
+    // it would decrement a reference the second consumer still holds.
+    const first = acquireChannel('topic-double', (channel) => channel);
+    const second = acquireChannel('topic-double', (channel) => channel);
+
+    first.release();
+    first.release();
+    first.release();
+
+    expect(removed).not.toContain('topic-double');
+    second.release();
+    expect(removed).toContain('topic-double');
+  });
+
+  it('reports a ref count of two for a shared topic', () => {
+    const first = acquireChannel('topic-count', (channel) => channel);
+    const second = acquireChannel('topic-count', (channel) => channel);
+
+    const entry = inspectChannels().find((candidate) => candidate.topic === 'topic-count');
+    expect(entry?.refCount).toBe(2);
+
+    first.release();
+    second.release();
+  });
+
+  it('uses a distinct channel per conversation, not one per file', () => {
+    const a = acquireChannel('gayze-inbox-a', (channel) => channel);
+    const b = acquireChannel('gayze-inbox-b', (channel) => channel);
+
+    expect(created).toContain('gayze-inbox-a');
+    expect(created).toContain('gayze-inbox-b');
+    expect(created.filter((topic) => topic === 'gayze-inbox-a')).toHaveLength(1);
+
+    a.release();
+    b.release();
+  });
+});
+
+describe('aggregate health', () => {
+  it('is subscribed only when every live channel is subscribed', () => {
+    expect(aggregateRealtimeStatus()).toBe('connecting'); // nothing open yet
+
+    const handle = acquireChannel('topic-health', (channel) => channel);
+    expect(aggregateRealtimeStatus()).toBe('subscribed');
+
+    handle.release();
+  });
+});

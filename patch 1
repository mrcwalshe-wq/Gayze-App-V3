+++ b/src/services/notificationService.ts
@@ -0,0 +1,437 @@
+/**
+ * GAYZE — notification capability, routing and quiet rules.
+ *
+ * This module answers three questions honestly and in one place:
+ *
+ *   1. What notification delivery does THIS device actually support?
+ *   2. Should this particular message produce a notification at all?
+ *   3. Which conversation should a notification tap open?
+ *
+ * The rules for (2) live here rather than in a component, because a
+ * notification that fires for the user's own message, or for the conversation
+ * they are already reading, is the single most common source of "the messaging
+ * layer feels broken" complaints. Components come and go; this does not.
+ *
+ * Honesty rules encoded below:
+ *   * On iOS, the Push API exists only in a Home Screen web app (16.4+). The
+ *     detector reports exactly that, and never reports push as available in a
+ *     plain Safari tab.
+ *   * Nothing here ever claims delivery. `deliver()` reports what it did.
+ *   * No key material is imported or bundled here; the service worker owns the
+ *     push payload and the Edge Function owns the VAPID private key.
+ */
+
+export type NotificationCapability = {
+  /** The Notification API exists at all. */
+  supported: boolean;
+  /** Current permission, or 'unsupported' when the API is missing. */
+  permission: NotificationPermission | 'unsupported';
+  /** Running as an installed app / Home Screen web app. */
+  standalone: boolean;
+  /** iOS or iPadOS (including iPadOS masquerading as macOS). */
+  isIos: boolean;
+  /** The Push API is usable right now, in this context, on this device. */
+  pushSupported: boolean;
+  /** The user has an active push subscription for this install. */
+  pushSubscribed: boolean;
+  /**
+   * True when push exists but only from an installed app and we are in a tab.
+   * Used to render a specific "Add to Home Screen" explanation rather than a
+   * dead button.
+   */
+  pushNeedsInstall: boolean;
+  /** Human-readable reason when push is unavailable. Never shown as "working". */
+  pushUnavailableReason: string | null;
+};
+
+const CONVERSATION_PRIORITY_STORAGE_KEY = 'gayze:notification-prefs:v1';
+
+export type NotificationPrefs = {
+  /** Master switch for in-app notifications while the app is open. */
+  inAppEnabled: boolean;
+  /** Sounds for incoming messages and calls. */
+  soundEnabled: boolean;
+  /** Vibration on supported devices. */
+  vibrationEnabled: boolean;
+};
+
+const DEFAULT_PREFS: NotificationPrefs = {
+  inAppEnabled: true,
+  soundEnabled: true,
+  vibrationEnabled: true,
+};
+
+/**
+ * The conversation currently on screen, if any.
+ *
+ * Deliberately module-level rather than React state. A notification decision
+ * must not depend on a component being mounted, and a component unmounting must
+ * not leave the "in view" flag stuck on.
+ */
+let visibleConversationId: string | null = null;
+/** True while the app is in the foreground and the user is looking at it. */
+let appForeground = true;
+
+/** The conversation that was last in view, for routing a tap after a reload. */
+let lastKnownConversationId: string | null = null;
+
+export function setVisibleConversation(conversationId: string | null): void {
+  visibleConversationId = conversationId;
+  if (conversationId) lastKnownConversationId = conversationId;
+}
+
+export function getVisibleConversation(): string | null {
+  return visibleConversationId;
+}
+
+export function setAppForeground(foreground: boolean): void {
+  appForeground = foreground;
+}
+
+export function isAppForeground(): boolean {
+  return appForeground;
+}
+
+/* ------------------------------------------------------------------ */
+/* Capability detection                                                */
+/* ------------------------------------------------------------------ */
+
+function detectIos(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const ua = navigator.userAgent || '';
+  // iPadOS 13+ reports itself as Macintosh; the touch points give it away.
+  const isIpadOs = /Macintosh/.test(ua) && typeof document !== 'undefined' && 'ontouchend' in document;
+  return /iPad|iPhone|iPod/.test(ua) || isIpadOs;
+}
+
+function detectStandalone(): boolean {
+  if (typeof window === 'undefined') return false;
+  const iosStandalone = (window.navigator as unknown as { standalone?: boolean }).standalone === true;
+  const displayStandalone =
+    typeof window.matchMedia === 'function' &&
+    window.matchMedia('(display-mode: standalone)').matches;
+  return iosStandalone || displayStandalone;
+}
+
+export function getNotificationCapability(): NotificationCapability {
+  const isIos = detectIos();
+  const standalone = detectStandalone();
+  const notificationApi = typeof window !== 'undefined' && 'Notification' in window;
+  const permission = notificationApi
+    ? Notification.permission
+    : ('unsupported' as const);
+
+  const serviceWorkerAvailable = typeof navigator !== 'undefined' && 'serviceWorker' in navigator;
+  const pushApiAvailable = typeof window !== 'undefined' && 'PushManager' in window;
+
+  // iOS gates the Push API on being an installed Home Screen web app. Checking
+  // this explicitly is the difference between an honest "add to Home Screen"
+  // prompt and a button that silently does nothing.
+  const pushNeedsInstall = isIos && !standalone;
+
+  let pushSupported = false;
+  let pushUnavailableReason: string | null = null;
+
+  if (!serviceWorkerAvailable) {
+    pushUnavailableReason = 'This browser does not support service workers.';
+  } else if (!pushApiAvailable) {
+    pushUnavailableReason = pushNeedsInstall
+      ? 'On iPhone and iPad, background notifications work only after GAYZE is added to the Home Screen.'
+      : 'This browser does not support Web Push.';
+  } else if (pushNeedsInstall) {
+    pushUnavailableReason =
+      'On iPhone and iPad, background notifications require GAYZE to be added to the Home Screen first.';
+  } else {
+    pushSupported = true;
+  }
+
+  return {
+    supported: notificationApi,
+    permission,
+    standalone,
+    isIos,
+    pushSupported,
+    pushSubscribed: false, // refined by the push service after it checks the registration
+    pushNeedsInstall,
+    pushUnavailableReason,
+  };
+}
+
+/** Permission request, translated into a specific, actionable outcome. */
+export type PermissionOutcome =
+  | { granted: true }
+  | { granted: false; reason: 'dismissed' | 'denied' | 'unsupported' | 'needs-install'; message: string };
+
+export async function requestNotificationPermission(): Promise<PermissionOutcome> {
+  if (typeof window === 'undefined' || !('Notification' in window)) {
+    return {
+      granted: false,
+      reason: 'unsupported',
+      message: 'This browser does not support notifications. In-app alerts will still appear while GAYZE is open.',
+    };
+  }
+
+  if (Notification.permission === 'granted') return { granted: true };
+
+  if (Notification.permission === 'denied') {
+    return {
+      granted: false,
+      reason: 'denied',
+      message: 'Notifications are blocked for GAYZE. Open your browser or system settings for this site and allow notifications.',
+    };
+  }
+
+  try {
+    const result = await Notification.requestPermission();
+    if (result === 'granted') return { granted: true };
+    if (result === 'denied') {
+      return {
+        granted: false,
+        reason: 'denied',
+        message: 'Notifications are blocked for GAYZE. Open your browser or system settings for this site and allow notifications.',
+      };
+    }
+    return {
+      granted: false,
+      reason: 'dismissed',
+      message: 'Notification permission was dismissed. GAYZE will keep showing in-app alerts while it is open.',
+    };
+  } catch (error: any) {
+    return {
+      granted: false,
+      reason: 'unsupported',
+      message: error?.message || 'Notifications could not be enabled on this device.',
+    };
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Quiet rules                                                         */
+/* ------------------------------------------------------------------ */
+
+export type NotificationCandidate = {
+  conversationId: string;
+  senderId: string;
+  senderName: string;
+  preview: string;
+  occurredAt: number;
+};
+
+export type NotificationDecision =
+  | { notify: false; reason: 'own-message' | 'conversation-in-view' | 'app-hidden-pref-off' | 'duplicate' | 'prefs-off' }
+  | { notify: true; surface: 'in-app' | 'system' };
+
+/** Message ids we have already announced, so a Realtime echo cannot double-toast. */
+const announcedMessageIds = new Set<string>();
+const ANNOUNCED_LIMIT = 500;
+
+function rememberAnnouncement(messageId: string): boolean {
+  if (announcedMessageIds.has(messageId)) return false;
+  announcedMessageIds.add(messageId);
+  if (announcedMessageIds.size > ANNOUNCED_LIMIT) {
+    // Drop the oldest half. A Set preserves insertion order, so this is a queue.
+    const iterator = announcedMessageIds.values();
+    for (let i = 0; i < ANNOUNCED_LIMIT / 2; i += 1) {
+      const next = iterator.next();
+      if (next.done) break;
+      announcedMessageIds.delete(next.value);
+    }
+  }
+  return true;
+}
+
+export function decideNotification(
+  candidate: NotificationCandidate,
+  options: { messageId: string; currentUserId: string | null; prefs?: NotificationPrefs },
+): NotificationDecision {
+  const prefs = options.prefs ?? loadNotificationPrefs();
+
+  // 1. Never tell someone about their own message.
+  if (options.currentUserId && candidate.senderId === options.currentUserId) {
+    return { notify: false, reason: 'own-message' };
+  }
+
+  // 2. Suppress entirely while the user is looking at that conversation. The
+  //    message still appears in the thread; a banner on top of it would be
+  //    noise, and on mobile it would cover the composer.
+  if (appForeground && visibleConversationId && visibleConversationId === candidate.conversationId) {
+    return { notify: false, reason: 'conversation-in-view' };
+  }
+
+  // 3. Deduplicate. Realtime can re-deliver a row after a reconnect, and the
+  //    optimistic insert can race the echo.
+  if (!rememberAnnouncement(options.messageId)) {
+    return { notify: false, reason: 'duplicate' };
+  }
+
+  if (!prefs.inAppEnabled && appForeground) {
+    return { notify: false, reason: 'prefs-off' };
+  }
+
+  // While the app is open we own the notification surface, so we render it
+  // ourselves: it can be styled, positioned and routed without a permission
+  // prompt. The system notification path is for when the app is hidden, and it
+  // is driven by the service worker, not from here.
+  return { notify: true, surface: 'in-app' };
+}
+
+/* ------------------------------------------------------------------ */
+/* Preferences                                                         */
+/* ------------------------------------------------------------------ */
+
+export function loadNotificationPrefs(): NotificationPrefs {
+  if (typeof localStorage === 'undefined') return DEFAULT_PREFS;
+  try {
+    const raw = localStorage.getItem(CONVERSATION_PRIORITY_STORAGE_KEY);
+    if (!raw) return DEFAULT_PREFS;
+    const parsed = JSON.parse(raw) as Partial<NotificationPrefs>;
+    return {
+      inAppEnabled: parsed.inAppEnabled ?? DEFAULT_PREFS.inAppEnabled,
+      soundEnabled: parsed.soundEnabled ?? DEFAULT_PREFS.soundEnabled,
+      vibrationEnabled: parsed.vibrationEnabled ?? DEFAULT_PREFS.vibrationEnabled,
+    };
+  } catch {
+    return DEFAULT_PREFS;
+  }
+}
+
+export function saveNotificationPrefs(prefs: NotificationPrefs): void {
+  if (typeof localStorage === 'undefined') return;
+  try {
+    localStorage.setItem(CONVERSATION_PRIORITY_STORAGE_KEY, JSON.stringify(prefs));
+  } catch {
+    /* storage disabled — preferences stay in memory for this session */
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Deep-link routing                                                   */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Notification clicks (from the service worker) and cold starts both need to
+ * land on the right conversation. The service worker cannot reach React, so it
+ * navigates to `/?conversation=<id>`; this reads and clears it.
+ */
+export function consumeConversationDeepLink(): string | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const url = new URL(window.location.href);
+    const fromQuery = url.searchParams.get('conversation');
+    if (fromQuery) {
+      url.searchParams.delete('conversation');
+      window.history.replaceState({}, '', url.toString());
+      return fromQuery;
+    }
+  } catch {
+    /* malformed URL — fall through */
+  }
+  return lastKnownConversationId;
+}
+
+/** Registers the listener for messages posted by the service worker. */
+export function listenForServiceWorkerMessages(
+  onOpenConversation: (conversationId: string) => void,
+): () => void {
+  if (typeof navigator === 'undefined' || !('serviceWorker' in navigator)) {
+    return () => undefined;
+  }
+
+  const handler = (event: MessageEvent) => {
+    const data = event.data as { type?: string; conversationId?: string } | null;
+    if (!data || data.type !== 'gayze:open-conversation' || !data.conversationId) return;
+    onOpenConversation(data.conversationId);
+  };
+
+  navigator.serviceWorker.addEventListener('message', handler);
+  return () => navigator.serviceWorker.removeEventListener('message', handler);
+}
+
+/* ------------------------------------------------------------------ */
+/* Haptics + sound                                                     */
+/* ------------------------------------------------------------------ */
+
+export function notifyHaptic(pattern: number | number[] = [18, 60, 18]): void {
+  const prefs = loadNotificationPrefs();
+  if (!prefs.vibrationEnabled) return;
+  if (typeof navigator === 'undefined' || typeof navigator.vibrate !== 'function') return;
+  try {
+    navigator.vibrate(pattern);
+  } catch {
+    /* unsupported — silent by design */
+  }
+}
+
+/**
+ * One shared AudioContext, created and resumed inside a user gesture.
+ *
+ * iOS will not let a page play audio until an AudioContext has been started
+ * from a real user interaction, and a context created later is born suspended.
+ * Building one per notification therefore produced silence on every iPhone —
+ * the previous behaviour. `primeAudio()` is called from the first pointer or
+ * key event and resumes the shared context, after which notification sounds
+ * work for the rest of the session.
+ */
+let sharedAudioContext: AudioContext | null = null;
+
+function audioContextConstructor(): typeof AudioContext | null {
+  if (typeof window === 'undefined') return null;
+  return window.AudioContext
+    || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext
+    || null;
+}
+
+/**
+ * Unlocks audio playback. Must be called from a user gesture. Safe to call on
+ * every interaction; it only acts when the context needs starting or resuming.
+ */
+export function primeAudio(): void {
+  const Ctor = audioContextConstructor();
+  if (!Ctor) return;
+  try {
+    if (!sharedAudioContext || sharedAudioContext.state === 'closed') {
+      sharedAudioContext = new Ctor();
+    }
+    if (sharedAudioContext.state === 'suspended') {
+      void sharedAudioContext.resume().catch(() => undefined);
+    }
+  } catch {
+    /* audio unavailable — notifications are still shown, just silently */
+  }
+}
+
+/**
+ * A short two-tone chime, synthesised rather than fetched so it never blocks a
+ * notification on a network request and adds nothing to the bundle.
+ */
+export function notifySound(kind: 'message' | 'call' = 'message'): void {
+  const prefs = loadNotificationPrefs();
+  if (!prefs.soundEnabled) return;
+  const context = sharedAudioContext;
+  // No primed context means no user gesture has happened yet, so iOS would
+  // ignore anything we played. Staying quiet is the honest outcome; the
+  // notification itself is still shown.
+  if (!context || context.state !== 'running') return;
+
+  try {
+    const now = context.currentTime;
+    const notes = kind === 'call' ? [660, 880, 1046] : [784, 1046];
+    notes.forEach((frequency, index) => {
+      const oscillator = context.createOscillator();
+      const gain = context.createGain();
+      oscillator.type = 'sine';
+      oscillator.frequency.value = frequency;
+      gain.gain.setValueAtTime(0.0001, now + index * 0.11);
+      gain.gain.exponentialRampToValueAtTime(0.055, now + index * 0.11 + 0.02);
+      gain.gain.exponentialRampToValueAtTime(0.0001, now + index * 0.11 + 0.14);
+      oscillator.connect(gain);
+      gain.connect(context.destination);
+      oscillator.start(now + index * 0.11);
+      oscillator.stop(now + index * 0.11 + 0.16);
+    });
+    // The context is deliberately NOT closed: it is shared and stays primed for
+    // the rest of the session. Closed contexts cannot be resumed.
+  } catch {
+    /* audio unavailable — never fatal */
+  }
+}

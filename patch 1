@@ -0,0 +1,410 @@
+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { X, Plus, Clock, Trash2, Lock, Users, ImagePlus, AlertCircle, Loader2 } from 'lucide-react';
+import type { SwarmRoom } from '../types';
+import {
+  ALBUM_DURATIONS,
+  createAlbum,
+  deleteAlbum,
+  deleteAlbumItem,
+  formatAlbumRemaining,
+  getAlbumItemUrl,
+  isAlbumExpired,
+  loadVisibleAlbums,
+  subscribeToAlbums,
+  uploadAlbumItem,
+  type AlbumRow,
+  type AlbumWithItems,
+} from '../services/albumService';
+import { hapticLight, hapticSensitiveAction } from '../services/hapticService';
+
+interface TimedAlbumSheetProps {
+  isOpen: boolean;
+  onClose: () => void;
+  room: SwarmRoom | null;
+  userId: string | null;
+  /** True when this conversation has a resolved key, so items can be encrypted. */
+  canEncrypt: boolean;
+}
+
+/**
+ * Timed albums.
+ *
+ * The sheet shows the album's real `expires_at` and never invents one. Once an
+ * album passes its expiry the database stops returning it and the storage policy
+ * stops signing its objects, so the sheet simply stops listing it — there is no
+ * client-side "hide" that a determined user could undo.
+ */
+export const TimedAlbumSheet: React.FC<TimedAlbumSheetProps> = ({
+  isOpen,
+  onClose,
+  room,
+  userId,
+  canEncrypt,
+}) => {
+  const [albums, setAlbums] = useState<AlbumWithItems[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+  const [urls, setUrls] = useState<Record<string, string>>({});
+  const [creating, setCreating] = useState(false);
+  const [durationId, setDurationId] = useState<string>('24h');
+  const [customSeconds, setCustomSeconds] = useState<string>('7200');
+  const [now, setNow] = useState(() => Date.now());
+  const fileInputRef = useRef<HTMLInputElement | null>(null);
+  const targetAlbumRef = useRef<AlbumRow | null>(null);
+
+  const refresh = useCallback(async () => {
+    const next = await loadVisibleAlbums();
+    setAlbums(next);
+    setLoading(false);
+  }, []);
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setLoading(true);
+    void refresh();
+    const unsubscribe = userId ? subscribeToAlbums(userId, () => { void refresh(); }) : () => undefined;
+    return unsubscribe;
+  }, [isOpen, userId, refresh]);
+
+  // One clock for the sheet, and only while it is open.
+  useEffect(() => {
+    if (!isOpen) return;
+    const interval = window.setInterval(() => setNow(Date.now()), 1000);
+    return () => window.clearInterval(interval);
+  }, [isOpen]);
+
+  // Signed URLs are fetched per visible item and expire in five minutes, so
+  // they are never cached beyond the lifetime of this sheet.
+  useEffect(() => {
+    if (!isOpen) return;
+    let disposed = false;
+    // Each item carries its album's expiry so the signature is never given
+    // more life than the album has left.
+    const missing = albums
+      .flatMap((album) => album.items.map((item) => ({ item, expiresAt: album.expires_at })))
+      .filter(({ item }) => !urls[item.id]);
+
+    if (missing.length === 0) return;
+
+    void (async () => {
+      const resolved: Record<string, string> = {};
+      for (const { item, expiresAt } of missing.slice(0, 24)) {
+        const url = await getAlbumItemUrl(item, expiresAt);
+        if (url) resolved[item.id] = url;
+      }
+      if (!disposed && Object.keys(resolved).length) {
+        setUrls((prev) => ({ ...prev, ...resolved }));
+      }
+    })();
+
+    return () => { disposed = true; };
+  }, [isOpen, albums, urls]);
+
+  const relevant = useMemo(
+    () =>
+      albums.filter((album) => {
+        if (isAlbumExpired(album, now)) return false; // the server would not return it either
+        if (album.visibility === 'conversation') return album.conversation_id === room?.id;
+        return album.owner_id === userId;
+      }),
+    [albums, room?.id, userId, now],
+  );
+
+  const selectedDuration = ALBUM_DURATIONS.find((option) => option.id === durationId);
+  const ttlSeconds = durationId === 'custom'
+    ? Math.max(60, Math.min(60 * 24 * 3600, Number(customSeconds) || 0))
+    : selectedDuration?.seconds ?? null;
+
+  const handleCreate = async () => {
+    if (!room) {
+      setError('Open a conversation first.');
+      return;
+    }
+    hapticLight();
+    setBusy(true);
+    setError(null);
+    setStatus(null);
+
+    const result = await createAlbum({
+      visibility: 'conversation',
+      conversationId: room.id,
+      title: null,
+      ttlSeconds: ttlSeconds ?? null,
+    });
+
+    setBusy(false);
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+
+    // Creation and the first upload are one action from the member's point of
+    // view: an album with nothing in it is not something anyone wants.
+    if (result.album) {
+      targetAlbumRef.current = result.album;
+      setCreating(false);
+      setStatus('Album created. Choose the media to add.');
+      fileInputRef.current?.click();
+    }
+    await refresh();
+  };
+
+  const handleFiles = async (files: FileList | null) => {
+    const album = targetAlbumRef.current;
+    if (!files?.length || !album) return;
+
+    setBusy(true);
+    setError(null);
+    let added = 0;
+
+    for (const file of Array.from(files).slice(0, 10)) {
+      const result = await uploadAlbumItem({
+        album,
+        file,
+        room,
+        userId,
+        // Conversation albums are encrypted with the conversation key; if it
+        // has not been resolved the caller is told, rather than the media being
+        // uploaded in the clear.
+        encrypt: album.visibility === 'conversation' ? canEncrypt : false,
+      });
+
+      if (!result.ok) {
+        setError(result.error);
+        break;
+      }
+      added += 1;
+    }
+
+    setBusy(false);
+    targetAlbumRef.current = null;
+    setStatus(added ? `${added} item${added === 1 ? '' : 's'} added.` : null);
+    await refresh();
+  };
+
+  const handleDeleteAlbum = async (album: AlbumWithItems) => {
+    hapticSensitiveAction();
+    setBusy(true);
+    const result = await deleteAlbum(album);
+    setBusy(false);
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+    await refresh();
+  };
+
+  const handleDeleteItem = async (album: AlbumWithItems, itemId: string) => {
+    const item = album.items.find((candidate) => candidate.id === itemId);
+    if (!item) return;
+    hapticLight();
+    setBusy(true);
+    const result = await deleteAlbumItem(item);
+    setBusy(false);
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+    await refresh();
+  };
+
+  if (!isOpen) return null;
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/80 backdrop-blur-xl">
+      <div className="w-full sm:max-w-lg max-h-[88dvh] sm:max-h-[80vh] g-panel !rounded-t-[22px] sm:!rounded-[22px] overflow-hidden flex flex-col">
+        <div className="flex items-center justify-between px-4 py-3.5 border-b border-white/[0.08]">
+          <div className="flex items-center gap-2">
+            <Clock className="w-4 h-4 text-[#C9A24D]" />
+            <h2 className="text-[15px] font-semibold text-white">Timed albums</h2>
+          </div>
+          <button
+            type="button"
+            onClick={onClose}
+            aria-label="Close albums"
+            className="w-10 h-10 grid place-items-center rounded-full text-zinc-400 hover:text-white hover:bg-white/[0.06] cursor-pointer"
+          >
+            <X className="w-4 h-4" />
+          </button>
+        </div>
+
+        <div className="flex-1 overflow-y-auto px-4 py-3.5 space-y-3">
+          <p className="text-[11.5px] text-zinc-400 leading-snug">
+            {canEncrypt
+              ? 'Media shared here is encrypted with this conversation’s key before it is uploaded. Once an album expires it is unreachable, including for you.'
+              : 'This conversation’s key is not available on this device, so media cannot be encrypted for it. Creating an encrypted album is blocked until the key resolves.'}
+          </p>
+
+          {error && (
+            <div className="flex items-start gap-2 p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-[11.5px]">
+              <AlertCircle className="w-3.5 h-3.5 mt-px shrink-0" />
+              <span>{error}</span>
+            </div>
+          )}
+
+          {status && !error && (
+            <div className="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-[11.5px]">
+              {status}
+            </div>
+          )}
+
+          {/* New album */}
+          {!creating ? (
+            <button
+              type="button"
+              onClick={() => { setCreating(true); setError(null); }}
+              disabled={busy || !room}
+              className="g-btn g-btn--amber w-full !min-h-[44px] !text-[12.5px] cursor-pointer disabled:opacity-50"
+            >
+              <Plus className="w-4 h-4" />
+              <span>New timed album</span>
+            </button>
+          ) : (
+            <div className="p-3 rounded-xl bg-black/40 border border-white/10 space-y-3">
+              <div className="text-[11.5px] text-zinc-300 font-medium">How long should it exist?</div>
+              <div className="flex flex-wrap gap-1.5">
+                {ALBUM_DURATIONS.map((option) => (
+                  <button
+                    key={option.id}
+                    type="button"
+                    onClick={() => setDurationId(option.id)}
+                    className={`min-h-[36px] px-3 rounded-xl text-[11.5px] border transition-colors cursor-pointer ${
+                      durationId === option.id
+                        ? 'bg-[#C9A24D]/15 border-[#C9A24D]/45 text-[#C9A24D]'
+                        : 'bg-white/[0.03] border-white/10 text-zinc-300 hover:text-white'
+                    }`}
+                  >
+                    {option.label}
+                  </button>
+                ))}
+              </div>
+
+              {durationId === 'custom' && (
+                <label className="flex items-center gap-2 text-[11.5px] text-zinc-300">
+                  <span>Hours:</span>
+                  <input
+                    type="number"
+                    min={1}
+                    max={24}
+                    value={(Number(customSeconds) / 3600).toString()}
+                    onChange={(event) => setCustomSeconds(String(Math.max(1, Number(event.target.value) || 1) * 3600))}
+                    className="w-20 bg-black/50 border border-white/12 rounded-lg px-2 py-1.5 text-[12px] text-white"
+                  />
+                  <span className="text-zinc-500">max 24h</span>
+                </label>
+              )}
+
+              <div className="flex gap-2">
+                <button
+                  type="button"
+                  onClick={handleCreate}
+                  disabled={busy || !canEncrypt}
+                  className="g-btn g-btn--amber flex-1 !min-h-[44px] !text-[12.5px] cursor-pointer disabled:opacity-50"
+                >
+                  {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Plus className="w-4 h-4" />}
+                  <span>Create album</span>
+                </button>
+                <button
+                  type="button"
+                  onClick={() => { setCreating(false); setError(null); }}
+                  className="g-btn g-btn--ghost !min-h-[44px] !text-[12.5px] cursor-pointer"
+                >
+                  Cancel
+                </button>
+              </div>
+            </div>
+          )}
+
+          {/* Existing albums */}
+          {loading ? (
+            <div className="flex items-center justify-center gap-2 py-8 text-zinc-500 text-[12px]">
+              <Loader2 className="w-4 h-4 animate-spin" />
+              <span>Loading albums…</span>
+            </div>
+          ) : relevant.length === 0 ? (
+            <div className="text-center py-8 text-zinc-500 text-[12px]">
+              No albums yet. Anything you create here disappears on its own.
+            </div>
+          ) : (
+            relevant.map((album) => {
+              const mine = album.owner_id === userId;
+              return (
+                <div key={album.id} className="p-3 rounded-xl bg-black/35 border border-white/[0.08] space-y-2.5">
+                  <div className="flex items-center justify-between gap-2">
+                    <span className="flex items-center gap-1.5 text-[11px] text-[#C9A24D]">
+                      <Clock className="w-3 h-3" />
+                      <span>{formatAlbumRemaining(album, now)}</span>
+                    </span>
+                    <span className="flex items-center gap-1 text-[10.5px] text-zinc-500">
+                      {mine ? <Lock className="w-3 h-3" /> : <Users className="w-3 h-3" />}
+                      <span>{mine ? 'Yours' : 'Shared with you'}</span>
+                    </span>
+                  </div>
+
+                  {album.items.length === 0 ? (
+                    <p className="text-[11.5px] text-zinc-500">Empty album.</p>
+                  ) : (
+                    <div className="grid grid-cols-3 gap-1.5">
+                      {album.items.map((item) => (
+                        <div key={item.id} className="relative aspect-square rounded-lg overflow-hidden bg-white/[0.04] border border-white/[0.06]">
+                          {urls[item.id] ? (
+                            <img
+                              src={urls[item.id]}
+                              alt=""
+                              loading="lazy"
+                              className="w-full h-full object-cover"
+                            />
+                          ) : (
+                            <div className="w-full h-full grid place-items-center text-zinc-600">
+                              <ImagePlus className="w-4 h-4" />
+                            </div>
+                          )}
+                          {mine && (
+                            <button
+                              type="button"
+                              onClick={() => handleDeleteItem(album, item.id)}
+                              aria-label="Remove item"
+                              className="absolute top-1 right-1 w-7 h-7 grid place-items-center rounded-full bg-black/70 text-zinc-300 hover:text-rose-300 cursor-pointer"
+                            >
+                              <Trash2 className="w-3 h-3" />
+                            </button>
+                          )}
+                        </div>
+                      ))}
+                    </div>
+                  )}
+
+                  {mine && (
+                    <button
+                      type="button"
+                      onClick={() => handleDeleteAlbum(album)}
+                      disabled={busy}
+                      className="text-[11px] text-zinc-400 hover:text-rose-300 cursor-pointer disabled:opacity-50"
+                    >
+                      Delete album now
+                    </button>
+                  )}
+                </div>
+              );
+            })
+          )}
+        </div>
+
+        {/* A real input, kept out of the flow: the create button drives it. */}
+        <input
+          ref={fileInputRef}
+          type="file"
+          accept="image/jpeg,image/png,image/webp,video/mp4,video/webm"
+          multiple
+          className="hidden"
+          onChange={(event) => {
+            void handleFiles(event.target.files);
+            event.target.value = '';
+          }}
+        />
+      </div>
+    </div>
+  );
+};

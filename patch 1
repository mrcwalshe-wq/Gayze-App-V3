--- /dev/null
+++ b/src/services/pushService.ts
@@ -0,0 +1,222 @@
+/**
+ * GAYZE — Web Push registration.
+ *
+ * Runs entirely on top of `notificationService`'s capability report: if push is
+ * not genuinely available on this device and in this context, every function
+ * here is a no-op that says so. There is no path where the UI can believe push
+ * is active when it is not.
+ *
+ * What lives where:
+ *   VAPID public key   — client, from VITE_VAPID_PUBLIC_KEY (public by design)
+ *   VAPID private key  — Supabase Edge Function secret only, never in the bundle
+ *   subscription keys  — the browser's push service, mirrored to
+ *                        public.push_subscriptions for the sender to use
+ */
+
+import { supabase } from './supabaseClient';
+import { getNotificationCapability, type NotificationCapability } from './notificationService';
+
+const VAPID_PUBLIC_KEY = (import.meta.env.VITE_VAPID_PUBLIC_KEY as string | undefined)?.trim() || '';
+const SW_URL = '/gayze-sw.js';
+
+export type PushRegistrationResult =
+  | { status: 'subscribed' }
+  | { status: 'unsupported'; reason: string }
+  | { status: 'not-configured'; reason: string }
+  | { status: 'denied'; reason: string }
+  | { status: 'failed'; reason: string };
+
+/**
+ * Registers the service worker. Safe to call repeatedly across the app's
+ * lifetime — the browser returns the existing registration.
+ */
+export async function ensureServiceWorker(): Promise<ServiceWorkerRegistration | null> {
+  if (typeof navigator === 'undefined' || !('serviceWorker' in navigator)) return null;
+  try {
+    // updateViaCache: 'none' so a new worker takes effect without a hard reload;
+    // otherwise a stale worker can keep serving old push behaviour.
+    const registration = await navigator.serviceWorker.register(SW_URL, { updateViaCache: 'none' });
+    // Ask the browser to check for a new worker now, rather than on next launch.
+    void registration.update().catch(() => undefined);
+    return registration;
+  } catch (error) {
+    console.warn('[GAYZE Push] Service worker registration failed', error);
+    return null;
+  }
+}
+
+/** base64url → Uint8Array. Required by pushManager.subscribe. */
+function urlBase64ToUint8Array(base64String: string): Uint8Array {
+  const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
+  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const raw = atob(base64);
+  const output = new Uint8Array(raw.length);
+  for (let i = 0; i < raw.length; i += 1) output[i] = raw.charCodeAt(i);
+  return output;
+}
+
+function arrayBufferToBase64Url(buffer: ArrayBuffer | null): string {
+  if (!buffer) return '';
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i += 1) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/**
+ * The current subscription for this install, if the browser has one. Used to
+ * re-sync the backend after it (or the device) lost track.
+ */
+export async function getExistingSubscription(): Promise<PushSubscription | null> {
+  const registration = await ensureServiceWorker();
+  if (!registration) return null;
+  try {
+    return await registration.pushManager.getSubscription();
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Mirrors a browser subscription into public.push_subscriptions. Returns false
+ * when the backend refused — including when it is not configured — so callers
+ * never report a subscription that the sender cannot actually use.
+ */
+export async function persistSubscription(subscription: PushSubscription): Promise<boolean> {
+  if (!supabase) return false;
+  const serialised = subscription.toJSON() as {
+    endpoint?: string;
+    keys?: { p256dh?: string; auth?: string };
+  };
+  const endpoint = serialised.endpoint ?? subscription.endpoint;
+  const p256dh = serialised.keys?.p256dh ?? arrayBufferToBase64Url(subscription.getKey('p256dh'));
+  const auth = serialised.keys?.auth ?? arrayBufferToBase64Url(subscription.getKey('auth'));
+
+  if (!endpoint || !p256dh || !auth) return false;
+
+  const { error } = await supabase.rpc('register_push_subscription', {
+    p_endpoint: endpoint,
+    p_p256dh: p256dh,
+    p_auth: auth,
+    p_user_agent: typeof navigator !== 'undefined' ? navigator.userAgent.slice(0, 300) : null,
+  });
+
+  if (error) {
+    console.warn('[GAYZE Push] Could not store the push subscription:', error.message);
+    return false;
+  }
+  return true;
+}
+
+/**
+ * Full enable flow. Call this from a user gesture — iOS requires it, and the
+ * permission prompt is far more likely to be accepted from an explicit tap.
+ */
+export async function enablePush(): Promise<PushRegistrationResult> {
+  const capability: NotificationCapability = getNotificationCapability();
+
+  if (!capability.pushSupported) {
+    return {
+      status: 'unsupported',
+      reason: capability.pushUnavailableReason || 'Push notifications are not available on this device.',
+    };
+  }
+
+  if (!VAPID_PUBLIC_KEY) {
+    // Honest failure: the browser side would work, but no sender exists, so
+    // subscribing would create a row that never produces a notification.
+    return {
+      status: 'not-configured',
+      reason: 'Background notifications are not configured on this deployment yet. In-app alerts still work while GAYZE is open.',
+    };
+  }
+
+  const registration = await ensureServiceWorker();
+  if (!registration) {
+    return { status: 'failed', reason: 'The notification service worker could not start on this device.' };
+  }
+
+  try {
+    let subscription = await registration.pushManager.getSubscription();
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        // Chrome on Android historically required this flag; passing it is
+        // harmless elsewhere and keeps delivery to a visible notification
+        // possible.
+        userVisibleOnly: true,
+        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY) as unknown as BufferSource,
+      });
+    }
+
+    const stored = await persistSubscription(subscription);
+    if (!stored) {
+      return {
+        status: 'failed',
+        reason: 'The subscription was created on this device but could not be registered with the server, so notifications would not be delivered.',
+      };
+    }
+
+    return { status: 'subscribed' };
+  } catch (error: any) {
+    const name = error?.name || '';
+    if (name === 'NotAllowedError') {
+      return { status: 'denied', reason: 'Notification permission was not granted, so background notifications are off.' };
+    }
+    if (name === 'AbortError') {
+      return { status: 'failed', reason: 'The browser aborted the push subscription. Please try again.' };
+    }
+    return { status: 'failed', reason: error?.message || 'Push notifications could not be enabled on this device.' };
+  }
+}
+
+/** Removes this install's subscription, locally and on the server. */
+export async function disablePush(): Promise<boolean> {
+  const subscription = await getExistingSubscription();
+  if (!subscription) return true;
+
+  const endpoint = subscription.endpoint;
+  try {
+    await subscription.unsubscribe();
+  } catch (error) {
+    console.warn('[GAYZE Push] unsubscribe failed', error);
+  }
+
+  if (supabase) {
+    // The RLS policy only permits deleting the caller's own rows, so this cannot
+    // remove anyone else's subscription even if the endpoint leaked.
+    const { error } = await supabase
+      .from('push_subscriptions')
+      .delete()
+      .eq('endpoint', endpoint);
+    if (error) {
+      console.warn('[GAYZE Push] Could not remove the stored subscription:', error.message);
+    }
+  }
+
+  return true;
+}
+
+/**
+ * Called on launch and whenever the app returns to the foreground.
+ *
+ * Reasons this is needed rather than "subscribe once at first run":
+ *   * iOS can drop a subscription after an app update.
+ *   * The backend row may have been pruned.
+ *   * A failed RPC at subscribe time leaves a browser subscription the sender
+ *     does not know about — re-syncing repairs it silently.
+ */
+export async function syncPushSubscription(): Promise<void> {
+  if (!VAPID_PUBLIC_KEY) return;
+  const capability = getNotificationCapability();
+  if (!capability.pushSupported || capability.permission !== 'granted') return;
+  if (!supabase) return;
+
+  const subscription = await getExistingSubscription();
+  if (!subscription) return; // user never enabled push; nothing to repair
+  await persistSubscription(subscription);
+}
+
+export function isPushConfigured(): boolean {
+  return VAPID_PUBLIC_KEY.length > 0;
+}

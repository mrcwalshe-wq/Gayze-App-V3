+import React, { useEffect, useMemo, useState } from 'react';
+import { X, Check, Loader2, AlertCircle, Plus } from 'lucide-react';
+import { UserProfile } from '../types';
+import { hapticLight } from '../services/hapticService';
+
+interface EditProfileSheetProps {
+  open: boolean;
+  currentUser: UserProfile;
+  busy?: boolean;
+  error?: string | null;
+  onClose: () => void;
+  onSave: (patch: {
+    displayName: string;
+    handle: string;
+    bio: string;
+    age: number | null;
+    interests: string[];
+    privacySetting: UserProfile['privacySetting'];
+  }) => void;
+  onDismissError?: () => void;
+  /** Opens Identity & devices — security stays a separate surface. */
+  onOpenIdentity?: () => void;
+}
+
+const MAX_INTERESTS = 12;
+const MAX_BIO = 400;
+
+const PRIVACY_OPTIONS: { value: UserProfile['privacySetting']; label: string; detail: string }[] = [
+  { value: 'fuzzy_500m', label: 'Fuzzy ±500 m', detail: 'Your area is approximate to 500 metres.' },
+  { value: 'neighborhood', label: 'Neighbourhood only', detail: 'Wider radius — around 800 metres.' },
+  { value: 'ghost', label: 'Ghost mode', detail: 'No location is stored or shared at all.' },
+];
+
+/**
+ * Ordinary profile editing: the things a member says about themselves.
+ *
+ * Security and identity controls are deliberately not here — those live in
+ * Identity & devices, which is a different kind of decision.
+ */
+export const EditProfileSheet: React.FC<EditProfileSheetProps> = ({
+  open,
+  currentUser,
+  busy = false,
+  error = null,
+  onClose,
+  onSave,
+  onDismissError,
+  onOpenIdentity,
+}) => {
+  const [displayName, setDisplayName] = useState(currentUser.displayName);
+  const [handle, setHandle] = useState(currentUser.handle);
+  const [bio, setBio] = useState(currentUser.bio);
+  const [age, setAge] = useState<string>(currentUser.age ? String(currentUser.age) : '');
+  const [interests, setInterests] = useState<string[]>(currentUser.interests);
+  const [interestDraft, setInterestDraft] = useState('');
+  const [privacySetting, setPrivacySetting] = useState<UserProfile['privacySetting']>(currentUser.privacySetting);
+
+  // Re-seed whenever the sheet opens, so a cancelled edit never leaks back in.
+  useEffect(() => {
+    if (!open) return;
+    setDisplayName(currentUser.displayName);
+    setHandle(currentUser.handle);
+    setBio(currentUser.bio);
+    setAge(currentUser.age ? String(currentUser.age) : '');
+    setInterests(currentUser.interests);
+    setInterestDraft('');
+    setPrivacySetting(currentUser.privacySetting);
+  }, [open, currentUser]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') onClose();
+    };
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, [open, onClose]);
+
+  const nameError = useMemo(() => (displayName.trim() ? null : 'A display name is required.'), [displayName]);
+  const handleError = useMemo(() => {
+    const cleaned = handle.trim().toLowerCase().replace(/[^a-z0-9._-]/g, '');
+    if (cleaned.length < 3) return 'Handles are at least 3 characters.';
+    return null;
+  }, [handle]);
+  const ageError = useMemo(() => {
+    if (!age.trim()) return null;
+    const value = Number(age);
+    if (!Number.isFinite(value) || value < 18 || value > 120) return 'Enter an age between 18 and 120.';
+    return null;
+  }, [age]);
+
+  const canSave = !busy && !nameError && !handleError && !ageError;
+
+  const addInterest = () => {
+    const value = interestDraft.trim().slice(0, 28);
+    if (!value) return;
+    if (interests.length >= MAX_INTERESTS) return;
+    if (interests.some((interest) => interest.toLowerCase() === value.toLowerCase())) {
+      setInterestDraft('');
+      return;
+    }
+    hapticLight();
+    setInterests((prev) => [...prev, value]);
+    setInterestDraft('');
+  };
+
+  if (!open) return null;
+
+  return (
+    <div
+      className="g-overlay flex items-end sm:items-center justify-center sm:p-4"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="edit-profile-title"
+    >
+      <div className="g-sheet" onClick={(event) => event.stopPropagation()}>
+        <div className="g-sheet__grip" />
+
+        <div className="g-sheet__head">
+          <div className="min-w-0">
+            <h2 id="edit-profile-title" className="text-[15.5px] font-semibold tracking-[-0.015em] text-white">
+              Edit profile
+            </h2>
+            <p className="text-[11.5px] text-zinc-500 mt-0.5">
+              What other members see alongside your photos and signal.
+            </p>
+          </div>
+          <button type="button" onClick={onClose} className="g-icon-btn g-icon-btn--bare shrink-0" aria-label="Close">
+            <X className="w-5 h-5" />
+          </button>
+        </div>
+
+        <div className="g-sheet__body space-y-5">
+          <div>
+            <label className="g-label" htmlFor="profile-name">Display name</label>
+            <input
+              id="profile-name"
+              className="g-field mt-2.5"
+              value={displayName}
+              onChange={(event) => setDisplayName(event.target.value)}
+              maxLength={60}
+              autoComplete="nickname"
+            />
+            {nameError && <span className="block text-[11.5px] text-rose-300 mt-1.5">{nameError}</span>}
+          </div>
+
+          <div>
+            <label className="g-label" htmlFor="profile-handle">Handle</label>
+            <input
+              id="profile-handle"
+              className="g-field mt-2.5 font-mono"
+              value={handle}
+              onChange={(event) => setHandle(event.target.value)}
+              maxLength={32}
+              autoCapitalize="none"
+              spellCheck={false}
+            />
+            <span className="block text-[11px] text-zinc-500 mt-1.5">
+              {handleError || 'Letters, numbers, dot, dash and underscore. Must be unique.'}
+            </span>
+          </div>
+
+          <div>
+            <label className="g-label" htmlFor="profile-age">Age</label>
+            <input
+              id="profile-age"
+              className="g-field mt-2.5 w-24 tabular-nums"
+              value={age}
+              onChange={(event) => setAge(event.target.value.replace(/[^0-9]/g, '').slice(0, 3))}
+              inputMode="numeric"
+              placeholder="—"
+            />
+            <span className="block text-[11px] text-zinc-500 mt-1.5">
+              {ageError || 'Optional. Shown only as part of your identity, never with a location.'}
+            </span>
+          </div>
+
+          <div>
+            <label className="g-label" htmlFor="profile-bio">Bio</label>
+            <textarea
+              id="profile-bio"
+              className="g-field mt-2.5 min-h-[92px] resize-none leading-relaxed"
+              value={bio}
+              onChange={(event) => setBio(event.target.value.slice(0, MAX_BIO))}
+              placeholder="A line or two about what you’re into."
+              rows={4}
+            />
+            <span className="block text-[11px] text-zinc-600 mt-1.5 text-right tabular-nums">
+              {bio.length}/{MAX_BIO}
+            </span>
+          </div>
+
+          <div>
+            <span className="g-label">Interests</span>
+            <div className="flex flex-wrap gap-1.5 mt-2.5">
+              {interests.map((interest) => (
+                <button
+                  key={interest}
+                  type="button"
+                  onClick={() => setInterests((prev) => prev.filter((entry) => entry !== interest))}
+                  className="g-tag cursor-pointer hover:border-rose-400/40 hover:text-rose-200"
+                  aria-label={`Remove ${interest}`}
+                >
+                  {interest}
+                  <X className="w-3 h-3 opacity-60" />
+                </button>
+              ))}
+              {interests.length === 0 && <span className="text-[12px] text-zinc-500">Nothing added yet.</span>}
+            </div>
+            {interests.length < MAX_INTERESTS && (
+              <div className="flex items-center gap-2 mt-2.5">
+                <input
+                  className="g-field flex-1"
+                  value={interestDraft}
+                  onChange={(event) => setInterestDraft(event.target.value)}
+                  onKeyDown={(event) => {
+                    if (event.key === 'Enter') {
+                      event.preventDefault();
+                      addInterest();
+                    }
+                  }}
+                  placeholder="Add an interest"
+                  maxLength={28}
+                  aria-label="Add an interest"
+                />
+                <button
+                  type="button"
+                  className="g-btn g-btn--quiet !min-h-[42px] !px-3.5"
+                  onClick={addInterest}
+                  disabled={!interestDraft.trim()}
+                  aria-label="Add interest"
+                >
+                  <Plus className="w-4 h-4" />
+                </button>
+              </div>
+            )}
+          </div>
+
+          <div>
+            <span className="g-label">Location privacy</span>
+            <div className="space-y-2 mt-2.5">
+              {PRIVACY_OPTIONS.map((option) => {
+                const selected = privacySetting === option.value;
+                return (
+                  <button
+                    key={option.value}
+                    type="button"
+                    onClick={() => {
+                      hapticLight();
+                      setPrivacySetting(option.value);
+                    }}
+                    className={`w-full flex items-start gap-3 p-3.5 rounded-[14px] border text-left transition-colors cursor-pointer ${
+                      selected
+                        ? 'bg-[#6F3CC3]/12 border-[#6F3CC3]/35'
+                        : 'bg-white/[0.03] border-white/[0.07] hover:border-white/15'
+                    }`}
+                    aria-pressed={selected}
+                  >
+                    <span className="flex-1 min-w-0">
+                      <span className="block text-[13px] font-medium text-white">{option.label}</span>
+                      <span className="block text-[11.5px] text-zinc-500 mt-0.5">{option.detail}</span>
+                    </span>
+                    {selected && (
+                      <span className="w-5 h-5 rounded-full bg-[#7b48d1] flex items-center justify-center shrink-0 mt-0.5">
+                        <Check className="w-3 h-3 text-white" strokeWidth={3} />
+                      </span>
+                    )}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+
+          {onOpenIdentity && (
+            <button
+              type="button"
+              onClick={onOpenIdentity}
+              className="g-row !px-0 text-left"
+            >
+              <span className="min-w-0 flex-1">
+                <span className="block text-[13px] font-medium text-white">Identity & devices</span>
+                <span className="block text-[11.5px] text-zinc-500">
+                  Keys, trusted devices and sign-out live there, not here.
+                </span>
+              </span>
+            </button>
+          )}
+
+          {error && (
+            <div className="flex items-start gap-2 px-3 py-2.5 rounded-[12px] bg-rose-500/10 border border-rose-500/25 text-[12px] text-rose-200">
+              <AlertCircle className="w-3.5 h-3.5 mt-0.5 shrink-0" />
+              <span className="flex-1">{error}</span>
+              {onDismissError && (
+                <button type="button" onClick={onDismissError} className="text-rose-200/70 hover:text-rose-100">
+                  Dismiss
+                </button>
+              )}
+            </div>
+          )}
+        </div>
+
+        <div className="g-sheet__foot">
+          <button type="button" className="g-btn g-btn--quiet flex-1" onClick={onClose} disabled={busy}>
+            Cancel
+          </button>
+          <button
+            type="button"
+            className="g-btn g-btn--primary flex-1"
+            disabled={!canSave}
+            onClick={() =>
+              onSave({
+                displayName: displayName.trim(),
+                handle: handle.trim().toLowerCase(),
+                bio: bio.trim(),
+                age: age.trim() ? Number(age) : null,
+                interests,
+                privacySetting,
+              })
+            }
+          >
+            {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Check className="w-4 h-4" />}
+            {busy ? 'Saving…' : 'Save profile'}
+          </button>

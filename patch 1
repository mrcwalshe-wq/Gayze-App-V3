+++ b/src/services/albumService.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it, vi } from 'vitest';
+
+vi.stubGlobal('navigator', { userAgent: 'vitest', onLine: true });
+
+const {
+  isAlbumExpired,
+  albumRemainingMs,
+  formatAlbumRemaining,
+  ALBUM_DURATIONS,
+  validateAlbumFile,
+  ALBUM_MAX_BYTES,
+} = await import('./albumService');
+
+/**
+ * Timed albums.
+ *
+ * The expiry assertions matter more than they look: the UI countdown is only a
+ * render of `expires_at`, and every one of these cases is decided by comparing
+ * that timestamp to now — never by a client timer that could drift, be paused
+ * by iOS, or be skipped entirely because the tab was closed.
+ */
+
+const NOW = Date.parse('2026-09-28T12:00:00.000Z');
+const inSeconds = (seconds: number) => new Date(NOW + seconds * 1000).toISOString();
+
+describe('album expiry', () => {
+  it('treats a future expiry as live', () => {
+    const album = { expires_at: inSeconds(60) };
+    expect(isAlbumExpired(album, NOW)).toBe(false);
+    expect(albumRemainingMs(album, NOW)).toBe(60_000);
+  });
+
+  it('treats the exact expiry moment as expired', () => {
+    // Not "expires one tick later": the boundary must not leak a frame of
+    // accessible content.
+    const album = { expires_at: inSeconds(0) };
+    expect(isAlbumExpired(album, NOW)).toBe(true);
+    expect(albumRemainingMs(album, NOW)).toBe(0);
+  });
+
+  it('treats a past expiry as expired', () => {
+    const album = { expires_at: inSeconds(-1) };
+    expect(isAlbumExpired(album, NOW)).toBe(true);
+  });
+
+  it('never reports a negative remaining time', () => {
+    // A negative value would render as "-3h left" instead of "Expired".
+    const album = { expires_at: inSeconds(-7200) };
+    expect(albumRemainingMs(album, NOW)).toBe(0);
+  });
+
+  it('treats a null expiry as persistent, not expired', () => {
+    const album = { expires_at: null };
+    expect(isAlbumExpired(album, NOW)).toBe(false);
+    expect(albumRemainingMs(album, NOW)).toBeNull();
+    expect(formatAlbumRemaining(album, NOW)).toBe('Kept until you delete it');
+  });
+});
+
+describe('album duration labels', () => {
+  it('renders each band without ever going negative', () => {
+    expect(formatAlbumRemaining({ expires_at: inSeconds(45) }, NOW)).toBe('45s left');
+    expect(formatAlbumRemaining({ expires_at: inSeconds(90) }, NOW)).toBe('1m left');
+    expect(formatAlbumRemaining({ expires_at: inSeconds(3660) }, NOW)).toBe('1h 1m left');
+    expect(formatAlbumRemaining({ expires_at: inSeconds(90_000) }, NOW)).toBe('1d 1h left');
+    expect(formatAlbumRemaining({ expires_at: inSeconds(-10) }, NOW)).toBe('Expired');
+  });
+
+  it('offers exactly the lifetimes the brief requires', () => {
+    const seconds = ALBUM_DURATIONS.map((duration) => duration.seconds);
+    expect(seconds).toEqual([3600, 21_600, 86_400, 604_800, null]);
+    expect(ALBUM_DURATIONS.find((d) => d.id === 'custom')?.seconds).toBeNull();
+  });
+});
+
+describe('album upload validation', () => {
+  const file = (type: string, size: number) => ({ type, size, name: 'x.jpg' }) as File;
+
+  it('accepts the supported image types', () => {
+    expect(validateAlbumFile(file('image/jpeg', 1024)).ok).toBe(true);
+    expect(validateAlbumFile(file('image/webp', 1024)).ok).toBe(true);
+  });
+
+  it('accepts video', () => {
+    expect(validateAlbumFile(file('video/mp4', 1024)).ok).toBe(true);
+  });
+
+  it('rejects an unsupported type with a specific reason', () => {
+    const result = validateAlbumFile(file('application/pdf', 1024));
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.error).toContain('Only JPEG');
+  });
+
+  it('rejects an oversized file with the actual limit', () => {
+    const result = validateAlbumFile(file('image/jpeg', ALBUM_MAX_BYTES + 1));
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.error).toContain('10 MB');
+  });
+
+  it('accepts a file exactly at the limit', () => {
+    expect(validateAlbumFile(file('image/jpeg', ALBUM_MAX_BYTES)).ok).toBe(true);
+  });
+});

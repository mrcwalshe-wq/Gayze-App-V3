+import { defineConfig } from 'vitest/config';
+
+/**
+ * The comms tests exercise pure logic — notification decisions, album expiry,
+ * message ordering and the realtime ref-count — with no DOM and no network.
+ * That is deliberate: the parts most likely to regress silently are the ones
+ * that decide whether a user is told about something, and whether content they
+ * should not see comes back.
+ */
+export default defineConfig({
+  test: {
+    environment: 'node',
+    include: ['src/**/*.test.ts', 'tests/**/*.test.ts'],
+    reporters: ['default'],
+    // These suites manipulate module-level state (notification quiet rules,
+    // channel ref counts); isolating files keeps them honest.
+    isolate: true,
+    // The database suites boot a real PostgreSQL instance in WASM and apply
+    // every migration; that is seconds, not milliseconds.
+    testTimeout: 180_000,
+    hookTimeout: 180_000,
+  },
+});

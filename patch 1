+/**
+ * The receiving half of RFC 8291, written from the specification rather than by
+ * reusing the sender's helpers, so a mistake in the sender cannot be mirrored
+ * into the verifier.
+ */
+async function decryptAsPushClient(params: {
+  body: Bytes;
+  receiverPrivateKey: CryptoKey;
+  receiverPublicKey: CryptoKey;
+  authSecretBase64Url: string;
+}) {
+  const { body, receiverPrivateKey, receiverPublicKey } = params;
+  const encoder = new TextEncoder();
+
+  // Header: salt(16) || record size(4) || key id length(1) || key id(65)
+  const recordSize = new DataView(body.buffer, body.byteOffset + 16, 4).getUint32(0, false);
+  const keyIdLength = body[20];
+  const salt: Bytes = body.subarray(0, 16) as Bytes;
+  const senderPublicBytes: Bytes = body.subarray(21, 21 + keyIdLength) as Bytes;
+  const ciphertext: Bytes = body.subarray(21 + keyIdLength) as Bytes;
+
+  const senderPublicKey = await crypto.subtle.importKey(
+    'raw',
+    senderPublicBytes,
+    { name: 'ECDH', namedCurve: 'P-256' },
+    false,
+    [],
+  );
+
+  const ecdhSecret = new Uint8Array(
+    await crypto.subtle.deriveBits({ name: 'ECDH', public: senderPublicKey }, receiverPrivateKey, 256),
+  );
+
+  const authSecret: Bytes = decodeBase64Url(params.authSecretBase64Url);
+  const receiverPublicBytes: Bytes = new Uint8Array(await crypto.subtle.exportKey('raw', receiverPublicKey));
+
+  // PRK_key = HKDF-Extract(auth_secret, ecdh_secret)
+  // IKM     = HKDF-Expand(PRK_key, "WebPush: info\0" || ua_public || as_public, 32)
+  const keyInfo = concatBytes(
+    encoder.encode('WebPush: info\0'),
+    receiverPublicBytes,
+    senderPublicBytes,
+  );
+  const ikm = await webcryptoHkdf(authSecret, ecdhSecret, keyInfo, 32);
+
+  const contentEncryptionKey = await webcryptoHkdf(
+    salt,
+    ikm,
+    encoder.encode('Content-Encoding: aes128gcm\0'),
+    16,
+  );
+  const nonce = await webcryptoHkdf(salt, ikm, encoder.encode('Content-Encoding: nonce\0'), 12);
+
+  const key = await crypto.subtle.importKey('raw', contentEncryptionKey, 'AES-GCM', false, ['decrypt']);
+  const plaintext: Bytes = new Uint8Array(
+    await crypto.subtle.decrypt({ name: 'AES-GCM', iv: nonce }, key, ciphertext),
+  );
+
+  // The final record ends with 0x02, preceded by zero padding.
+  let end = plaintext.length;
+  while (end > 0 && plaintext[end - 1] === 0x00) end -= 1;
+  if (end === 0 || plaintext[end - 1] !== 0x02) {
+    throw new Error('missing the 0x02 record delimiter');
+  }
+
+  return {
+    plaintext: new TextDecoder().decode(plaintext.subarray(0, end - 1)),
+    recordSize,
+    saltLength: salt.length,
+    keyIdLength,
+  };
+}
+
+function concatBytes(...arrays: Bytes[]): Bytes {
+  const total = arrays.reduce((sum, a) => sum + a.length, 0);
+  const out = new Uint8Array(total);
+  let offset = 0;
+  for (const a of arrays) { out.set(a, offset); offset += a.length; }
+  return out;
+}
+
+async function webcryptoHkdf(
+  salt: Bytes,
+  ikm: Bytes,
+  info: Bytes,
+  length: number,
+): Promise<Bytes> {
+  const key = await crypto.subtle.importKey('raw', ikm, 'HKDF', false, ['deriveBits']);
+  return new Uint8Array(
+    await crypto.subtle.deriveBits({ name: 'HKDF', hash: 'SHA-256', salt, info }, key, length * 8),
+  );
+}

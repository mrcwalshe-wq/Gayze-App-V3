@@ -0,0 +1,344 @@
+import React, { useCallback, useRef, useState } from 'react';
+import { Plus, Star, Trash2, ChevronLeft, ChevronRight, ImagePlus, AlertCircle, Loader2 } from 'lucide-react';
+import { ProfilePhotoSurface } from './ProfilePhoto';
+
+import type { ProfilePhoto } from '../services/profilePhotoService';
+
+/** Mirrors the limit enforced by the service and the storage policy. */
+const PROFILE_PHOTO_LIMIT = 6;
+
+interface ProfileAlbumProps {
+  photos: ProfilePhoto[];
+  name: string;
+  /** Owner sees add / set primary / reorder / remove. Viewers see a gallery. */
+  editable?: boolean;
+  /**
+   * `full` is the owner's album (dominant primary + strip).
+   * `rail` is the compact view-only rail used inside a sheet, so another
+   * member's photos never take over a map-focused surface.
+   */
+  variant?: 'full' | 'rail';
+  unavailable?: boolean;
+  busy?: boolean;
+  /** First load: show skeleton tiles instead of claiming the album is empty. */
+  loading?: boolean;
+  error?: string | null;
+  onAddPhoto?: (file: File) => void;
+  onDeletePhoto?: (photo: ProfilePhoto) => void;
+  onSetPrimary?: (photo: ProfilePhoto) => void;
+  onReorder?: (photoIds: string[]) => void;
+  onOpenViewer?: (index: number) => void;
+  onDismissError?: () => void;
+}
+
+/**
+ * The album: one dominant photo, then a restrained strip.
+ *
+ * Deliberately not a dating-app photo wall — the primary image carries the
+ * identity and the rest sit in a single scrollable row that stays inside the
+ * viewport on a 390 px phone.
+ */
+export const ProfileAlbum: React.FC<ProfileAlbumProps> = ({
+  photos,
+  name,
+  editable = false,
+  variant = 'full',
+  unavailable = false,
+  busy = false,
+  loading = false,
+  error = null,
+  onAddPhoto,
+  onDeletePhoto,
+  onSetPrimary,
+  onReorder,
+  onOpenViewer,
+  onDismissError,
+}) => {
+  const fileInputRef = useRef<HTMLInputElement | null>(null);
+  const [manage, setManage] = useState(false);
+
+  const ordered = [...photos].sort((a, b) => {
+    if (a.isPrimary !== b.isPrimary) return a.isPrimary ? -1 : 1;
+    if (a.sortOrder !== b.sortOrder) return a.sortOrder - b.sortOrder;
+    return a.createdAt.localeCompare(b.createdAt);
+  });
+
+  const primary = ordered.find((photo) => photo.isPrimary) ?? ordered[0] ?? null;
+  const rest = ordered.filter((photo) => photo.id !== primary?.id);
+  const atLimit = ordered.length >= PROFILE_PHOTO_LIMIT;
+
+  const handleFile = useCallback(
+    (event: React.ChangeEvent<HTMLInputElement>) => {
+      const file = event.target.files?.[0];
+      event.target.value = ''; // allow re-selecting the same file
+      if (file && onAddPhoto) onAddPhoto(file);
+    },
+    [onAddPhoto],
+  );
+
+  if (variant === 'rail') {
+    if (ordered.length === 0) return null;
+    return (
+      <div className="flex gap-2 overflow-x-auto no-scrollbar -mx-0.5 px-0.5 pb-0.5" role="group" aria-label={`${name}'s photos`}>
+        {ordered.map((photo, index) => (
+          <button
+            key={photo.id}
+            type="button"
+            onClick={() => onOpenViewer?.(index)}
+            className="g-photo-focus relative w-[92px] h-[116px] shrink-0 rounded-[14px] overflow-hidden border border-white/[0.08] cursor-pointer"
+            aria-label={`Open photo ${index + 1} of ${ordered.length}`}
+          >
+            <ProfilePhotoSurface
+              path={photo.storagePath}
+              name={name}
+              className="w-full h-full"
+              alt={`${name} — photo ${index + 1} of ${ordered.length}`}
+            />
+          </button>
+        ))}
+      </div>
+    );
+  }
+
+  const move = (photo: ProfilePhoto, direction: -1 | 1) => {
+    if (!onReorder) return;
+    const index = ordered.findIndex((entry) => entry.id === photo.id);
+    const target = index + direction;
+    if (index < 0 || target < 0 || target >= ordered.length) return;
+    const next = [...ordered];
+    const [moved] = next.splice(index, 1);
+    next.splice(target, 0, moved);
+    onReorder(next.map((entry) => entry.id));
+  };
+
+  return (
+    <section className="mb-5">
+      <div className="flex items-center justify-between gap-3">
+        <span className="g-label">Photos</span>
+        {editable && !unavailable && ordered.length > 0 && (
+          <button
+            type="button"
+            onClick={() => setManage((value) => !value)}
+            className="text-[12px] font-medium text-zinc-400 hover:text-white transition-colors"
+            aria-pressed={manage}
+          >
+            {manage ? 'Done' : 'Manage'}
+          </button>
+        )}
+      </div>
+
+      {unavailable ? (
+        <div className="g-empty mt-2.5 !py-5">
+          <div className="g-empty__icon">
+            <ImagePlus className="w-5 h-5" />
+          </div>
+          <h3>Photo library not available yet</h3>
+          <p>
+            Profile photos need a connected GAYZE backend with profile photo storage enabled.
+            Nothing is shown rather than a stand-in image.
+          </p>
+        </div>
+      ) : ordered.length === 0 && loading ? (
+        <div className="mt-2.5 space-y-2.5">
+          <div className="w-full aspect-[4/5] max-h-[420px] rounded-[22px] g-skel" aria-hidden="true" />
+          <div className="flex gap-2" aria-hidden="true">
+            <div className="w-[74px] h-[94px] rounded-[14px] g-skel" />
+            <div className="w-[74px] h-[94px] rounded-[14px] g-skel" />
+          </div>
+          <span className="sr-only">Loading photos</span>
+        </div>
+      ) : ordered.length === 0 ? (
+        <div className="g-empty mt-2.5 !py-5">
+          <div className="g-empty__icon">
+            <ImagePlus className="w-5 h-5" />
+          </div>
+          <h3>{editable ? 'Add your first photo' : 'No photos yet'}</h3>
+          <p>
+            {editable
+              ? 'Your photo is how people recognise you on the map. Up to six, JPEG/PNG/WebP, 5 MB each.'
+              : `${name} has not added photos yet.`}
+          </p>
+          {editable && onAddPhoto && (
+            <button
+              type="button"
+              className="g-btn g-btn--primary !min-h-[40px] mt-1"
+              onClick={() => fileInputRef.current?.click()}
+              disabled={busy}
+            >
+              {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Plus className="w-4 h-4" />}
+              {busy ? 'Uploading…' : 'Add photo'}
+            </button>
+          )}
+        </div>
+      ) : (
+        <>
+          {/* Primary image — the identity anchor. */}
+          <button
+            type="button"
+            onClick={() => primary && onOpenViewer?.(ordered.indexOf(primary))}
+            className="g-photo-focus relative mt-2.5 block w-full aspect-[4/5] max-h-[420px] rounded-[22px] overflow-hidden border border-white/[0.08] text-left cursor-pointer group"
+            aria-label={`Open ${name}'s photos`}
+          >
+            <ProfilePhotoSurface
+              path={primary?.storagePath}
+              name={name}
+              eager
+              className="w-full h-full"
+              alt={primary?.isPrimary ? `${name} — primary photo` : `${name} — photo`}
+            />
+            {ordered.length > 1 && (
+              <span className="absolute right-3 top-3 g-badge g-badge--quiet !bg-black/45 backdrop-blur-sm">
+                {ordered.length} photos
+              </span>
+            )}
+          </button>
+
+          {/* Strip: additional photos, plus the add tile for the owner. */}
+          {(rest.length > 0 || (editable && !atLimit)) && (
+            <div className="mt-2.5 -mx-1 px-1 flex gap-2 overflow-x-auto no-scrollbar pb-1">
+              {rest.map((photo) => {
+                const absoluteIndex = ordered.indexOf(photo);
+                const label = `${name} — photo ${absoluteIndex + 1} of ${ordered.length}`;
+
+                // While managing, the tile is a container so the set-primary and
+                // remove controls can be real buttons inside it (never buttons
+                // nested in a button).
+                if (manage) {
+                  return (
+                    <div
+                      key={photo.id}
+                      className="relative w-[74px] h-[94px] shrink-0 rounded-[14px] overflow-hidden border border-white/[0.08]"
+                    >
+                      <ProfilePhotoSurface
+                        path={photo.storagePath}
+                        name={name}
+                        className="w-full h-full"
+                        alt={label}
+                      />
+                      <div className="absolute inset-0 bg-black/45 flex items-center justify-center gap-1.5">
+                        <button
+                          type="button"
+                          aria-label="Set as primary photo"
+                          title="Set as primary"
+                          onClick={() => onSetPrimary?.(photo)}
+                          disabled={busy}
+                          className="w-7 h-7 rounded-full bg-white/12 hover:bg-white/20 flex items-center justify-center text-white disabled:opacity-40"
+                        >
+                          <Star className="w-3.5 h-3.5" />
+                        </button>
+                        <button
+                          type="button"
+                          aria-label="Remove photo"
+                          title="Remove photo"
+                          onClick={() => onDeletePhoto?.(photo)}
+                          disabled={busy}
+                          className="w-7 h-7 rounded-full bg-rose-500/25 hover:bg-rose-500/40 flex items-center justify-center text-rose-100 disabled:opacity-40"
+                        >
+                          <Trash2 className="w-3.5 h-3.5" />
+                        </button>
+                      </div>
+                    </div>
+                  );
+                }
+
+                return (
+                  <button
+                    key={photo.id}
+                    type="button"
+                    onClick={() => onOpenViewer?.(absoluteIndex)}
+                    className="g-photo-focus relative w-[74px] h-[94px] shrink-0 rounded-[14px] overflow-hidden border border-white/[0.08] cursor-pointer"
+                    aria-label={`Open photo ${absoluteIndex + 1} of ${ordered.length}`}
+                  >
+                    <ProfilePhotoSurface
+                      path={photo.storagePath}
+                      name={name}
+                      className="w-full h-full"
+                      alt={label}
+                    />
+                  </button>
+                );
+              })}
+
+              {editable && !atLimit && (
+                <button
+                  type="button"
+                  onClick={() => fileInputRef.current?.click()}
+                  disabled={busy}
+                  className="w-[74px] h-[94px] shrink-0 rounded-[14px] border border-dashed border-white/15 hover:border-[#6F3CC3]/50 hover:bg-[#6F3CC3]/[0.07] flex flex-col items-center justify-center gap-1.5 text-zinc-400 hover:text-[#c9b0f5] transition-colors cursor-pointer"
+                  aria-label="Add photo"
+                >

@@ -0,0 +1,273 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { X, ChevronLeft, ChevronRight } from 'lucide-react';
+import { ProfilePhotoSurface } from './ProfilePhoto';
+import { getProfilePhotoUrl } from '../services/profilePhotoService';
+import type { ProfilePhoto } from '../services/profilePhotoService';
+
+interface PhotoViewerProps {
+  photos: ProfilePhoto[];
+  /** Index the viewer opens on. */
+  index: number;
+  name: string;
+  onIndexChange: (index: number) => void;
+  onClose: () => void;
+  /** Owner-only affordances (set primary / remove). */
+  onSetPrimary?: (photo: ProfilePhoto) => void;
+  onDelete?: (photo: ProfilePhoto) => void;
+  /** Renders a "Primary" marker on the primary photo. */
+  showPrimaryMarker?: boolean;
+  busy?: boolean;
+}
+
+/**
+ * Full-screen identity gallery.
+ *
+ * Obsidian, not white; the image is the only bright object in the frame. Swipe
+ * (pointer events, so it works with touch, pen and mouse drag), arrow keys,
+ * Escape, prev/next controls, a counter, and a focus trap so keyboard users
+ * cannot tab out into the app behind it.
+ */
+export const PhotoViewer: React.FC<PhotoViewerProps> = ({
+  photos,
+  index,
+  name,
+  onIndexChange,
+  onClose,
+  onSetPrimary,
+  onDelete,
+  showPrimaryMarker = false,
+  busy = false,
+}) => {
+  const [dragOffset, setDragOffset] = useState(0);
+  const [dragging, setDragging] = useState(false);
+  const startXRef = useRef<number | null>(null);
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const closeRef = useRef<HTMLButtonElement | null>(null);
+  const restoreFocusRef = useRef<HTMLElement | null>(null);
+
+  const count = photos.length;
+  const current = photos[Math.min(Math.max(index, 0), Math.max(count - 1, 0))];
+  const hasPrev = index > 0;
+  const hasNext = index < count - 1;
+
+  const go = useCallback(
+    (delta: number) => {
+      const next = index + delta;
+      if (next < 0 || next >= count) return;
+      onIndexChange(next);
+    },
+    [count, index, onIndexChange],
+  );
+
+  const goPrev = useCallback(() => go(-1), [go]);
+  const goNext = useCallback(() => go(1), [go]);
+
+  // Keyboard: arrows move, Escape closes, Tab stays inside the viewer.
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        onClose();
+        return;
+      }
+      if (event.key === 'ArrowLeft') {
+        event.preventDefault();
+        goPrev();
+        return;
+      }
+      if (event.key === 'ArrowRight') {
+        event.preventDefault();
+        goNext();
+        return;
+      }
+      if (event.key === 'Tab') {
+        const focusables = containerRef.current?.querySelectorAll<HTMLElement>('button:not([disabled])');
+        if (!focusables || focusables.length === 0) return;
+        const first = focusables[0];
+        const last = focusables[focusables.length - 1];
+        if (event.shiftKey && document.activeElement === first) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus();
+        }
+      }
+    };
+
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, [goNext, goPrev, onClose]);
+
+  // Focus the close control on open, and return focus where the user left it.
+  useEffect(() => {
+    restoreFocusRef.current = document.activeElement as HTMLElement | null;
+    closeRef.current?.focus();
+    const { overflow } = document.body.style;
+    document.body.style.overflow = 'hidden';
+    return () => {
+      document.body.style.overflow = overflow;
+      restoreFocusRef.current?.focus?.();
+    };
+  }, []);
+
+  // Preload the neighbours so a swipe lands on an already-decoded image.
+  useEffect(() => {
+    const neighbours = [photos[index - 1], photos[index + 1]].filter(Boolean) as ProfilePhoto[];
+    neighbours.forEach((neighbour) => {
+      void getProfilePhotoUrl(neighbour.storagePath).then((url) => {
+        if (!url) return;
+        const image = new Image();
+        image.decoding = 'async';
+        image.src = url;
+      });
+    });
+  }, [index, photos]);
+
+  if (!current) return null;
+
+  const handlePointerDown = (event: React.PointerEvent) => {
+    startXRef.current = event.clientX;
+    setDragging(true);
+  };
+
+  const handlePointerMove = (event: React.PointerEvent) => {
+    if (startXRef.current === null) return;
+    setDragOffset(event.clientX - startXRef.current);
+  };
+
+  const endDrag = () => {
+    const offset = dragOffset;
+    startXRef.current = null;
+    setDragging(false);
+    setDragOffset(0);
+    if (Math.abs(offset) < 56) return;
+    if (offset > 0) goPrev();
+    else goNext();
+  };
+
+  return (
+    <div
+      ref={containerRef}
+      role="dialog"
+      aria-modal="true"
+      aria-label={`${name} — profile photo ${index + 1} of ${count}`}
+      className="g-photo-viewer fixed inset-0 z-[70] flex flex-col select-none"
+    >
+      {/* Header: counter and close, inside the safe area. */}
+      <div className="relative z-10 flex items-center justify-between px-4 pb-2 pt-[calc(env(safe-area-inset-top,0px)+12px)]">
+        <span className="text-[12px] font-medium tabular-nums text-zinc-300" aria-live="polite">
+          {index + 1} / {count}
+        </span>
+        <button
+          ref={closeRef}
+          type="button"
+          onClick={onClose}
+          className="g-icon-btn g-icon-btn--bare !w-11 !h-11 text-white/80 hover:text-white"
+          aria-label="Close photo viewer"
+        >
+          <X className="w-5 h-5" />
+        </button>
+      </div>
+
+      {/* Stage */}
+      <div
+        className="relative flex-1 min-h-0 flex items-center justify-center px-3"
+        onPointerDown={handlePointerDown}
+        onPointerMove={handlePointerMove}
+        onPointerUp={endDrag}
+        onPointerCancel={endDrag}
+        onPointerLeave={() => {
+          if (startXRef.current !== null) endDrag();
+        }}
+        style={{ touchAction: 'pan-y' }}
+      >
+        {hasPrev && (
+          <button
+            type="button"
+            onClick={goPrev}
+            className="g-viewer-nav g-photo-focus left-2 sm:left-4"
+            aria-label="Previous photo"
+          >
+            <ChevronLeft className="w-5 h-5" />
+          </button>
+        )}
+
+        <div
+          className={`max-w-3xl w-full h-full flex items-center justify-center ${
+            dragging || dragOffset ? '' : 'g-viewer-stage'
+          }`}
+          style={{ transform: dragOffset ? `translateX(${dragOffset * 0.35}px)` : undefined }}
+        >
+          <ProfilePhotoSurface
+            // Remount on index change so the previous frame cannot linger.
+            key={current.id}
+            path={current.storagePath}
+            name={name}
+            eager
+            fit="contain"
+            overlay={false}
+            className="w-full h-full !bg-transparent"
+            alt={`${name} — profile photo ${index + 1} of ${count}`}
+          >
+            {current.isPrimary && showPrimaryMarker && (
+              <span className="absolute left-3 bottom-3 g-badge g-badge--trust">Primary</span>
+            )}
+          </ProfilePhotoSurface>
+        </div>
+
+        {hasNext && (
+          <button
+            type="button"
+            onClick={goNext}
+            className="g-viewer-nav g-photo-focus right-2 sm:right-4"
+            aria-label="Next photo"
+          >
+            <ChevronRight className="w-5 h-5" />
+          </button>
+        )}
+      </div>
+
+      {/* Owner controls, above the safe area and clear of the home indicator. */}
+      {(onSetPrimary || onDelete) && (
+        <div className="relative z-10 flex items-center justify-center gap-2 px-4 pb-[calc(env(safe-area-inset-bottom,0px)+18px)] pt-4">
+          {onSetPrimary && !current.isPrimary && (
+            <button
+              type="button"
+              className="g-btn g-btn--quiet !min-h-[40px] text-[12.5px]"
+              onClick={() => onSetPrimary(current)}
+              disabled={busy}
+            >
+              Set as primary
+            </button>
+          )}
+          {onDelete && (
+            <button
+              type="button"
+              className="g-btn g-btn--danger-quiet !min-h-[40px] text-[12.5px]"
+              onClick={() => onDelete(current)}
+              disabled={busy || count <= 1}
+              title={count <= 1 ? 'Keep at least one photo' : 'Remove this photo'}
+            >
+              Remove
+            </button>
+          )}
+        </div>
+      )}
+
+      {/* Dots: only when there is something to distinguish. */}
+      {count > 1 && count <= 8 && (
+        <div className="relative z-10 flex items-center justify-center gap-1.5 pb-3" aria-hidden="true">
+          {photos.map((photo, dotIndex) => (
+            <span
+              key={photo.id}
+              className={`h-1.5 rounded-full transition-all duration-200 ${
+                dotIndex === index ? 'w-4 bg-[#b796f0]' : 'w-1.5 bg-white/25'
+              }`}
+            />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+};

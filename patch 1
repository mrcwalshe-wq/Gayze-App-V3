diff --git a/public/gayze-sw.js b/public/gayze-sw.js
new file mode 100644
index 0000000..998e096
--- /dev/null
+++ b/public/gayze-sw.js
@@ -0,0 +1,155 @@
+/* eslint-disable no-restricted-globals */
+/**
+ * GAYZE service worker — background notifications only.
+ *
+ * Deliberately NOT an offline cache. A naively cached single-page app is one of
+ * the fastest ways to ship a stale UI that contradicts the server, and GAYZE
+ * always reads live data. This worker has exactly two jobs:
+ *
+ *   1. Receive a push from the push service and show a notification.
+ *   2. Route a notification tap to the right conversation.
+ *
+ * It holds no credentials, no keys and no message content beyond the payload it
+ * is asked to display.
+ */
+
+const SW_VERSION = 'gayze-sw-v1';
+
+self.addEventListener('install', (event) => {
+  // Take over promptly; there is no old asset set worth preserving.
+  event.waitUntil(self.skipWaiting());
+});
+
+self.addEventListener('activate', (event) => {
+  event.waitUntil(self.clients.claim());
+});
+
+/* ------------------------------------------------------------------ */
+/* Push delivery                                                       */
+/* ------------------------------------------------------------------ */
+
+self.addEventListener('push', (event) => {
+  let payload = {};
+  try {
+    payload = event.data ? event.data.json() : {};
+  } catch {
+    // A push with a malformed body must still produce a visible notification,
+    // otherwise some browsers (notably iOS) will revoke the subscription.
+    payload = { title: 'GAYZE', body: 'You have a new message.' };
+  }
+
+  const kind = payload.kind === 'call' ? 'call' : 'message';
+  const title = payload.title || (kind === 'call' ? 'Incoming GAYZE call' : 'New message on GAYZE');
+  const body = payload.body || '';
+  const conversationId = payload.conversationId || null;
+  const url = conversationId
+    ? `/?conversation=${encodeURIComponent(conversationId)}`
+    : '/';
+
+  // Tag per conversation for messages so a chatty thread replaces itself rather
+  // than stacking; calls always get their own tag because a missed call must
+  // not be overwritten by a later message.
+  const tag = kind === 'call' ? 'gayze-call' : `gayze-conversation-${conversationId || 'general'}`;
+
+  const options = {
+    body,
+    tag,
+    renotify: kind === 'call',
+    // A call notification must not disappear on its own before the user sees it.
+    requireInteraction: kind === 'call',
+    data: { conversationId, url, kind },
+    icon: '/gayze-icon-192.png',
+    badge: '/gayze-icon-192.png',
+    vibrate: kind === 'call' ? [200, 100, 200, 100, 200] : [90, 40, 90],
+  };
+
+  event.waitUntil(
+    self.registration.showNotification(title, options).catch(() => {
+      // If the icon assets are missing the notification must still be shown;
+      // retry without them rather than failing silently.
+      return self.registration.showNotification(title, {
+        body,
+        tag,
+        data: { conversationId, url, kind },
+      });
+    }),
+  );
+});
+
+/* ------------------------------------------------------------------ */
+/* Notification click                                                  */
+/* ------------------------------------------------------------------ */
+
+self.addEventListener('notificationclick', (event) => {
+  event.notification.close();
+
+  const data = event.notification.data || {};
+  const targetUrl = data.url || '/';
+  const conversationId = data.conversationId || null;
+
+  event.waitUntil((async () => {
+    const allClients = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+
+    // Prefer an existing GAYZE window: the user tapped a notification for an
+    // app they already have open, and opening a second tab would lose their
+    // place.
+    for (const client of allClients) {
+      try {
+        const clientUrl = new URL(client.url);
+        if (clientUrl.origin !== self.location.origin) continue;
+
+        await client.focus();
+
+        // Tell the running app to switch conversations. The app is the only
+        // thing that knows how to navigate its own state; the worker just
+        // delivers the intent. The query string is a fallback for clients whose
+        // React tree is not listening yet.
+        if (conversationId) {
+          client.postMessage({ type: 'gayze:open-conversation', conversationId });
+        }
+        return;
+      } catch {
+        // Unparseable client URL — try the next window.
+      }
+    }
+
+    if (self.clients.openWindow) {
+      await self.clients.openWindow(targetUrl);
+    }
+  })());
+});
+
+/* ------------------------------------------------------------------ */
+/* Subscription changes                                                */
+/* ------------------------------------------------------------------ */
+
+/**
+ * The push service rotates endpoints. When it does, the stored subscription is
+ * dead until it is re-registered — resubscribing and posting the result lets
+ * the page persist the new endpoint instead of waiting for the next launch.
+ */
+self.addEventListener('pushsubscriptionchange', (event) => {
+  event.waitUntil((async () => {
+    try {
+      const subscription = await self.registration.pushManager.subscribe(
+        event.oldSubscription ? event.oldSubscription.options : { userVisibleOnly: true },
+      );
+      const allClients = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+      for (const client of allClients) {
+        client.postMessage({
+          type: 'gayze:push-resubscribed',
+          subscription: subscription.toJSON(),
+        });
+      }
+    } catch {
+      // The next app launch re-syncs the subscription via syncPushSubscription().
+    }
+  })());
+});
+
+self.addEventListener('message', (event) => {
+  const data = event.data || {};
+  if (data.type === 'gayze:sw-version') {
+    event.source && event.source.postMessage({ type: 'gayze:sw-version', version: SW_VERSION });
+  }
+});

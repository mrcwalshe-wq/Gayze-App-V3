new file mode 100644
index 0000000..33f0e26
--- /dev/null
+++ b/src/components/diagnosticPanel.test.ts
@@ -0,0 +1,102 @@
+/**
+ * The diagnostics panel, rendered for real.
+ *
+ * The repository has no DOM harness — the suite runs in `node`, and adding jsdom
+ * for one component is a poor trade — but a server render is enough to prove the
+ * things that matter: that the panel renders at all, that it renders nothing
+ * without `?diag=1`, and that it never prints key material.
+ *
+ * What a render cannot see is the ordering of the guard against the hooks, since
+ * effects do not run here. That invariant is checked against the source, because
+ * getting it wrong means an INSERT on every page load of the deployed app for
+ * every visitor.
+ */
+
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import React from 'react';
+import { renderToString } from 'react-dom/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+/** A window with just enough surface for the component to decide. */
+function stubWindow(search: string): void {
+  const fake = {
+    location: { search, href: `https://gayze.test/${search}`, replace: () => undefined },
+    setInterval: () => 0,
+    clearInterval: () => undefined,
+  };
+  vi.stubGlobal('window', fake);
+}
+
+vi.stubGlobal('localStorage', { getItem: () => null, setItem: () => undefined });
+
+async function loadPanel() {
+  vi.resetModules();
+  return import('./DiagnosticPanel');
+}
+
+beforeEach(() => {
+  stubWindow('');
+});
+
+describe('diagnostic panel', () => {
+  it('renders nothing at all when the URL does not ask for it', async () => {
+    stubWindow('');
+    const { DiagnosticPanel, isDiagnosticsRequested } = await loadPanel();
+
+    expect(isDiagnosticsRequested()).toBe(false);
+    // The strong form: not "renders empty markup", but produces no output.
+    expect(renderToString(React.createElement(DiagnosticPanel))).toBe('');
+  });
+
+  it('renders the panel at ?diag=1', async () => {
+    stubWindow('?diag=1');
+    const { DiagnosticPanel, isDiagnosticsRequested } = await loadPanel();
+
+    expect(isDiagnosticsRequested()).toBe(true);
+    const html = renderToString(React.createElement(DiagnosticPanel));
+
+    expect(html).toContain('MESSAGE PIPELINE DIAGNOSTICS');
+    expect(html).toContain('Re-run');
+    // The panel must say what it does to the database — it writes a row.
+    expect(html).toContain('INSERT probe');
+  });
+
+  it('does not print a key, a token or a JWT', async () => {
+    stubWindow('?diag=1');
+    const { DiagnosticPanel } = await loadPanel();
+    const html = renderToString(React.createElement(DiagnosticPanel));
+
+    for (const forbidden of ['sb_publishable_', 'sb_secret_', 'eyJ', 'service_role']) {
+      expect(html.includes(forbidden), `the panel printed "${forbidden}"`).toBe(false);
+    }
+  });
+
+  it('treats any value other than 1 as not requested', async () => {
+    for (const search of ['?diag=0', '?diag=true', '?diagnostics=1', '?diag=', '']) {
+      stubWindow(search);
+      const { isDiagnosticsRequested } = await loadPanel();
+      expect(isDiagnosticsRequested(), `"${search}" was treated as a request`).toBe(false);
+    }
+  });
+
+  it('keeps every hook inside the inner component', () => {
+    // React runs every hook on every render, so a hook placed in the exported
+    // gate would execute for every visitor regardless of the query parameter —
+    // and the panel's effect performs a real INSERT.
+    const source = readFileSync(path.join(__dirname, 'DiagnosticPanel.tsx'), 'utf8');
+    const exported = source.indexOf('export const DiagnosticPanel');
+    expect(exported, 'the exported component disappeared').toBeGreaterThan(-1);
+
+    const wrapper = source.slice(exported);
+    expect(wrapper).toContain('isDiagnosticsRequested()');
+
+    for (const hook of ['useState', 'useEffect', 'useRef', 'useCallback']) {
+      expect(
+        wrapper.includes(hook),
+        `${hook} appears inside the exported gate, so it runs for every visitor `
+          + 'on every page load whatever the URL says',
+      ).toBe(false);
+    }
+  });
+});

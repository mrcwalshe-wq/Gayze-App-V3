@@ -0,0 +1,126 @@
+/**
+ * The blank-screen guard.
+ *
+ * The reported failure was a black page. Two mechanisms produce one, and both
+ * are covered here because both are easy to remove by accident:
+ *
+ *  1. React unmounts the whole tree on an uncaught error. `index.html` sets a
+ *     near-black body, so an unmount is indistinguishable from a broken app.
+ *     The boundary turns that into a readable screen.
+ *  2. `authReady` gates the UI behind a full-screen near-black loading overlay,
+ *     and it was only ever set from a success callback, so a rejected or
+ *     never-answering session check left it false forever.
+ *
+ * A server render cannot exercise an error boundary — React handles those on the
+ * client — so the first is pinned at the source level, where it can actually
+ * regress, and the second by asserting the bootstrap always settles.
+ */
+
+import { execFileSync } from 'node:child_process';
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import React from 'react';
+import { renderToString } from 'react-dom/server';
+import { describe, expect, it, vi } from 'vitest';
+import { AppErrorBoundary } from './AppErrorBoundary';
+
+const read = (relative: string) => readFileSync(path.join(__dirname, relative), 'utf8');
+
+describe('AppErrorBoundary', () => {
+  it('renders its children untouched when nothing is wrong', () => {
+    vi.stubGlobal('window', { location: { reload: () => undefined, origin: 'https://gayze.test', replace: () => undefined } });
+    const html = renderToString(
+      React.createElement(AppErrorBoundary, null, React.createElement('p', null, 'the app')),
+    );
+    expect(html).toContain('the app');
+    expect(html).not.toContain('Something went wrong');
+  });
+
+  it('implements the hook React calls when a child throws', () => {
+    // Without `getDerivedStateFromError` the class is not a boundary at all and
+    // React falls back to unmounting the tree — the original failure.
+    expect(typeof AppErrorBoundary.getDerivedStateFromError).toBe('function');
+
+    const state = AppErrorBoundary.getDerivedStateFromError(new Error('boom'));
+    expect(state).toMatchObject({ error: expect.any(Error) });
+  });
+
+  it('offers a way out rather than a dead end', () => {
+    const source = read('AppErrorBoundary.tsx');
+    expect(source).toContain('Try again');
+    expect(source).toContain('Sign out and start over');
+    // The brand mark, so a failure still looks like Gayze rather than a blank page.
+    expect(source).toContain('GAYZE_LOGO_PATH');
+  });
+});
+
+describe('the application is wired to the boundary', () => {
+  it('wraps App in main.tsx', () => {
+    const main = readFileSync(path.join(__dirname, '../main.tsx'), 'utf8');
+    expect(main, 'the entry point lost its error boundary').toContain('AppErrorBoundary');
+    expect(main.indexOf('AppErrorBoundary')).toBeLessThan(main.indexOf('</AppErrorBoundary>'));
+    // Against the specific failure that was reported.
+    expect(main).toContain('<App />');
+  });
+});
+
+describe('the auth gate cannot hang', () => {
+  /** The body of the auth bootstrap effect, from the session check to its cleanup. */
+  function bootstrapBody(): string {
+    const app = read('../../src/App.tsx');
+    const check = app.indexOf('getSession()');
+    if (check === -1) return '';
+    // Back up to the start of the effect that owns the call, so the watchdog
+    // declared above it is inside the slice.
+    const start = app.lastIndexOf('useEffect(', check);
+    const end = app.indexOf('subscription.subscription.unsubscribe()', check);
+    return app.slice(start === -1 ? check : start, end === -1 ? check + 2000 : end);
+  }
+
+  it('always settles authReady, on every path', () => {
+    const bootstrap = bootstrapBody();
+    expect(bootstrap, 'the session check was not found at all').not.toBe('');
+    // Verified against the deployed revision: it had neither of these, so a
+    // rejected or stalled session lookup left the loading overlay up forever.
+    expect(bootstrap, 'the session check lost its failure path').toContain('.catch(');
+    expect(bootstrap, 'a never-answering session check can strand the UI').toContain('setTimeout');
+  });
+});
+
+describe('the tree typechecks', () => {
+  it('compiles with no errors', () => {
+    // This is not decoration. The crash that produced the black page was an
+    // undeclared identifier — `supabaseClient` used in an effect that never
+    // declared it. `tsc` reported it as TS2304 while `vite build` succeeded
+    // happily, so the defect shipped and the first symptom was a blank screen on
+    // a signed-in user's phone. Making the typecheck part of the suite is what

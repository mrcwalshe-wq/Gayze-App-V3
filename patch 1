+-- ============================================================================
+-- GAYZE — timed albums (expiring media sharing)
+-- ============================================================================
+-- A timed album is a set of media items that stops existing after a stated
+-- moment. It is a different product from profile photos (persistent identity
+-- media) and from Stories (temporary intent posts): an album is shared media
+-- with an explicit lifetime and an explicit audience.
+--
+-- What "expired" means here, concretely
+-- ------------------------------------
+--   * albums.expires_at is the authority. It defaults to a value chosen at
+--     creation and may be null, which means the owner intends it to persist.
+--   * A RESTRICTIVE RLS policy makes an expired album row unreadable, so it is
+--     not merely hidden in the UI: the API stops returning it.
+--   * The Storage read policy calls the same access function, so a signed URL
+--     cannot be issued for an expired album's object either. That is what
+--     prevents a stale URL from outliving the album — the URL is only useful
+--     while Storage is willing to sign or serve it.
+--   * purge_expired_albums() removes the rows and returns the object paths
+--     that must be deleted from the bucket, so the bytes do not linger.
+--
+-- Audience model
+-- --------------
+--   private       owner only
+--   conversation  the owner plus every current member of one conversation
+--   (no public option: GAYZE has no anonymous media surface)
+--
+-- Encryption note (stated plainly)
+-- --------------------------------
+-- Conversation-scoped album media is encrypted client-side with the existing
+-- per-conversation AES-GCM key before upload, so the backend stores ciphertext.
+-- Private album media is protected by the private bucket, RLS and short-lived
+-- signed URLs — it is NOT end-to-end encrypted, because a personal album has no
+-- conversation key to encrypt against. This migration does not pretend
+-- otherwise.
+--
+-- Safe to run more than once.
+-- ============================================================================
+
+create extension if not exists pgcrypto;
+
+-- ---------------------------------------------------------------------------
+-- 1. albums
+-- ---------------------------------------------------------------------------
+create table if not exists public.albums (
+  id uuid primary key default gen_random_uuid(),
+  owner_id uuid not null references public.profiles (id) on delete cascade,
+  conversation_id uuid references public.conversations (id) on delete set null,
+  title text,
+  visibility text not null default 'private',
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  expires_at timestamptz,
+  constraint albums_visibility_check check (visibility in ('private', 'conversation')),
+  -- A conversation album without a conversation would be unreachable by anyone
+  -- but its owner; refuse it rather than create a confusing orphan.
+  constraint albums_conversation_required check (
+    visibility <> 'conversation' or conversation_id is not null
+  )
+);
+
+comment on table public.albums is
+  'A set of media items with an explicit lifetime. expires_at null means the owner intends it to persist.';
+comment on column public.albums.visibility is
+  'private = owner only; conversation = owner plus current members of conversation_id.';
+
+create index if not exists albums_owner_idx on public.albums (owner_id, created_at desc);
+create index if not exists albums_conversation_idx on public.albums (conversation_id) where conversation_id is not null;
+create index if not exists albums_expires_at_idx on public.albums (expires_at) where expires_at is not null;
+
+-- ---------------------------------------------------------------------------
+-- 2. album_items
+-- ---------------------------------------------------------------------------
+create table if not exists public.album_items (
+  id uuid primary key default gen_random_uuid(),
+  album_id uuid not null references public.albums (id) on delete cascade,
+  owner_id uuid not null references public.profiles (id) on delete cascade,
+  storage_path text not null,
+  media_type text not null default 'image',
+  -- Set when the item body was encrypted client-side with a conversation key.
+  -- The nonce is stored beside it; the key never reaches the backend.
+  encryption_nonce text,
+  sort_order integer not null default 0,
+  created_at timestamptz not null default now(),
+  constraint album_items_storage_path_key unique (storage_path),
+  constraint album_items_media_type_check check (media_type in ('image', 'video')),
+  constraint album_items_sort_order_check check (sort_order >= 0 and sort_order < 200),
+  -- The object must live inside the owner's own folder:
+  --   {owner_id}/{album_id}/{item_id}.{ext}
+  constraint album_items_path_shape_check check (
+    storage_path ~ '^[0-9a-fA-F-]{36}/[0-9a-fA-F-]{36}/[0-9a-fA-F-]{36}\.(jpg|jpeg|png|webp|mp4|webm)$'
+  ),
+  -- …and the path must agree with the row it belongs to. The shape check alone
+  -- accepts any well-formed uuid triple, so without this a member could record
+  -- an item whose storage path points into someone else's folder. Nothing could
+  -- be read through it — the Storage policy re-derives ownership from the path
+  -- and would refuse — but a dangling, misleading row should not be storable in
+  -- the first place. Making the path derivable from the row removes the entire
+  -- class rather than defending against it downstream.
+  constraint album_items_path_ownership_check check (
+    split_part(storage_path, '/', 1) = owner_id::text
+    and split_part(storage_path, '/', 2) = album_id::text
+  )
+);
+
+create index if not exists album_items_album_idx on public.album_items (album_id, sort_order asc, created_at asc);
+
+alter table public.albums enable row level security;
+alter table public.album_items enable row level security;
+
+-- ---------------------------------------------------------------------------
+-- 3. Access function — the answer Storage uses
+-- ---------------------------------------------------------------------------
+-- This is deliberately NOT used by the tables' own SELECT policies; see the
+-- note on albums_select_visible below for why a STABLE function cannot gate a
+-- row being inserted. It is the authority for Storage object reads, where the
+-- album row is always already committed, and it must express exactly the same
+-- predicate as albums_select_visible plus albums_not_expired. The test suite
+-- asserts the two agree, so they cannot silently drift apart.
+create or replace function public.gayze_can_view_album(p_album_id text)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_id uuid;
+  v_owner uuid;
+  v_visibility text;
+  v_conversation uuid;
+  v_expires timestamptz;
+begin
+  if p_album_id is null or p_album_id !~ '^[0-9a-fA-F-]{36}$' then
+    return false;
+  end if;
+
+  v_id := p_album_id::uuid;
+
+  select owner_id, visibility, conversation_id, expires_at
+  into v_owner, v_visibility, v_conversation, v_expires
+  from public.albums
+  where id = v_id;
+
+  if v_owner is null then
+    return false;
+  end if;
+
+  -- Expiry is checked first, and applies to the owner too: an expired album is
+  -- expired, not "expired for other people".
+  if v_expires is not null and v_expires <= now() then
+    return false;
+  end if;
+
+  if v_owner = auth.uid() then
+    return true;
+  end if;
+
+  if v_visibility = 'conversation' and v_conversation is not null then
+    return exists (
+      select 1 from public.conversation_members m
+      where m.conversation_id = v_conversation and m.user_id = auth.uid()
+    );
+  end if;
+
+  return false;
+end;
+$$;
+
+revoke all on function public.gayze_can_view_album(text) from public;
+grant execute on function public.gayze_can_view_album(text) to authenticated;
+
+-- Storage policies call this with the album folder segment, so the same rule
+-- decides object reads. Kept separate from the function above because the
+-- Storage policy only has the path to work with.
+create or replace function public.gayze_can_view_album_object(p_owner text, p_album text)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1
+    from public.albums a
+    where a.id::text = p_album
+      and a.owner_id::text = p_owner
+      and public.gayze_can_view_album(p_album)
+  );
+$$;
+
+revoke all on function public.gayze_can_view_album_object(text, text) from public;
+grant execute on function public.gayze_can_view_album_object(text, text) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 4. Policies
+-- ---------------------------------------------------------------------------
+-- SELECT is expressed as ROW EXPRESSIONS, not as a call to the access function.
+--
+-- This matters and is not a style choice. A STABLE function is evaluated
+-- against the statement snapshot, which does not contain the row the current
+-- INSERT is creating. Because `INSERT ... RETURNING` requires the SELECT policy
+-- to pass, a function-based SELECT policy makes
+-- `insert into albums (...) returning *` fail for every user — album creation
+-- is impossible. Row expressions are evaluated against the candidate row and
+-- have no such problem.
+--
+-- The expiry gate is the RESTRICTIVE policy below, which is also a row
+-- expression, so it holds for INSERT ... RETURNING too.
+--
+-- `gayze_can_view_album()` remains the authority for Storage, where the album
+-- row is always already committed. The two must agree; `tests/security.rls.test.ts`
+-- asserts that they do across a matrix of albums, so they cannot drift.
+drop policy if exists albums_select_visible on public.albums;
+create policy albums_select_visible
+  on public.albums
+  for select
+  to authenticated
+  using (
+    owner_id = auth.uid()
+    or (visibility = 'conversation' and public.gayze_is_conversation_member(conversation_id))
+  );
+
+-- As an extra RESTRICTIVE layer, so a future permissive policy added by hand
+-- cannot accidentally resurrect expired albums.
+drop policy if exists albums_not_expired on public.albums;
+create policy albums_not_expired
+  on public.albums
+  as restrictive
+  for select
+  to authenticated
+  using (expires_at is null or expires_at > now());
+
+drop policy if exists albums_owner_insert on public.albums;
+create policy albums_owner_insert
+  on public.albums
+  for insert
+  to authenticated
+  with check (
+    owner_id = auth.uid()
+    and (
+      visibility = 'private'
+      or public.gayze_is_conversation_member(albums.conversation_id)
+    )
+  );
+
+drop policy if exists albums_owner_update on public.albums;
+create policy albums_owner_update
+  on public.albums
+  for update
+  to authenticated
+  using (owner_id = auth.uid())
+  with check (owner_id = auth.uid());
+
+drop policy if exists albums_owner_delete on public.albums;
+create policy albums_owner_delete
+  on public.albums
+  for delete
+  to authenticated
+  using (owner_id = auth.uid());
+
+-- Items: readable exactly when their album is, writable only by the album owner.
+drop policy if exists album_items_select_visible on public.album_items;
+create policy album_items_select_visible
+  on public.album_items
+  for select
+  to authenticated
+  using (
+    owner_id = auth.uid()
+    or exists (
+      select 1 from public.albums a
+      where a.id = album_items.album_id
+        and a.visibility = 'conversation'
+        and public.gayze_is_conversation_member(a.conversation_id)
+    )
+  );
+
+drop policy if exists album_items_not_expired on public.album_items;
+create policy album_items_not_expired
+  on public.album_items
+  as restrictive
+  for select
+  to authenticated
+  using (
+    exists (
+      select 1 from public.albums a
+      where a.id = album_items.album_id
+        and (a.expires_at is null or a.expires_at > now())
+    )
+  );
+
+drop policy if exists album_items_owner_insert on public.album_items;
+create policy album_items_owner_insert
+  on public.album_items
+  for insert
+  to authenticated
+  with check (
+    owner_id = auth.uid()
+    and exists (
+      select 1 from public.albums a
+      where a.id = album_items.album_id and a.owner_id = auth.uid()
+    )
+  );
+
+drop policy if exists album_items_owner_update on public.album_items;
+create policy album_items_owner_update
+  on public.album_items
+  for update
+  to authenticated
+  using (owner_id = auth.uid())
+  with check (owner_id = auth.uid());
+
+drop policy if exists album_items_owner_delete on public.album_items;
+create policy album_items_owner_delete
+  on public.album_items
+  for delete
+  to authenticated
+  using (owner_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 5. Realtime — so an expiring album and its removal reach open clients
+-- ---------------------------------------------------------------------------
+alter table public.albums replica identity full;
+alter table public.album_items replica identity full;
+
+do $$
+declare
+  t text;
+begin
+  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then
+    foreach t in array array['albums', 'album_items'] loop
+      if not exists (
+        select 1 from pg_publication_tables
+        where pubname = 'supabase_realtime' and schemaname = 'public' and tablename = t
+      ) then
+        execute format('alter publication supabase_realtime add table public.%I', t);
+      end if;
+    end loop;
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 6. Storage
+-- ---------------------------------------------------------------------------
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values (
+  'album-media',
+  'album-media',
+  false,
+  10485760, -- 10 MB
+  array['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/webm']
+)
+on conflict (id) do update
+  set public = false,
+      file_size_limit = excluded.file_size_limit,
+      allowed_mime_types = excluded.allowed_mime_types;
+
+drop policy if exists album_media_objects_select on storage.objects;
+create policy album_media_objects_select
+  on storage.objects
+  for select
+  to authenticated
+  using (
+    bucket_id = 'album-media'
+    and public.gayze_can_view_album_object(
+      (storage.foldername(name))[1],
+      (storage.foldername(name))[2]
+    )
+  );
+
+drop policy if exists album_media_objects_insert on storage.objects;
+create policy album_media_objects_insert
+  on storage.objects
+  for insert
+  to authenticated
+  with check (
+    bucket_id = 'album-media'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.gayze_can_view_album((storage.foldername(name))[2])
+  );
+
+drop policy if exists album_media_objects_delete on storage.objects;
+create policy album_media_objects_delete
+  on storage.objects
+  for delete
+  to authenticated
+  using (
+    bucket_id = 'album-media'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
+
+-- ---------------------------------------------------------------------------
+-- 6b. Grants
+-- ---------------------------------------------------------------------------
+grant select, insert, update, delete on public.albums to authenticated;
+grant select, insert, update, delete on public.album_items to authenticated;
+grant all on public.albums, public.album_items to service_role;
+
+-- Storage objects need their own grants: RLS filters rows, it does not grant
+-- the privilege to reach the table at all.
+grant select, insert, update, delete on storage.objects to authenticated;
+grant all on storage.objects to service_role;
+
+
+-- ---------------------------------------------------------------------------
+-- 7. Maintenance
+-- ---------------------------------------------------------------------------
+-- Deletes expired albums and their item rows, and RETURNS the storage paths so
+-- the caller (a scheduled Edge Function using the service role, or the owner's
+-- own client) can remove the objects through the Storage API. Postgres cannot
+-- unlink a bucket object by itself; pretending otherwise would leave the bytes
+-- in place.
+create or replace function public.purge_expired_albums(p_grace interval default interval '0 seconds')
+returns table (storage_path text)
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+begin
+  return query
+  with expired as (
+    select id from public.albums
+    where expires_at is not null
+      and expires_at < now() - p_grace
+  ),
+  doomed_items as (
+    select i.storage_path
+    from public.album_items i
+    join expired e on e.id = i.album_id
+  )
+  select d.storage_path from doomed_items d
+  union all
+  -- An item whose album row is already gone is an orphan; report it too.
+  select i.storage_path
+  from public.album_items i
+  where not exists (select 1 from public.albums a where a.id = i.album_id);
+
+  delete from public.album_items
+  where album_id in (
+    select id from public.albums where expires_at is not null and expires_at < now() - p_grace
+  );
+
+  delete from public.albums
+  where expires_at is not null
+    and expires_at < now() - p_grace;
+end;
+$$;
+
+revoke all on function public.purge_expired_albums(interval) from public;
+
+do $$
+begin
+  if exists (select 1 from pg_extension where extname = 'pg_cron') then
+    begin
+      perform cron.unschedule('gayze-purge-expired-albums');
+    exception when others then
+      null;
+    end;
+    perform cron.schedule(
+      'gayze-purge-expired-albums',
+      '*/15 * * * *',
+      $cron$select public.purge_expired_albums();$cron$
+    );
+    raise notice 'GAYZE: scheduled purge_expired_albums every 15 minutes. Configure the album-media cleanup worker (supabase/functions) to delete the returned objects.';
+  else
+    raise notice 'GAYZE: pg_cron is not enabled. Schedule public.purge_expired_albums() externally and delete the returned storage paths with the service role.';
+  end if;
+end;
+$$;
+
+-- The cleanup routine runs server-side. Without this grant the scheduled
+-- lifecycle worker cannot purge anything. It is granted here, AFTER the
+-- definition above: granting a function that does not yet exist is an error,
+-- which is exactly the kind of ordering mistake that only surfaces when the
+-- migration is actually executed.
+grant execute on function public.purge_expired_albums(interval) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- 8. Rollback notes
+-- ---------------------------------------------------------------------------
+--   drop function public.purge_expired_albums(interval);
+--   drop function public.gayze_can_view_album_object(text, text);
+--   drop function public.gayze_can_view_album(text);
+--   drop policy ... on storage.objects;  -- the three album_media_* policies
+--   drop table public.album_items;
+--   drop table public.albums;
+-- The bucket itself is left in place; remove it manually once empty, otherwise
+-- its objects are orphaned.
diff --git a/supabase/migrations/20260928160000_push_subscriptions.sql b/supabase/migrations/20260928160000_push_subscriptions.sql
new file mode 100644
index 0000000..d18bcf9
--- /dev/null
+++ b/supabase/migrations/20260928160000_push_subscriptions.sql
@@ -0,0 +1,228 @@
+-- ============================================================================
+-- GAYZE — Web Push subscriptions
+-- ============================================================================
+-- What Web Push can and cannot do here — stated before the schema, because the
+-- limits shape the design:
+--
+--   Chrome / Edge / Firefox (desktop + Android)
+--     Full support. Push arrives with the tab closed.
+--
+--   Safari on macOS 13+ and iOS/iPadOS 16.4+
+--     Supported, but ONLY when the site has been added to the Home Screen and
+--     is launched from there. In a plain Safari tab the Push API is not
+--     exposed at all. iOS also enforces that the user gesture must trigger the
+--     permission prompt, and that the push handler shows a notification.
+--
+--   iOS < 16.4
+--     Not supported. The client detects this and keeps using in-app
+--     notifications; it never claims push is active.
+--
+-- So push here is an enhancement layered on top of the in-app notification
+-- path, never a replacement for it. If push is unavailable, denied, or the
+-- platform is unsupported, the app still notifies correctly while it is open.
+--
+-- Delivery requires a sender holding the VAPID *private* key. That key is a
+-- server secret and lives in a Supabase Edge Function secret
+-- (supabase/functions/send-push). It is never placed in client code or in this
+-- repository.
+--
+-- Safe to run more than once.
+-- ============================================================================
+
+create table if not exists public.push_subscriptions (
+  id uuid primary key default gen_random_uuid(),
+  user_id uuid not null references public.profiles (id) on delete cascade,
+  -- The push service URL for this browser install. Unique across all users so a
+  -- shared device cannot be double-registered.
+  endpoint text not null,
+  p256dh text not null,
+  auth text not null,
+  user_agent text,
+  created_at timestamptz not null default now(),
+  last_seen_at timestamptz not null default now(),
+  -- Set when the push service reports the subscription is gone (404/410). The
+  -- sender skips disabled rows; the client re-subscribes on next launch.
+  disabled_at timestamptz,
+  failure_count integer not null default 0,
+  constraint push_subscriptions_endpoint_key unique (endpoint)
+);
+
+comment on table public.push_subscriptions is
+  'One row per browser/installation that agreed to push. The VAPID private key is NOT here — it is a server secret held by the send-push Edge Function.';
+
+create index if not exists push_subscriptions_user_idx
+  on public.push_subscriptions (user_id)
+  where disabled_at is null;
+
+alter table public.push_subscriptions enable row level security;
+
+-- A member can only ever see and manage their own subscriptions. The sender
+-- runs with the service role and bypasses RLS by design.
+drop policy if exists push_subscriptions_select_own on public.push_subscriptions;
+create policy push_subscriptions_select_own
+  on public.push_subscriptions
+  for select
+  to authenticated
+  using (user_id = auth.uid());
+
+drop policy if exists push_subscriptions_insert_own on public.push_subscriptions;
+create policy push_subscriptions_insert_own
+  on public.push_subscriptions
+  for insert
+  to authenticated
+  with check (user_id = auth.uid());
+
+-- An upsert on endpoint can legitimately move a subscription between users on a
+-- shared device, but only the current owner may perform the move.
+drop policy if exists push_subscriptions_update_own on public.push_subscriptions;
+create policy push_subscriptions_update_own
+  on public.push_subscriptions
+  for update
+  to authenticated
+  using (user_id = auth.uid())
+  with check (user_id = auth.uid());
+
+drop policy if exists push_subscriptions_delete_own on public.push_subscriptions;
+create policy push_subscriptions_delete_own
+  on public.push_subscriptions
+  for delete
+  to authenticated
+  using (user_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- RPCs
+-- ---------------------------------------------------------------------------
+
+-- Register (or refresh) this installation.
+--
+-- SECURITY DEFINER, and the reason is a privacy bug rather than convenience.
+--
+-- A browser's push endpoint is a property of the browser profile, not of the
+-- signed-in account. When one person signs out and another signs in on the same
+-- device, the endpoint is the SAME. Under a plain RLS-enforced upsert the
+-- second person cannot take ownership of the row — the update policy requires
+-- the existing row to already belong to them — so the endpoint stays bound to
+-- the first account. Push is addressed per user through this table, which means
+-- the first person's messages would keep arriving on the second person's device
+-- indefinitely.
+--
+-- So the endpoint is claimed exclusively: any existing row for it is removed,
+-- and a fresh row is written for the caller. A person can only ever claim an
+-- endpoint for themselves (v_user_id comes from auth.uid(), and there is no
+-- parameter for a user id), so this cannot be used to subscribe someone else.
+create or replace function public.register_push_subscription(
+  p_endpoint text,
+  p_p256dh text,
+  p_auth text,
+  p_user_agent text default null
+)
+returns boolean
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null or p_endpoint is null or length(p_endpoint) = 0 then
+    return false;
+  end if;
+
+  -- Release the endpoint from any other account. This is the line that stops
+  -- one person's notifications reaching another person's device.
+  delete from public.push_subscriptions
+  where endpoint = p_endpoint and user_id <> v_user_id;
+
+  insert into public.push_subscriptions (user_id, endpoint, p256dh, auth, user_agent, last_seen_at, disabled_at, failure_count)
+  values (v_user_id, p_endpoint, p_p256dh, p_auth, coalesce(p_user_agent, ''), now(), null, 0)
+  on conflict (endpoint) do update
+    set user_id = v_user_id,
+        p256dh = excluded.p256dh,
+        auth = excluded.auth,
+        user_agent = coalesce(excluded.user_agent, public.push_subscriptions.user_agent),
+        last_seen_at = now(),
+        disabled_at = null,
+        failure_count = 0;
+
+  return true;
+end;
+$$;
+
+revoke all on function public.register_push_subscription(text, text, text, text) from public;
+grant execute on function public.register_push_subscription(text, text, text, text) to authenticated, service_role;
+
+-- Called by the sender when a push service reports the subscription is dead.
+-- SECURITY DEFINER because the sender runs server-side; it accepts only an
+-- endpoint and never returns subscription data.
+create or replace function public.disable_push_subscription(p_endpoint text, p_increment_failure boolean default false)
+returns boolean
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_updated integer;
+begin
+  update public.push_subscriptions
+  set disabled_at = case when p_increment_failure then disabled_at else now() end,
+      failure_count = failure_count + 1
+  where endpoint = p_endpoint;
+
+  get diagnostics v_updated = row_count;
+  return v_updated > 0;
+end;
+$$;
+
+revoke all on function public.disable_push_subscription(text, boolean) from public;
+
+-- ---------------------------------------------------------------------------
+-- Grants
+-- ---------------------------------------------------------------------------
+grant select, insert, update, delete on public.push_subscriptions to authenticated;
+grant all on public.push_subscriptions to service_role;
+
+-- The sender is an Edge Function running as service_role. It is NOT a
+-- superuser, so `revoke all ... from public` on its two helpers would have left
+-- it unable to resolve recipients or retire a dead endpoint — meaning push
+-- would silently never be delivered. These grants are what make the sender
+-- work at all.
+grant execute on function public.disable_push_subscription(text, boolean) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- Which members may be notified about which conversation
+-- ---------------------------------------------------------------------------
+-- The sender needs the recipients of a message without being able to read the
+-- message itself. This returns only identity and delivery fields — never
+-- ciphertext, never a nonce, never a key.
+create or replace function public.push_targets_for_message(p_message_id uuid)
+returns table (user_id uuid, endpoint text, p256dh text, auth text)
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select ps.user_id, ps.endpoint, ps.p256dh, ps.auth
+  from public.messages m
+  join public.conversation_members cm
+    on cm.conversation_id = m.conversation_id
+  join public.push_subscriptions ps
+    on ps.user_id = cm.user_id
+  where m.id = p_message_id
+    and cm.user_id <> m.sender_id            -- never notify the sender
+    and ps.disabled_at is null
+    and (m.expires_at is null or m.expires_at > now());
+$$;
+
+revoke all on function public.push_targets_for_message(uuid) from public;
+
+-- Granted after its definition: the resolver is created further up this file,
+-- and a grant cannot precede the function it names.
+grant execute on function public.push_targets_for_message(uuid) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- Rollback notes
+-- ---------------------------------------------------------------------------
+--   drop function public.push_targets_for_message(uuid);
+--   drop function public.disable_push_subscription(text, boolean);
+--   drop function public.register_push_subscription(text, text, text, text);
+--   drop table public.push_subscriptions;
diff --git a/supabase/migrations/20260928170000_immutable_lifetime.sql b/supabase/migrations/20260928170000_immutable_lifetime.sql
new file mode 100644
index 0000000..d0180f3
--- /dev/null
+++ b/supabase/migrations/20260928170000_immutable_lifetime.sql
@@ -0,0 +1,364 @@
+-- ===========================================================================
+-- 20260928170000 — IMMUTABLE LIFETIME
+-- ===========================================================================
+--
+-- An expiry that the client can rewrite is not an expiry.
+--
+-- Row-level security constrains WHICH ROWS a statement may touch. It cannot
+-- constrain WHAT those rows become, because a policy expression sees only the
+-- new row — it has no access to the old one, so it cannot say "this column must
+-- not change".
+--
+-- The consequence, confirmed by probe before this migration was written:
+--
+--   * a sender could set `expires_at = null` on their own disappearing message
+--     and un-disappear it, or push it ten years into the future;
+--   * the only UPDATE policy on `messages` was
+--     USING (sender_id = auth.uid()) WITH CHECK (sender_id = auth.uid()),
+--     which constrains the author but never the content.
+--
+-- The disappearing-messages guarantee is made to the RECIPIENT. A sender who
+-- can revoke it after the fact — after the other person has read "disappears in
+-- 10 seconds" and relied on it — makes the promise worthless. The same argument
+-- applies to a timed album: once an owner has shared a one-hour album, the
+-- recipients' expectation is part of the deal.
+--
+-- Probe also confirmed what was already safe, and this migration keeps it that
+-- way rather than relying on it:
+--
+--   * moving a message into a conversation the sender is not in: refused;
+--   * reassigning authorship: refused;
+--   * a recipient updating the sender's message: refused;
+--   * deleting another user's message: refused.
+--
+-- Those four refusals come from the policies. This file does not weaken them.
+--
+-- ---------------------------------------------------------------------------
+-- Why a trigger rather than column privileges
+-- ---------------------------------------------------------------------------
+-- PostgreSQL supports `revoke update (expires_at) on public.messages from
+-- authenticated`, but a table-level UPDATE grant defeats it: the documentation
+-- is explicit that a table-level privilege covers every column and a
+-- column-level revoke cannot narrow it. Supabase grants broadly by default, as
+-- does the base schema this repository builds on, so column privileges would be
+-- decorative here.
+--
+-- A BEFORE UPDATE trigger is the mechanism that actually holds, because it can
+-- compare NEW against OLD.
+--
+-- ---------------------------------------------------------------------------
+-- Scope: client roles only
+-- ---------------------------------------------------------------------------
+-- The guard applies only when a JWT is present (`auth.uid()` is not null).
+-- Maintenance — the scheduled sweeps, migrations, and an operator fixing data
+-- by hand — runs without one and is deliberately unaffected. A guard that also
+-- blocked service_role would make an expired row impossible to repair.
+--
+-- SECURITY INVOKER on purpose: the function reads nothing but the new and old
+-- rows of the row it is called for, so it needs no elevated privilege, and not
+-- needing a grant means there is no grant to get wrong.
+-- ---------------------------------------------------------------------------
+
+
+-- ===========================================================================
+-- 1. MESSAGES
+-- ===========================================================================
+create or replace function public.messages_guard_lifetime()
+returns trigger
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+begin
+  -- No JWT: maintenance. cleanup, migrations and the operator are not
+  -- constrained by a rule that exists to constrain clients.
+  if auth.uid() is null then
+    return new;
+  end if;
+
+  -- The lifetime itself. This is the whole point of the file.
+  if new.expires_at is distinct from old.expires_at then
+    raise exception
+      'messages.expires_at is immutable: a disappearing message cannot be made permanent or extended after it was sent'
+      using errcode = '42501';
+  end if;
+
+  -- Identity and provenance. These were already enforced by the policies; the
+  -- trigger states them once more so the rule survives any future policy edit
+  -- rather than depending on a WITH CHECK that a later migration might loosen.
+  if new.id is distinct from old.id then
+    raise exception 'messages.id is immutable' using errcode = '42501';
+  end if;
+  if new.conversation_id is distinct from old.conversation_id then
+    raise exception 'a message cannot be moved to another conversation' using errcode = '42501';
+  end if;
+  if new.sender_id is distinct from old.sender_id then
+    raise exception 'a message cannot be reassigned to another author' using errcode = '42501';
+  end if;
+  if new.created_at is distinct from old.created_at then
+    raise exception 'messages.created_at is immutable' using errcode = '42501';
+  end if;
+
+  -- The body. Editing a sent message is not a feature of this application, and
+  -- allowing it would break the link between what the recipient read and what
+  -- the row now says.
+  if new.ciphertext is distinct from old.ciphertext then
+    raise exception 'a sent message cannot be edited' using errcode = '42501';
+  end if;
+  if new.nonce is distinct from old.nonce then
+    raise exception 'a sent message''s nonce cannot be changed' using errcode = '42501';
+  end if;
+
+  -- Burning is one-way. The sender may burn their own message, which sets
+  -- burned_at; clearing it again would resurrect content the other person has
+  -- already been told is gone.
+  if old.burned_at is not null and new.burned_at is distinct from old.burned_at then
+    raise exception 'a burned message stays burned' using errcode = '42501';
+  end if;
+
+  return new;
+end;
+$$;
+
+comment on function public.messages_guard_lifetime() is
+  'Refuses client-side changes to a message''s lifetime, identity or body. Burning (burned_at null -> set) is the only permitted edit.';
+
+drop trigger if exists messages_guard_lifetime_trigger on public.messages;
+create trigger messages_guard_lifetime_trigger
+  before update on public.messages
+  for each row
+  execute function public.messages_guard_lifetime();
+
+
+-- ===========================================================================
+-- 1b. Burning a message — why it needs a function
+-- ===========================================================================
+-- Setting `burned_at` on your own message is refused outright, with or without
+-- RETURNING, and this is subtle enough to be worth writing down.
+--
+-- `messages_not_expired_read` is a RESTRICTIVE SELECT policy whose predicate is
+-- `burned_at is null and (expires_at is null or expires_at > now())`. That is
+-- correct: a burned message must not be readable, by anyone, including its
+-- sender. But PostgreSQL validates the NEW row of an UPDATE against the SELECT
+-- policies as well — not only against the UPDATE policy's WITH CHECK. So the
+-- moment `burned_at` is set, the new row fails the SELECT policy, the UPDATE is
+-- rejected, and burning is impossible.
+--
+-- This is the same shape as the defect that made album creation impossible: a
+-- policy that correctly hides a row also prevents that row from being written.
+-- Confirmed by probe — `update ... set burned_at = now()` is refused with
+-- "new row violates row-level security policy", both with and without
+-- RETURNING, and the row is left untouched.
+--
+-- The fix is a SECURITY DEFINER function. The migration runner owns the table,
+-- and neither `messages` nor any other table in this schema sets FORCE ROW
+-- LEVEL SECURITY, so inside this function RLS does not apply and the row can be
+-- marked.
+--
+-- That privilege has to be paid for, and it is paid for here rather than
+-- assumed: because RLS is bypassed inside, the function re-implements the
+-- authorization check itself, in two parts.
+--   1. A caller with no JWT is refused — this is a client operation, and
+--      letting maintenance through would give it a second path to the same
+--      result with no audit.
+--   2. The row's sender must be the caller. A row that is not theirs returns
+--      false, exactly as a row that does not exist does, so the function cannot
+--      be used to probe for the existence of other people's messages by id.
+create or replace function public.burn_message(p_message_id uuid)
+returns boolean
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_sender uuid;
+begin
+  if auth.uid() is null then
+    raise exception 'burn_message requires an authenticated caller' using errcode = '42501';
+  end if;
+
+  select m.sender_id into v_sender
+  from public.messages m
+  where m.id = p_message_id;
+
+  -- Not found, and not yours, are the same answer on purpose: distinguishing
+  -- them would turn this into an oracle for whether a given message id exists.
+  if v_sender is null or v_sender <> auth.uid() then
+    return false;
+  end if;
+
+  -- Idempotent: burning an already-burned message is a no-op that reports
+  -- success, because the desired state is already true.
+  update public.messages
+  set burned_at = now()
+  where id = p_message_id
+    and burned_at is null;
+
+  return true;
+end;
+$$;
+
+comment on function public.burn_message(uuid) is
+  'Marks the caller''s own message as burned. Returns false for a message that does not exist or is not theirs, without distinguishing the two.';
+
+revoke all on function public.burn_message(uuid) from public;
+-- Granted to `authenticated` because it IS a client operation, and to
+-- `service_role` for completeness of the server path.
+grant execute on function public.burn_message(uuid) to authenticated, service_role;
+
+
+-- ===========================================================================
+-- 2. ALBUMS
+-- ===========================================================================
+create or replace function public.albums_guard_lifetime()
+returns trigger
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+begin
+  if auth.uid() is null then
+    return new;
+  end if;
+
+  -- A timed album's lifetime is part of what was promised to the people it was
+  -- shared with. Extending it after they agreed to view something that would
+  -- disappear changes the terms retroactively.
+  if new.expires_at is distinct from old.expires_at then
+    raise exception
+      'albums.expires_at is immutable: a timed album cannot be made permanent or extended after it was shared'
+      using errcode = '42501';
+  end if;
+
+  if new.id is distinct from old.id then
+    raise exception 'albums.id is immutable' using errcode = '42501';
+  end if;
+  if new.owner_id is distinct from old.owner_id then
+    raise exception 'an album cannot be reassigned to another owner' using errcode = '42501';
+  end if;
+  if new.created_at is distinct from old.created_at then
+    raise exception 'albums.created_at is immutable' using errcode = '42501';
+  end if;
+
+  -- Moving an album between conversations would silently change who can see it,
+  -- because visibility is resolved through conversation_id. Narrowing it is the
+  -- owner's business; doing it by editing the membership key is not, because a
+  -- viewer who is mid-album would be reading rows the policy no longer grants.
+  if new.conversation_id is distinct from old.conversation_id then
+    raise exception 'an album cannot be moved to another conversation' using errcode = '42501';
+  end if;
+
+  -- `title`, `visibility` and `updated_at` remain editable: renaming an album,
+  -- or narrowing it from conversation to private, takes nothing back from
+  -- anyone who already has access, and does not extend its life.
+  return new;
+end;
+$$;
+
+comment on function public.albums_guard_lifetime() is
+  'Refuses client-side changes to an album''s lifetime, owner, conversation or creation time. Title and visibility stay editable.';
+
+drop trigger if exists albums_guard_lifetime_trigger on public.albums;
+create trigger albums_guard_lifetime_trigger
+  before update on public.albums
+  for each row
+  execute function public.albums_guard_lifetime();
+
+
+-- ===========================================================================
+-- 3. Album items
+-- ===========================================================================
+-- An item belongs to its album, and its storage path is what the Storage policy
+-- re-derives ownership from. Letting a client repoint an existing row at another
+-- path would move the object the album references without going through upload,
+-- so the path and the parent are frozen alongside the album.
+create or replace function public.album_items_guard_identity()
+returns trigger
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+begin
+  if auth.uid() is null then
+    return new;
+  end if;
+
+  if new.album_id is distinct from old.album_id then
+    raise exception 'an album item cannot be moved to another album' using errcode = '42501';
+  end if;
+  if new.owner_id is distinct from old.owner_id then
+    raise exception 'an album item cannot be reassigned to another owner' using errcode = '42501';
+  end if;
+  if new.storage_path is distinct from old.storage_path then
+    raise exception 'an album item cannot be repointed at another object' using errcode = '42501';
+  end if;
+  if new.created_at is distinct from old.created_at then
+    raise exception 'album_items.created_at is immutable' using errcode = '42501';
+  end if;
+
+  -- `sort_order` and `media_type` stay editable: reordering a gallery is a real
+  -- feature and changes nothing about who may see what.
+  return new;
+end;
+$$;
+
+comment on function public.album_items_guard_identity() is
+  'Refuses client-side changes to an album item''s parent, owner, storage path or creation time. sort_order stays editable.';
+
+drop trigger if exists album_items_guard_identity_trigger on public.album_items;
+create trigger album_items_guard_identity_trigger
+  before update on public.album_items
+  for each row
+  execute function public.album_items_guard_identity();
+
+
+-- ===========================================================================
+-- Verification
+-- ===========================================================================
+-- Reports the guards are installed and enabled. Silent on a healthy apply.
+do $$
+declare
+  v_expected text[] := array[
+    'messages_guard_lifetime_trigger',
+    'albums_guard_lifetime_trigger',
+    'album_items_guard_identity_trigger'
+  ];
+  v_found text[];
+  v_missing text[];
+begin
+  select coalesce(array_agg(t.tgname), '{}') into v_found
+  from pg_trigger t
+  join pg_class c on c.oid = t.tgrelid
+  join pg_namespace n on n.oid = c.relnamespace
+  where n.nspname = 'public' and not t.tgisinternal and t.tgname = any (v_expected);
+
+  select coalesce(array_agg(e), '{}') into v_missing
+  from unnest(v_expected) as e
+  where not (e = any (v_found));
+
+  if array_length(v_missing, 1) > 0 then
+    raise exception 'GAYZE lifetime guards missing after migration: %', array_to_string(v_missing, ', ');
+  end if;
+
+  raise notice 'GAYZE lifetime guards installed: % trigger(s). expires_at is now immutable for client roles.', array_length(v_found, 1);
+end;
+$$;
+
+
+-- ===========================================================================
+-- Rollback
+-- ===========================================================================
+-- This migration only adds triggers and functions; it changes no data and no
+-- policy. To reverse it:
+--
+--   drop trigger if exists messages_guard_lifetime_trigger on public.messages;
+--   drop trigger if exists albums_guard_lifetime_trigger on public.albums;
+--   drop trigger if exists album_items_guard_identity_trigger on public.album_items;
+--   drop function if exists public.burn_message(uuid);
+--   drop function if exists public.messages_guard_lifetime();
+--   drop function if exists public.albums_guard_lifetime();
+--   drop function if exists public.album_items_guard_identity();
+--
+-- Rolling back re-opens the ability for a sender to un-disappear their own
+-- messages and for an owner to extend a shared album. That is a product
+-- decision, not a neutral one.

+/**
+ * GAYZE — timed albums.
+ *
+ * A timed album is shared media with a stated lifetime. The lifetime is stored
+ * on the album row and enforced by the database, not by a JavaScript timer:
+ *
+ *   * reads  — a restrictive RLS predicate hides an expired album row, so the
+ *              API stops returning it;
+ *   * signing — the Storage read policy calls the same access function, so a
+ *              signed URL cannot be minted for an expired album's object;
+ *   * purge   — `purge_expired_albums()` removes the rows and reports the
+ *              storage paths that still need deleting.
+ *
+ * The client's countdown is a display detail only. If it is wrong, or the tab
+ * is closed for a week, nothing expired becomes readable again.
+ *
+ * Encryption, stated plainly:
+ *   * Conversation albums are encrypted with the existing per-conversation
+ *     AES-GCM key before upload, so the backend holds ciphertext for them.
+ *   * Private albums are protected by the private bucket, RLS and short-lived
+ *     signed URLs. They are not end-to-end encrypted, because a personal album
+ *     has no conversation key to encrypt against. The UI says so rather than
+ *     implying otherwise.
+ */
+
+import { supabase } from './supabaseClient';
+import { acquireChannel } from './realtimeManager';
+import { resolveConversationKey } from './conversationKeyService';
+import { encryptWithConversationKey } from './cryptoService';
+import type { SwarmRoom } from '../types';
+
+export const ALBUM_BUCKET = 'album-media';
+export const ALBUM_MAX_BYTES = 10 * 1024 * 1024;
+export const ALBUM_ACCEPTED_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/webm'] as const;
+/** Signed URLs for album media are deliberately short-lived. */
+export const ALBUM_SIGNED_URL_TTL_SECONDS = 300;
+
+export type AlbumVisibility = 'private' | 'conversation';
+
+export interface AlbumDurationOption {
+  id: string;
+  label: string;
+  seconds: number | null;
+}
+
+/**
+ * The offered lifetimes. `custom` exists because the brief asks for it, and
+ * because a fixed menu always ends up wrong for someone.
+ */
+export const ALBUM_DURATIONS: AlbumDurationOption[] = [
+  { id: '1h', label: '1 hour', seconds: 3600 },
+  { id: '6h', label: '6 hours', seconds: 6 * 3600 },
+  { id: '24h', label: '24 hours', seconds: 24 * 3600 },
+  { id: '7d', label: '7 days', seconds: 7 * 24 * 3600 },
+  { id: 'custom', label: 'Custom', seconds: null },
+];
+
+export interface AlbumRow {
+  id: string;
+  owner_id: string;
+  conversation_id: string | null;
+  title: string | null;
+  visibility: AlbumVisibility;
+  created_at: string;
+  updated_at: string;
+  expires_at: string | null;
+}
+
+export interface AlbumItemRow {
+  id: string;
+  album_id: string;
+  owner_id: string;
+  storage_path: string;
+  media_type: 'image' | 'video';
+  encryption_nonce: string | null;
+  sort_order: number;
+  created_at: string;
+}
+
+export interface AlbumWithItems extends AlbumRow {
+  items: AlbumItemRow[];
+}
+
+/* ------------------------------------------------------------------ */
+/* Expiry helpers                                                      */
+/* ------------------------------------------------------------------ */
+
+export function isAlbumExpired(album: Pick<AlbumRow, 'expires_at'>, now = Date.now()): boolean {
+  if (!album.expires_at) return false;
+  return new Date(album.expires_at).getTime() <= now;
+}
+
+/**
+ * Remaining lifetime in ms, or null when the album does not expire. Never
+ * negative: callers use `isAlbumExpired` to decide visibility.
+ */
+export function albumRemainingMs(album: Pick<AlbumRow, 'expires_at'>, now = Date.now()): number | null {
+  if (!album.expires_at) return null;
+  return Math.max(0, new Date(album.expires_at).getTime() - now);
+}
+
+export function formatAlbumRemaining(album: Pick<AlbumRow, 'expires_at'>, now = Date.now()): string {
+  const remaining = albumRemainingMs(album, now);
+  if (remaining === null) return 'Kept until you delete it';
+  if (remaining <= 0) return 'Expired';
+
+  const seconds = Math.floor(remaining / 1000);
+  if (seconds < 60) return `${seconds}s left`;
+  const minutes = Math.floor(seconds / 60);
+  if (minutes < 60) return `${minutes}m left`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return `${hours}h ${minutes % 60}m left`;
+  const days = Math.floor(hours / 24);
+  return `${days}d ${hours % 24}h left`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Reads                                                               */
+/* ------------------------------------------------------------------ */
+
+export async function loadVisibleAlbums(): Promise<AlbumWithItems[]> {
+  if (!supabase) return [];
+
+  const { data: albums, error } = await supabase
+    .from('albums')
+    .select('*')
+    .order('created_at', { ascending: false })
+    .limit(60);
+
+  if (error) {
+    console.warn('[GAYZE Albums] Could not load albums:', error.message);
+    return [];
+  }
+
+  const now = Date.now();
+  // Belt and braces: RLS already withholds expired rows, and this makes the
+  // behaviour identical on a backend where the migration is not yet applied.
+  const rows = ((albums ?? []) as AlbumRow[]).filter((album) => !isAlbumExpired(album, now));
+  if (rows.length === 0) return [];
+
+  const { data: items, error: itemError } = await supabase
+    .from('album_items')
+    .select('*')
+    .in('album_id', rows.map((album) => album.id))
+    .order('sort_order', { ascending: true });
+
+  if (itemError) {
+    console.warn('[GAYZE Albums] Could not load album items:', itemError.message);
+  }
+
+  const byAlbum = new Map<string, AlbumItemRow[]>();
+  ((items ?? []) as AlbumItemRow[]).forEach((item) => {
+    const list = byAlbum.get(item.album_id) ?? [];
+    list.push(item);
+    byAlbum.set(item.album_id, list);
+  });
+
+  return rows.map((album) => ({ ...album, items: byAlbum.get(album.id) ?? [] }));
+}
+
+/* ------------------------------------------------------------------ */
+/* Writes                                                              */
+/* ------------------------------------------------------------------ */
+
+export type AlbumMutationResult = { ok: true; albumId?: string; itemId?: string } | { ok: false; error: string };
+
+export async function createAlbum(params: {
+  visibility: AlbumVisibility;
+  conversationId?: string | null;
+  title?: string | null;
+  ttlSeconds: number | null;
+}): Promise<AlbumMutationResult & { album?: AlbumRow }> {
+  if (!supabase) return { ok: false, error: 'Albums need a connection to GAYZE.' };
+
+  const { data: userData } = await supabase.auth.getUser();
+  const userId = userData?.user?.id;
+  if (!userId) return { ok: false, error: 'Sign in to create an album.' };
+
+  const expiresAt = params.ttlSeconds && params.ttlSeconds > 0
+    ? new Date(Date.now() + params.ttlSeconds * 1000).toISOString()
+    : null;
+
+  const { data, error } = await supabase
+    .from('albums')
+    .insert({
+      owner_id: userId,
+      conversation_id: params.visibility === 'conversation' ? params.conversationId ?? null : null,
+      title: params.title ?? null,
+      visibility: params.visibility,
+      expires_at: expiresAt,
+    })
+    .select('*')
+    .single();
+
+  if (error) {
+    console.warn('[GAYZE Albums] Could not create the album:', error.message);
+    return { ok: false, error: humaniseAlbumError(error.message) };
+  }
+
+  const album = data as AlbumRow;
+  return { ok: true, albumId: album.id, album };
+}
+
+export function validateAlbumFile(file: File): { ok: true } | { ok: false; error: string } {
+  if (!ALBUM_ACCEPTED_TYPES.includes(file.type as (typeof ALBUM_ACCEPTED_TYPES)[number])) {
+    return { ok: false, error: 'Only JPEG, PNG, WebP images and MP4 or WebM video can be added.' };
+  }
+  if (file.size > ALBUM_MAX_BYTES) {
+    return { ok: false, error: `Each item must be under ${Math.round(ALBUM_MAX_BYTES / (1024 * 1024))} MB.` };
+  }
+  return { ok: true };
+}
+
+/**
+ * Uploads one item.
+ *
+ * Path shape is `{owner}/{album}/{item}` and is enforced by a CHECK constraint
+ * on `album_items`, so a row can never point outside its owner's folder — which
+ * is what stops one member from referencing (and therefore reading) another
+ * member's object.
+ */
+export async function uploadAlbumItem(params: {
+  album: AlbumRow;
+  file: File;
+  room?: SwarmRoom | null;
+  userId?: string | null;
+  encrypt?: boolean;
+}): Promise<AlbumMutationResult & { signedUrl?: string | null }> {
+  if (!supabase) return { ok: false, error: 'Albums need a connection to GAYZE.' };
+
+  const validation = validateAlbumFile(params.file);
+  if (!validation.ok) return { ok: false, error: validation.error };
+
+  if (isAlbumExpired(params.album)) {
+    return { ok: false, error: 'This album has expired, so nothing more can be added to it.' };
+  }
+
+  const { data: userData } = await supabase.auth.getUser();
+  const userId = params.userId ?? userData?.user?.id;
+  if (!userId) return { ok: false, error: 'Sign in to add media.' };
+
+  // The owner folder must match the authenticated user; the storage policy
+  // checks the same thing server-side.
+  const itemId = crypto.randomUUID();
+  const extension = (params.file.name.split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g, '') || 'jpg';
+  const storagePath = `${userId}/${params.album.id}/${itemId}.${extension}`;
+
+  let body: Blob = params.file;
+  let nonce: string | null = null;
+
+  // Conversation albums are encrypted with the conversation key, so the bytes
+  // in the bucket are ciphertext.
+  const shouldEncrypt = params.encrypt ?? params.album.visibility === 'conversation';
+  if (shouldEncrypt && params.album.visibility === 'conversation' && params.room) {
+    try {
+      const resolved = await resolveConversationKey(params.room, userId);
+      if (resolved.key) {
+        const buffer = new Uint8Array(await params.file.arrayBuffer());
+        let binary = '';
+        for (let i = 0; i < buffer.length; i += 1) binary += String.fromCharCode(buffer[i]);
+        const encrypted = await encryptWithConversationKey(btoa(binary), resolved.key);
+        nonce = encrypted.nonceHex;
+        const bytes = new Uint8Array(encrypted.cipherHex.length / 2);
+        for (let i = 0; i < bytes.length; i += 1) {
+          bytes[i] = parseInt(encrypted.cipherHex.substr(i * 2, 2), 16);
+        }
+        body = new Blob([bytes], { type: 'application/octet-stream' });
+      }
+    } catch (error: any) {
+      return { ok: false, error: error?.message || 'This album could not be encrypted, so it was not uploaded.' };
+    }
+  }
+
+  const { error: uploadError } = await supabase.storage
+    .from(ALBUM_BUCKET)
+    .upload(storagePath, body, { cacheControl: '3600', upsert: false, contentType: shouldEncrypt ? 'application/octet-stream' : params.file.type });
+
+  if (uploadError) {
+    console.warn('[GAYZE Albums] Upload failed:', uploadError.message);
+    return { ok: false, error: humaniseAlbumError(uploadError.message) };
+  }
+
+  const { data, error } = await supabase
+    .from('album_items')
+    .insert({
+      id: itemId,
+      album_id: params.album.id,
+      owner_id: userId,
+      storage_path: storagePath,
+      media_type: params.file.type.startsWith('video') ? 'video' : 'image',
+      encryption_nonce: nonce,
+      sort_order: 0,
+    })
+    .select('id')
+    .single();
+
+  if (error) {
+    // The row is the source of truth; without it the object is unreachable, so
+    // remove the orphan rather than leave bytes nobody can account for.
+    await supabase.storage.from(ALBUM_BUCKET).remove([storagePath]);
+    console.warn('[GAYZE Albums] Could not record the item:', error.message);
+    return { ok: false, error: humaniseAlbumError(error.message) };
+  }
+
+  return { ok: true, itemId: (data as { id: string }).id };
+}
+
+export async function deleteAlbumItem(item: AlbumItemRow): Promise<AlbumMutationResult> {
+  if (!supabase) return { ok: false, error: 'Not connected.' };
+
+  const { error } = await supabase.from('album_items').delete().eq('id', item.id);
+  if (error) return { ok: false, error: humaniseAlbumError(error.message) };
+
+  // Storage first would leave a row pointing at nothing; the row is gone, so
+  // removing the object now is safe, and a failure here is recoverable by the
+  // purge sweep.
+  const { error: storageError } = await supabase.storage.from(ALBUM_BUCKET).remove([item.storage_path]);
+  if (storageError) {
+    console.warn('[GAYZE Albums] Item removed, but the stored file could not be deleted:', storageError.message);
+  }
+
+  return { ok: true };
+}
+
+export async function deleteAlbum(album: AlbumWithItems): Promise<AlbumMutationResult> {
+  if (!supabase) return { ok: false, error: 'Not connected.' };
+
+  const paths = album.items.map((item) => item.storage_path);
+
+  const { error } = await supabase.from('albums').delete().eq('id', album.id);
+  if (error) return { ok: false, error: humaniseAlbumError(error.message) };
+
+  if (paths.length) {
+    const { error: storageError } = await supabase.storage.from(ALBUM_BUCKET).remove(paths);
+    if (storageError) {
+      console.warn('[GAYZE Albums] Album removed, but files remain in storage:', storageError.message);
+    }
+  }
+
+  return { ok: true };
+}
+
+/* ------------------------------------------------------------------ */
+/* Signed access                                                       */
+/* ------------------------------------------------------------------ */
+
+/**
+ * How long a signature for this item may live, in seconds.
+ *
+ * A signed URL cannot be revoked: once Storage has issued it, the signature is
+ * valid for the whole TTL it was minted with, whatever happens to the album in
+ * the meantime. So a fixed five-minute TTL does NOT mean an expired album is
+ * unreachable — it means a URL minted four minutes before expiry stays usable
+ * for up to four minutes after it. That is a real window, and "the album has
+ * expired" was not true during it.
+ *
+ * The fix is to make the signature's life a subset of the album's: never longer
+ * than the remaining lifetime, so the URL dies no later than the album does.
+ * Five minutes remains the ceiling for albums that have longer to live, which
+ * keeps the window for a leaked URL bounded in the ordinary case.
+ *
+ * Returns 0 when the album has already expired, which callers treat as "do not
+ * sign at all".
+ */
+export function albumSignedUrlTtlSeconds(
+  expiresAt: string | null | undefined,
+  now = Date.now(),
+): number {
+  if (!expiresAt) return ALBUM_SIGNED_URL_TTL_SECONDS;
+  const remaining = Math.floor((new Date(expiresAt).getTime() - now) / 1000);
+  if (remaining <= 0) return 0;
+  return Math.min(ALBUM_SIGNED_URL_TTL_SECONDS, remaining);
+}
+
+/**
+ * Short-lived signed URL for one item.
+ *
+ * The URL is deliberately given no more time than the album has left, so an
+ * expired album's previously-issued URLs are dead too. Storage re-checks the
+ * access policy at signing time, which is what stops a NEW signature being
+ * produced after expiry; capping the TTL is what stops the OLD one outliving it.
+ *
+ * Passing no expiry means the album is intended to persist, and the ordinary
+ * five-minute TTL applies.
+ */
+export async function getAlbumItemUrl(
+  item: AlbumItemRow,
+  albumExpiresAt?: string | null,
+): Promise<string | null> {
+  if (!supabase) return null;
+
+  const ttl = albumSignedUrlTtlSeconds(albumExpiresAt);
+  // Already expired: refuse locally rather than asking Storage for a signature
+  // that would be dead on arrival. The server refuses it too — this only saves
+  // the round trip.
+  if (ttl <= 0) return null;
+
+  try {
+    const { data, error } = await supabase.storage
+      .from(ALBUM_BUCKET)
+      .createSignedUrl(item.storage_path, ttl);
+    if (error || !data?.signedUrl) return null;
+    return data.signedUrl;
+  } catch {
+    return null;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Realtime                                                            */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Watches album and item changes for this user. Used so a new album appears and
+ * an expiring album's removal reaches an open screen without a refresh.
+ *
+ * The channel is ref-counted and self-healing, so mounting this twice is free
+ * and an iOS background cycle re-establishes it.
+ */
+export function subscribeToAlbums(userId: string, onChange: () => void): () => void {
+  if (!supabase) return () => undefined;
+
+  const handle = acquireChannel(`gayze-albums-${userId}`, (channel) =>
+    channel
+      .on('postgres_changes', { event: '*', schema: 'public', table: 'albums' }, onChange)
+      .on('postgres_changes', { event: '*', schema: 'public', table: 'album_items' }, onChange),
+  );
+
+  return () => handle.release();
+}
+
+/* ------------------------------------------------------------------ */
+/* Storage cleanup                                                     */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Removes expired albums the current user owns and deletes their files.
+ *
+ * This is a safety net, not the primary mechanism. Expiry is enforced by the
+ * database the moment `expires_at` passes, whether or not this ever runs. When
+ * it does run — on launch, and on returning to the foreground — it clears the
+ * bytes so an expired album does not sit in the bucket indefinitely, and
+ * reports what it could not remove.
+ */
+export async function purgeMyExpiredAlbums(): Promise<{ albums: number; files: number; failed: number }> {
+  if (!supabase) return { albums: 0, files: 0, failed: 0 };
+
+  const { data: userData } = await supabase.auth.getUser();
+  const userId = userData?.user?.id;
+  if (!userId) return { albums: 0, files: 0, failed: 0 };
+
+  // RLS hides expired rows from the normal read path, so the owner asks for
+  // their own expired albums explicitly.
+  const { data, error } = await supabase
+    .from('albums')
+    .select('id,expires_at')
+    .eq('owner_id', userId)
+    .not('expires_at', 'is', null)
+    .lt('expires_at', new Date(Date.now() - 60_000).toISOString())
+    .limit(25);
+
+  if (error || !data?.length) return { albums: 0, files: 0, failed: 0 };
+
+  const albumIds = (data as Array<{ id: string }>).map((row) => row.id);
+  const { data: items } = await supabase
+    .from('album_items')
+    .select('storage_path')
+    .in('album_id', albumIds);
+
+  const paths = ((items ?? []) as Array<{ storage_path: string }>).map((item) => item.storage_path);
+
+  let failed = 0;
+  if (paths.length) {
+    const { error: storageError } = await supabase.storage.from(ALBUM_BUCKET).remove(paths);
+    if (storageError) failed += paths.length;
+  }
+
+  const { error: deleteError } = await supabase.from('albums').delete().in('id', albumIds);
+  if (deleteError) {
+    console.warn('[GAYZE Albums] Expired albums could not be cleared:', deleteError.message);
+    return { albums: 0, files: paths.length - failed, failed };
+  }
+
+  const { error: itemDeleteError } = await supabase.from('album_items').delete().in('album_id', albumIds);
+  if (itemDeleteError) {
+    console.warn('[GAYZE Albums] Expired album items could not be cleared:', itemDeleteError.message);
+  }
+
+  return { albums: albumIds.length, files: paths.length - failed, failed };
+}
+
+function humaniseAlbumError(message: string): string {
+  if (message.includes('row-level security') || message.includes('permission denied')) {
+    return 'You do not have access to that album.';
+  }
+  if (message.includes('exceeds the maximum allowed size')) {
+    return 'That file is larger than the album limit.';
+  }
+  if (message.includes('mime type')) {
+    return 'That file type cannot be added to an album.';
+  }
+  if (message.includes('album_items_path_shape_check') || message.includes('album_items_path_ownership_check')) {
+    return 'That media path was rejected for security reasons.';
+  }
+  return message;
+}

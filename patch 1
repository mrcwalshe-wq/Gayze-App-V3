+
+  return (
+    <div className="fixed inset-0 z-[120] bg-[#090a0f]/95 backdrop-blur-xl overflow-y-auto px-4 py-8">
+      <div className="mx-auto w-full max-w-lg g-panel !rounded-[26px] p-5 sm:p-7">

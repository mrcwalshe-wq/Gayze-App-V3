+/**
+ * The diagnostics must actually detect the failures they claim to.
+ *
+ * A diagnostic that reports PASS for a broken deployment is worse than none: it
+ * sends the operator looking in the wrong layer. These tests run the real check
+ * functions against a stubbed client in each failure mode, including the one
+ * that matters most — build-time credentials absent, which puts the entire app
+ * into demo mode with no error anywhere.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.stubGlobal('navigator', { userAgent: 'vitest', onLine: true });
+
+const USER = '11111111-1111-4111-8111-111111111111';
+const CONVERSATION = 'aaaaaaaa-1111-4111-8111-111111111111';
+const DEVICE = 'bbbbbbbb-2222-4222-8222-222222222222';
+
+/** A stub that records calls and returns whatever a test tells it to. */
+function makeClient(overrides: Record<string, unknown> = {}) {
+  const client = {
+    auth: {
+      getSession: vi.fn(async () => ({
+        data: { session: { user: { id: USER }, expires_at: Math.floor(Date.now() / 1000) + 3600 } },
+        error: null,
+      })),
+    },
+    from: vi.fn(() => ({
+      select: vi.fn(() => ({
+        eq: vi.fn(() => ({ limit: vi.fn(async () => ({ data: [], error: null })) })),
+        in: vi.fn(async () => ({ data: [], error: null })),
+        order: vi.fn(() => ({ limit: vi.fn(async () => ({ data: [], error: null })) })),

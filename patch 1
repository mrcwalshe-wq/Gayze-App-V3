index 0000000..8ee7a3b
--- /dev/null
+++ b/src/services/realtimeManager.ts
@@ -0,0 +1,309 @@
+/**
+ * GAYZE — Realtime lifecycle manager.
+ *
+ * Problems this exists to solve, all of which were visible in the previous
+ * implementation:
+ *
+ *   * Duplicate subscriptions. `supabase.channel(topic)` called twice with the
+ *     same topic produces two channels competing for one socket, and React
+ *     StrictMode (which mounts effects twice in development) makes this the
+ *     default outcome. Here, channels are ref-counted by topic: the first
+ *     acquire creates, later acquires join, and only the last release closes.
+ *
+ *   * Leaks across navigation. A component that forgets to release leaves a
+ *     listener attached forever. Every handle returned here must be released,
+ *     and the manager logs any channel that outlives its last consumer.
+ *
+ *   * Silent death. A Realtime socket drops on sleep, on a network change, on
+ *     an iOS background/foreground cycle, and on token refresh. Supabase reports
+ *     this as CHANNEL_ERROR / TIMED_OUT / CLOSED but does not always recover a
+ *     `postgres_changes` binding, so a dead channel looks alive while delivering
+ *     nothing. This manager watches the status and re-subscribes with backoff,
+ *     and pauses while the device is offline so it is not reconnecting into a
+ *     black hole.
+ *
+ *   * Unbounded channel counts. Supabase imposes a per-connection channel limit.
+ *     Ref-counting by topic keeps the number of channels proportional to the
+ *     number of distinct concerns, not to the number of components.
+ */
+
+import type { RealtimeChannel, SupabaseClient } from '@supabase/supabase-js';
+import { supabase } from './supabaseClient';
+
+export type RealtimeStatus = 'connecting' | 'subscribed' | 'reconnecting' | 'offline' | 'closed';
+
+type Builder = (channel: RealtimeChannel) => RealtimeChannel;
+
+interface ManagedChannel {
+  topic: string;
+  channel: RealtimeChannel | null;
+  build: Builder;
+  refCount: number;
+  status: RealtimeStatus;
+  attempt: number;
+  retryTimer: number | null;
+  statusListeners: Set<(status: RealtimeStatus) => void>;
+  /** Set while the manager is deliberately tearing the channel down. */
+  closing: boolean;
+}
+
+const channels = new Map<string, ManagedChannel>();
+let globalStatusListeners = new Set<(status: RealtimeStatus, topic: string) => void>();
+let networkOnline = typeof navigator === 'undefined' ? true : navigator.onLine;
+let started = false;
+
+export function getClient(): SupabaseClient | null {
+  return supabase;
+}
+
+/**
+ * Starts the network/visibility watchers. Idempotent, and safe to call before
+ * anything subscribes.
+ */
+export function startRealtimeManager(): void {
+  if (started || typeof window === 'undefined') return;
+  started = true;
+
+  window.addEventListener('online', () => {
+    networkOnline = true;
+    // Everything that was parked while offline should try again immediately.
+    channels.forEach((managed) => {
+      if (managed.status === 'offline') {
+        managed.attempt = 0;
+        connect(managed);
+      }
+    });
+  });
+
+  window.addEventListener('offline', () => {
+    networkOnline = false;
+    channels.forEach((managed) => {
+      setStatus(managed, 'offline');
+      clearRetry(managed);
+    });
+  });
+
+  // iOS suspends timers and sockets while backgrounded. On return, a channel
+  // that "reconnected" during suspension may be bound to a dead socket, so a
+  // deliberate re-subscribe is the only reliable repair. This is the single
+  // most important line in the file for iPhone reliability.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState !== 'visible') return;
+    if (!networkOnline) return;
+    channels.forEach((managed) => {
+      if (managed.status === 'subscribed' || managed.status === 'offline' || managed.status === 'reconnecting') {
+        managed.attempt = 0;
+        reconnectNow(managed);
+      }
+    });
+  });
+}
+
+function clearRetry(managed: ManagedChannel): void {
+  if (managed.retryTimer !== null) {
+    window.clearTimeout(managed.retryTimer);
+    managed.retryTimer = null;
+  }
+}
+
+function setStatus(managed: ManagedChannel, status: RealtimeStatus): void {
+  if (managed.status === status) return;
+  managed.status = status;
+  managed.statusListeners.forEach((listener) => {
+    try {
+      listener(status);
+    } catch (error) {
+      console.warn('[GAYZE Realtime] Status listener threw', error);
+    }
+  });
+  globalStatusListeners.forEach((listener) => {
+    try {
+      listener(status, managed.topic);
+    } catch {
+      /* listener errors must never break the manager */
+    }
+  });
+}
+
+/** Exponential backoff with jitter, capped at 30s. */
+function backoffDelay(attempt: number): number {
+  const base = Math.min(30_000, 800 * 2 ** Math.min(attempt, 5));
+  return base + Math.random() * 400;
+}
+

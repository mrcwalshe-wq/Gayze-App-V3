+/**
+ * Phase 12 — the push delivery path, verified rather than trusted.
+ *
+ * Web Push encryption is hand-rolled in `supabase/functions/_shared/webpush.ts`
+ * because the delivery path should not depend on a package that can change the
+ * day notifications stop arriving. The cost of that decision is that the code
+ * must be proven, and this file is where it is.
+ *
+ * Three independent checks:
+ *
+ *   1. The PKCS#8 wrapper around the VAPID private key is accepted by Web
+ *      Crypto. This is a hard, external verdict — the DER either parses or it
+ *      does not — and it is the fiddliest part of the whole file.
+ *   2. A full RFC 8291 round trip: encrypt with the production code, decrypt
+ *      with a receiver written separately from the specification.
+ *   3. The wire format is exactly what a push service expects: the header
+ *      layout, the sizes, and the record delimiter.
+ *
+ * This is real cryptography exercised against the real implementation, but it
+ * is NOT a substitute for a live push. Only a device can confirm that Apple's
+ * or Google's push service accepts the result. That is listed as a device test.
+ */
+
+import { describe, expect, it } from 'vitest';
+import {
+  PKCS8_PREFIX,
+  buildVapidHeader,
+  classifyPushResponse,
+  decodeBase64Url,
+  encryptPayload,
+  wrapPkcs8,
+} from '../supabase/functions/_shared/webpush';
+
+/** Web Crypto takes only ArrayBuffer-backed views; see the shared module. */
+type Bytes = Uint8Array<ArrayBuffer>;
+
+const b64url = (bytes: Bytes): string => {
+  let binary = '';
+  for (let i = 0; i < bytes.length; i += 1) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};

+/**
+ * Image preparation, shared by the two places that encode an image before it
+ * leaves the device: profile photos, which are uploaded to Storage, and chat
+ * attachments, which are encrypted into a message.
+ *
+ * It lives here rather than in either service because both need the same work
+ * and a second copy would drift. The chat path previously had no preparation at
+ * all: a 5 MB file became a ~6.7 MB base64 string inside the encrypted message
+ * body, which is a reliability problem rather than a tidiness one — see
+ * `optimiseChatAttachment`.
+ */
+
+/**
+ * Size budget for a chat attachment, derived rather than guessed.
+ *
+ * A chat image does not travel as an image. It travels as a data URL inside the
+ * encrypted message body, and every step of that chain expands it:
+ *
+ *   image bytes
+ *     -> base64 data URL        x4/3, plus a 23-character prefix
+ *     -> JSON envelope          + ~30 bytes
+ *     -> AES-GCM ciphertext     + 16-byte tag
+ *     -> HEX string             x2      <- the expensive step
+ *
+ * so what lands in `messages.ciphertext` is roughly 2.67x the image.
+ *
+ * Supabase's Postgres Changes payload limit is 1,024 KB on EVERY plan, and when
+ * a payload exceeds it the service does not return an error — it drops the
+ * fields whose value is larger than 64 bytes. An oversized attachment would
+ * therefore arrive at the recipient with `ciphertext` missing: a message that
+ * appears to send and silently never arrives.
+ *
+ * REPLICA IDENTITY FULL is set on `messages` (so an expired bubble can be
+ * removed), which means an UPDATE event carries BOTH the old and the new row.
+ * The budget for one row is therefore half the limit, less headroom:
+ *
+ *   1,048,576 bytes / 2  = 524,288  hard ceiling for one row
+ *   budget 400,000 bytes           = ~24% margin for the other columns
+ *   ciphertext is hex, so body bytes <= (400,000 / 2) - 16  = 199,984
+ *   minus the JSON envelope (~30)   -> data URL <= ~199,950 characters
+ *
+ * 190,000 characters is chosen for margin. Measured: a data URL of 204,561
+ * characters is where the UPDATE payload reaches 818,544 bytes, so this sits
+ * comfortably inside the boundary rather than on it.
+ *
+ * THE HONEST LIMITATION. This keeps attachments deliverable; it does not make
+ * this a good storage design. Sending media as a reference to a Storage object
+ * is the correct architecture and is documented as remaining work. Until then
+ * a chat image is capped at roughly 140 KB, which is a real product constraint
+ * and not merely an implementation detail.
+ */
+export const CHAT_ATTACHMENT_MAX_DATA_URL_CHARS = 190_000;
+
+/**
+ * Resolution ladder for chat attachments.
+ *
+ * Attempted in order until the result fits the budget above. Starting large and
+ * stepping down is better than starting small: most photos will be sent at the
+ * first step, and only an unusually detailed one pays for a second encode.
+ */
+const CHAT_ATTACHMENT_ATTEMPTS: ReadonlyArray<{ longEdge: number; quality: number }> = [
+  { longEdge: 1600, quality: 0.82 },
+  { longEdge: 1280, quality: 0.76 },
+  { longEdge: 1024, quality: 0.70 },
+];
+
+export interface OptimisedImage {
+  blob: Blob;
+  extension: string;
+  contentType: string;
+}
+
+function extensionForType(type: string): string {
+  switch (type) {
+    case 'image/jpeg':
+      return 'jpg';
+    case 'image/png':
+      return 'png';
+    case 'image/webp':
+      return 'webp';
+    default:
+      return 'jpg';
+  }
+}
+
+/**
+ * Downscales and re-encodes an image, returning the original untouched if
+ * anything at all goes wrong.
+ *
+ * Deliberately total: no throw, no partial result. Callers depend on getting
+ * something usable back, and the original file is always a valid answer — the
+ * only question is whether it has been made smaller.
+ */
+export async function optimiseImage(
+  file: File,
+  options: { longEdge: number; quality?: number },
+): Promise<OptimisedImage> {
+  const original: OptimisedImage = {
+    blob: file,
+    extension: extensionForType(file.type),
+    contentType: file.type,
+  };
+
+  // No DOM (tests, SSR) or no decoder: hand back the original rather than
+  // failing a send over a missing browser capability.
+  if (typeof document === 'undefined' || typeof createImageBitmap !== 'function') return original;
+
+  try {
+    const bitmap = await createImageBitmap(file);
+    const scale = Math.min(1, options.longEdge / Math.max(bitmap.width, bitmap.height));
+    const width = Math.max(1, Math.round(bitmap.width * scale));
+    const height = Math.max(1, Math.round(bitmap.height * scale));
+
+    const canvas = document.createElement('canvas');
+    canvas.width = width;
+    canvas.height = height;
+    const context = canvas.getContext('2d');
+    if (!context) {
+      bitmap.close?.();
+      return original;
+    }
+    context.drawImage(bitmap, 0, 0, width, height);
+    bitmap.close?.();
+
+    // WebP keeps transparency and compresses well; the original is kept when
+    // the browser cannot encode it or the result is not actually smaller.
+    const encoded = await new Promise<Blob | null>((resolve) => {
+      canvas.toBlob((blob) => resolve(blob), 'image/webp', options.quality ?? 0.86);
+    });
+
+    if (!encoded || encoded.size === 0) return original;
+    // Re-encoding an already-optimal file can make it bigger; that would be a
+    // pessimisation, not an optimisation.
+    if (encoded.size >= file.size && scale === 1) return original;
+
+    return { blob: encoded, extension: 'webp', contentType: 'image/webp' };
+  } catch {
+    return original;
+  }
+}
+
+/** Reads a blob as a data URL, for the paths that keep the bytes in the message. */
+export function blobToDataUrl(blob: Blob): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result as string);
+    reader.onerror = () => reject(new Error('Failed to read image file'));
+    reader.readAsDataURL(blob);
+  });
+}
+
+/**
+ * Encodes an image so that its data URL fits `maxChars`, shrinking in steps
+ * until it does.
+ *
+ * Returns the smallest result it could reach, not a failure: the caller decides
+ * whether that is acceptable, because only the caller knows what the budget is
+ * for. If even the final step is too large the last attempt is returned, so the
+ * caller's size check reports the real number rather than a guess.
+ */
+export async function fitChatAttachment(
+  file: File,
+  maxChars: number,
+): Promise<{ dataUrl: string; attempts: number; fitted: boolean }> {
+  let last = '';
+  for (let index = 0; index < CHAT_ATTACHMENT_ATTEMPTS.length; index += 1) {
+    const attempt = CHAT_ATTACHMENT_ATTEMPTS[index];
+    const optimised = await optimiseImage(file, {
+      longEdge: attempt.longEdge,
+      quality: attempt.quality,
+    });
+    const dataUrl = await blobToDataUrl(optimised.blob);
+    last = dataUrl;
+
+    if (dataUrl.length <= maxChars) {
+      return { dataUrl, attempts: index + 1, fitted: true };
+    }
+  }
+  return { dataUrl: last, attempts: CHAT_ATTACHMENT_ATTEMPTS.length, fitted: false };
+}

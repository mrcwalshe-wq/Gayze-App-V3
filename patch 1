+/** Generates a receiver key pair the way a browser's push service does. */
+async function generateReceiverKeys() {
+  const pair = (await crypto.subtle.generateKey(
+    { name: 'ECDH', namedCurve: 'P-256' },
+    true,
+    ['deriveBits'],
+  )) as CryptoKeyPair;
+
+  const rawPublic = new Uint8Array(await crypto.subtle.exportKey('raw', pair.publicKey));
+  const jwk = (await crypto.subtle.exportKey('jwk', pair.privateKey)) as JsonWebKey;
+  const authSecret = crypto.getRandomValues(new Uint8Array(16));
+
+  return {
+    publicKey: pair.publicKey,
+    privateKey: pair.privateKey,
+    p256dh: b64url(rawPublic),
+    auth: b64url(authSecret),
+    // The receiver's private scalar, needed for the ECDH on the receiving side.
+    privateJwk: jwk,
+  };
+}

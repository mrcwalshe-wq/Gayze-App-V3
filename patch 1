@@ -0,0 +1,189 @@
+/**
+ * OAuth callback handling.
+ *
+ * A failed Google sign-in does not throw in the client: Supabase returns the
+ * failure to the redirect target as URL parameters. When nothing reads them the
+ * user is dropped back on the sign-in screen with no explanation and the button
+ * looks broken — which is exactly what was reported from the deployed app.
+ *
+ * Two shapes are covered because the flow can arrive either way: query string
+ * for the PKCE exchange, fragment for the implicit form.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+interface StubLocation {
+  href: string;
+  origin: string;
+  search: string;
+  hash: string;
+  pathname: string;
+}
+
+let location: StubLocation;
+let replaced: string | null;
+
+function stubBrowser(href: string): void {
+  const url = new URL(href);
+  location = {
+    href,
+    origin: url.origin,
+    search: url.search,
+    hash: url.hash,
+    pathname: url.pathname,
+  };
+  replaced = null;
+
+  vi.stubGlobal('window', {
+    location,
+    history: {
+      replaceState: (_state: unknown, _title: string, next: string) => {
+        replaced = next;
+      },
+    },
+  });
+  vi.stubGlobal('document', { title: 'GAYZE' });
+}
+
+async function load() {
+  vi.resetModules();
+  return import('./supabaseClient');
+}
+
+beforeEach(() => {
+  stubBrowser('https://gayze-app-v3.mrcwalshe.workers.dev/');
+});
+
+describe('readAuthCallbackError', () => {
+  it('returns null for an ordinary page load', async () => {
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toBeNull();
+  });
+
+  it('translates a cancelled Google consent screen', async () => {
+    stubBrowser('https://gayze.workers.dev/?error=access_denied&error_code=access_denied');
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toMatch(/cancelled/i);
+  });
+
+  it('reads a failure delivered in the fragment, not the query', async () => {
+    // The implicit form puts the same fields after the hash; a reader that only
+    // checks `location.search` misses this entirely.
+    stubBrowser('https://gayze.workers.dev/#error=server_error&error_description=Temporarily+unavailable');
+    const { readAuthCallbackError } = await load();
+    const message = readAuthCallbackError();
+    expect(message).toBeTruthy();
+    expect(message).toMatch(/unavailable|problem/i);
+  });
+
+  it("prefers the provider's own description when it is a known code", async () => {
+    stubBrowser('https://gayze.workers.dev/?error=invalid_request&error_description=Bad+redirect_uri');
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toMatch(/redirect configuration/i);
+  });
+
+  it('falls back to the description for an unrecognised code', async () => {
+    stubBrowser('https://gayze.workers.dev/?error=weird_failure&error_description=Something+specific');
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toContain('Something specific');
+  });
+
+  it('still reports an error that has a code but no description', async () => {
+    stubBrowser('https://gayze.workers.dev/?error_code=mystery');
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toContain('mystery');
+  });
+
+  it('ignores a successful callback carrying only a code', async () => {
+    // A `code` is the normal, healthy PKCE callback; it is not an error.
+    stubBrowser('https://gayze.workers.dev/?code=abc123');
+    const { readAuthCallbackError } = await load();
+    expect(readAuthCallbackError()).toBeNull();
+  });
+});
+
+describe('hasAuthCallbackCode', () => {
+  it('detects an authorisation code waiting to be exchanged', async () => {
+    stubBrowser('https://gayze.workers.dev/?code=abc123');
+    const { hasAuthCallbackCode } = await load();
+    expect(hasAuthCallbackCode()).toBe(true);
+  });
+
+  it('is false on an ordinary load', async () => {
+    const { hasAuthCallbackCode } = await load();
+    expect(hasAuthCallbackCode()).toBe(false);
+  });
+
+  it('detects a code in the fragment too', async () => {
+    stubBrowser('https://gayze.workers.dev/#code=abc123');
+    const { hasAuthCallbackCode } = await load();
+    expect(hasAuthCallbackCode()).toBe(true);
+  });
+});
+
+describe('clearAuthCallbackParams', () => {
+  it('removes the code so a reload cannot replay a spent exchange', async () => {
+    stubBrowser('https://gayze.workers.dev/?code=secret123&state=xyz');
+    const { clearAuthCallbackParams } = await load();
+    clearAuthCallbackParams();
+
+    expect(replaced).toBeTruthy();
+    expect(replaced).not.toContain('code=');
+    expect(replaced).not.toContain('state=');
+  });
+
+  it('removes an error so the message is not shown twice', async () => {
+    stubBrowser('https://gayze.workers.dev/?error=access_denied&error_description=no');
+    const { clearAuthCallbackParams } = await load();
+    clearAuthCallbackParams();
+    expect(replaced).not.toContain('error');
+  });
+
+  it('leaves unrelated parameters alone', async () => {
+    // `?diag=1` must survive: the diagnostics panel is reached by query string,
+    // and stripping it would make the panel unreachable after a callback.
+    stubBrowser('https://gayze.workers.dev/?code=abc&diag=1');
+    const { clearAuthCallbackParams } = await load();
+    clearAuthCallbackParams();
+    expect(replaced).toContain('diag=1');
+  });
+
+  it('does nothing when there is nothing to clear', async () => {
+    const { clearAuthCallbackParams } = await load();
+    clearAuthCallbackParams();
+    expect(replaced).toBeNull();
+  });
+
+  it('strips a fragment-carried error', async () => {
+    stubBrowser('https://gayze.workers.dev/#error=access_denied');
+    const { clearAuthCallbackParams } = await load();
+    clearAuthCallbackParams();
+    expect(replaced).not.toContain('error=');
+  });
+});
+
+describe('the redirect target', () => {
+  it('is built from the origin the user is actually on', async () => {
+    // The requirement that matters most for the deployed app: never a hard-coded
+    // host. localhost, a Workers subdomain and a custom domain must all work
+    // with no change to the code.
+    for (const origin of [
+      'http://localhost:3000',
+      'https://gayze-app-v3.mrcwalshe.workers.dev',
+      'https://gayze.app',
+    ]) {
+      stubBrowser(`${origin}/`);
+      const { getAuthRedirectUrl } = await load();
+      expect(getAuthRedirectUrl('/')).toBe(`${origin}/`);
+    }
+  });
+
+  it('never contains a hard-coded host', async () => {
+    stubBrowser('https://gayze.app/');
+    const { getAuthRedirectUrl } = await load();
+    const url = getAuthRedirectUrl('/');
+    for (const forbidden of ['vercel.app', 'netlify', 'workers.dev']) {
+      expect(url.includes(forbidden), `redirect target contains ${forbidden}`).toBe(false);
+    }
+  });
+});

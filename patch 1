+/**
+ * Live message-pipeline diagnostics, reachable at `?diag=1`.
+ *
+ * Shows which layer of the send path fails in the DEPLOYED application, which
+ * is the one thing the test suite cannot see. It is gated behind a query
+ * parameter rather than a build flag because the deployment is exactly where it
+ * needs to run: a diagnostic that only works locally cannot diagnose a
+ * production deployment.
+ *
+ * It writes one real row as part of the database check — carrying a two-minute
+ * lifetime and deleted immediately afterwards — so it must not be part of the
+ * normal UI, and it is not.
+ */
+
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  runMessagePipelineDiagnostics,
+  type DiagnosticCheck,
+  type DiagnosticRun,
+} from '../services/diagnostics';
+
+/** True when the URL carries `?diag=1`. */
+export function isDiagnosticsRequested(): boolean {
+  if (typeof window === 'undefined') return false;
+  return new URLSearchParams(window.location.search).get('diag') === '1';
+}
+
+const STATUS_STYLE: Record<DiagnosticCheck['status'], string> = {
+  PASS: 'text-emerald-300 border-emerald-500/40 bg-emerald-500/5',
+  FAIL: 'text-red-300 border-red-500/50 bg-red-500/10',
+  SKIP: 'text-zinc-400 border-zinc-600/40 bg-zinc-500/5',
+};
+
+const STATUS_MARK: Record<DiagnosticCheck['status'], string> = {
+  PASS: '✓',
+  FAIL: '✗',
+  SKIP: '·',
+};
+
+/**
+ * The panel itself. Mounted only when the URL asks for it — see the exported
+ * wrapper below, which is what keeps the diagnostics from running for everyone.
+ */
+const DiagnosticPanelInner: React.FC = () => {
+  const [run, setRun] = useState<DiagnosticRun | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [, setTick] = useState(0);
+
+  // The probe outlives a single render, so it is held in a ref: each run stops
+  // the previous one before opening a new channel, and unmounting stops the
+  // last. A leaked channel would keep reporting events into a dead component.
+  const probeRef = useRef<DiagnosticRun['realtime'] | null>(null);
+  const mounted = useRef(true);
+
+  const execute = useCallback(async () => {
+    setBusy(true);
+    setError(null);
+    probeRef.current?.stop();
+    probeRef.current = null;
+    try {
+      const result = await runMessagePipelineDiagnostics();
+      if (!mounted.current) {
+        result.realtime?.stop();
+        return;
+      }
+      probeRef.current = result.realtime ?? null;
+      setRun(result);
+    } catch (err) {
+      setError(err instanceof Error ? `${err.message}\n${err.stack ?? ''}` : String(err));
+    } finally {
+      if (mounted.current) setBusy(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    mounted.current = true;
+    void execute();
+    return () => {
+      mounted.current = false;
+      probeRef.current?.stop();
+    };
+  }, [execute]);
+
+  // Re-render once a second so status transitions and incoming events appear
+  // while the operator waits — the probe records them, but React has no way to
+  // know it did.
+  useEffect(() => {
+    const id = window.setInterval(() => setTick((value) => value + 1), 1000);
+    return () => window.clearInterval(id);
+  }, []);
+
+  const checks = run?.checks ?? [];
+  const firstFailure = run?.firstFailure ?? null;
+
+  return (
+    <div className="fixed inset-0 z-[100] overflow-y-auto bg-black/95 p-4 font-mono text-[11px] leading-relaxed text-zinc-200">
+      <div className="mx-auto max-w-3xl space-y-4">
+        <header className="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3">
+          <div>
+            <h1 className="text-sm font-bold tracking-wide text-white">GAYZE · MESSAGE PIPELINE DIAGNOSTICS</h1>
+            <p className="text-zinc-500">
+              Runs against the live project, in this browser, with this session.
+            </p>
+          </div>
+          <div className="flex gap-2">
+            <button
+              onClick={() => void execute()}
+              disabled={busy}
+              className="rounded border border-zinc-600 px-3 py-1 text-zinc-200 hover:bg-zinc-800 disabled:opacity-40"
+            >
+              {busy ? 'Running…' : 'Re-run'}
+            </button>
+            <button
+              onClick={() => {
+                const url = new URL(window.location.href);
+                url.searchParams.delete('diag');
+                window.location.replace(url.toString());
+              }}
+              className="rounded border border-zinc-600 px-3 py-1 text-zinc-400 hover:bg-zinc-800"
+            >
+              Close
+            </button>
+          </div>
+        </header>
+
+        {error && (
+          <pre className="whitespace-pre-wrap rounded border border-red-500/50 bg-red-500/10 p-3 text-red-300">
+            {error}
+          </pre>
+        )}
+
+        {firstFailure && (
+          <div className="rounded border border-amber-500/50 bg-amber-500/10 p-3 text-amber-200">
+            <div className="font-bold">FIRST FAILING LAYER: {firstFailure.layer}</div>
+            <p className="mt-1 text-amber-100/90">{firstFailure.detail}</p>
+            <p className="mt-1 text-amber-200/70">
+              Fix the first failure only. Everything below it may be failing purely because
+              this one did.
+            </p>
+          </div>
+        )}
+
+        {!firstFailure && checks.length > 0 && (
+          <div className="rounded border border-emerald-500/40 bg-emerald-500/10 p-3 text-emerald-200">
+            <div className="font-bold">Every layer passed.</div>
+            <p className="mt-1 text-emerald-100/90">
+              Send a message from another account now: the realtime event should appear in the
+              REALTIME section below within a second. If it does and the message still does not
+              render, the break is in decryption or React state, not the transport.
+            </p>
+          </div>
+        )}
+
+        <section className="space-y-1">
+          {checks.map((check, index) => (
+            <div
+              key={`${check.layer}-${index}`}
+              className={`rounded border p-2 ${STATUS_STYLE[check.status]}`}
+            >
+              <div className="flex items-start gap-2">
+                <span className="w-3 shrink-0">{STATUS_MARK[check.status]}</span>
+                <span className="w-32 shrink-0 font-bold">{check.layer}</span>
+                <span className="flex-1">{check.detail}</span>
+              </div>
+              {check.raw !== undefined && (
+                <pre className="mt-1 ml-5 overflow-x-auto whitespace-pre-wrap text-[10px] text-zinc-400">
+                  {JSON.stringify(check.raw, null, 2)}
+                </pre>
+              )}
+            </div>
+          ))}
+        </section>
+
+        {run?.realtime && (
+          <section className="rounded border border-zinc-700 p-3">
+            <h2 className="font-bold text-white">REALTIME</h2>
+            <div className="mt-2 space-y-1">
+              <div>
+                <span className="text-zinc-500">subscription statuses observed: </span>
+                {run.realtime.statuses.length
+                  ? run.realtime.statuses.join(' → ')
+                  : '(none yet — SUBSCRIBING usually appears first)'}
+              </div>
+              <div>
+                <span className="text-zinc-500">expected: </span>
+                SUBSCRIBING → SUBSCRIBED. CHANNEL_ERROR or TIMED_OUT means events cannot
+                arrive — check the Supabase project&apos;s Realtime settings and that
+                <code className="mx-1">messages</code> is in the
+                <code className="mx-1">supabase_realtime</code> publication.
+              </div>
+              <div className="pt-1">
+                <span className="text-zinc-500">last INSERT event: </span>
+                {run.realtime.eventReceived
+                  ? <span className="text-emerald-300">{run.realtime.eventReceived.detail}</span>
+                  : <span className="text-zinc-400">
+                      none yet. Send a message from a second account or device now — if nothing
+                      appears here, the problem is Realtime, not React.
+                    </span>}
+              </div>
+            </div>
+          </section>
+        )}
+
+        <footer className="border-t border-zinc-700 pt-3 text-zinc-500">
+          <p>Layers: ENVIRONMENT → AUTH → DEVICE IDENTITY → MEMBERSHIP → ENCRYPTION</p>
+          <p className="pl-3">→ DATABASE INSERT → DATABASE SELECT → RLS → REALTIME</p>
+          <p className="mt-1">INSERT probe: writes one row into the newest conversation, then deletes it.</p>
+          <p>Re-inserts are safe — the earlier ones expire after two minutes regardless.</p>
+          <p className="mt-1 text-zinc-600">
+            No key, token or message content is displayed. The project reference is shown
+            because telling a staging project from the production one is the point.
+          </p>
+        </footer>
+      </div>
+    </div>
+  );
+};
+
+/**
+ * Renders the diagnostics only when the URL carries `?diag=1`.
+ *
+ * The guard is the FIRST statement and lives here rather than inside the panel,
+ * because the panel's effect performs a real INSERT. Checking the parameter
+ * inside a component that has already run its hooks would write a row into the
+ * database on every page load of the deployed app, for every user. This split
+ * makes that impossible: no hook runs until the parameter is present.
+ *
+ * The parameter is read at render time, so it is a mount-time decision — the app
+ * does not use client-side routing that would change it without a reload.
+ */
+export const DiagnosticPanel: React.FC = () => {
+  if (!isDiagnosticsRequested()) return null;
+  return <DiagnosticPanelInner />;
+};
+
+export default DiagnosticPanel;

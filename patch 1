+/**
+ * GAYZE — send-push Edge Function.
+ *
+ * This is the only place the VAPID private key exists. It is never read by the
+ * client, never bundled, and never returned in a response.
+ *
+ * Deploy:
+ *   supabase functions deploy send-push --no-verify-jwt
+ *   supabase secrets set \
+ *     VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:...
+ *
+ * `--no-verify-jwt` is required because the trigger below is a database
+ * webhook, which does not carry a user JWT. The function therefore treats its
+ * input as untrusted: it accepts only a message id and derives the recipients,
+ * their conversation and their display name itself. It cannot be asked to send
+ * arbitrary content to arbitrary endpoints.
+ *
+ * Wire it to new messages with a Database Webhook (Supabase dashboard →
+ * Database → Webhooks):
+ *
+ *   Table:   public.messages
+ *   Events:  INSERT
+ *   Type:    Supabase Edge Function
+ *   Function: send-push
+ *
+ * Two arrival modes matter, and this function treats them differently:
+ *   * A normal message produces a NOTIFICATION — a new row, an unread badge.
+ *   * A call produces a separate, higher-priority signal with its own tag, so a
+ *     missed call is not overwritten by a later text.
+ */
+
+import { createClient } from 'jsr:@supabase/supabase-js@2';
+import {
+  buildVapidHeader,
+  classifyPushResponse,
+  concat,
+  encryptPayload,
+} from '../_shared/webpush.ts';
+
+interface MessageRow {
+  id: string;
+  conversation_id: string;
+  sender_id: string;
+  created_at: string;
+  expires_at: string | null;
+}
+
+interface PushTarget {
+  user_id: string;
+  endpoint: string;
+  p256dh: string;
+  auth: string;
+}
+
+interface WebhookPayload {
+  type: 'INSERT' | 'UPDATE' | 'DELETE';
+  table: string;
+  record?: MessageRow;
+  old_record?: MessageRow;
+}
+
+const SUPABASE_URL = Deno.env.get('SUPABASE_URL') ?? '';
+const SERVICE_ROLE_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? '';
+const VAPID_PUBLIC_KEY = Deno.env.get('VAPID_PUBLIC_KEY') ?? '';
+const VAPID_PRIVATE_KEY = Deno.env.get('VAPID_PRIVATE_KEY') ?? '';
+const VAPID_SUBJECT = Deno.env.get('VAPID_SUBJECT') ?? 'mailto:hello@gayze.app';
+
+function truncate(value: string, max: number): string {
+  const collapsed = value.replace(/\s+/g, ' ').trim();
+  return collapsed.length > max ? `${collapsed.slice(0, max - 1)}…` : collapsed;
+}
+
+Deno.serve(async (request: Request) => {
+  if (request.method !== 'POST') {
+    return new Response('Method not allowed', { status: 405 });
+  }
+
+  if (!VAPID_PUBLIC_KEY || !VAPID_PRIVATE_KEY || !SUPABASE_URL || !SERVICE_ROLE_KEY) {
+    // Not configured is not an error to hide: the caller should know delivery
+    // did not happen rather than assume it did.
+    return new Response(
+      JSON.stringify({ delivered: 0, reason: 'VAPID keys or Supabase credentials are not configured.' }),
+      { status: 200, headers: { 'content-type': 'application/json' } },
+    );
+  }
+
+  let payload: WebhookPayload;
+  try {
+    payload = await request.json();
+  } catch {
+    return new Response('Bad request', { status: 400 });
+  }
+
+  if (payload.type !== 'INSERT' || !payload.record?.id) {
+    return new Response(JSON.stringify({ delivered: 0, reason: 'ignored' }), {
+      status: 200,
+      headers: { 'content-type': 'application/json' },
+    });
+  }
+
+  const messageId = payload.record.id;
+  const supabase = createClient(SUPABASE_URL, SERVICE_ROLE_KEY, {
+    auth: { persistSession: false },
+  });
+
+  // Recipients, their endpoints and the sender's name are derived server-side
+  // from the message id alone. The function cannot be told who to notify.
+  const { data: targets, error: targetError } = await supabase
+    .rpc('push_targets_for_message', { p_message_id: messageId });
+
+  if (targetError) {
+    console.error('[GAYZE push] Could not resolve recipients', targetError.message);
+    return new Response(JSON.stringify({ delivered: 0, reason: targetError.message }), { status: 200 });
+  }
+
+  const recipients = (targets ?? []) as PushTarget[];
+  if (recipients.length === 0) {
+    return new Response(JSON.stringify({ delivered: 0, reason: 'no subscriptions' }), { status: 200 });
+  }
+
+  const { data: message } = await supabase
+    .from('messages')
+    .select('id,conversation_id,sender_id,created_at,expires_at')
+    .eq('id', messageId)
+    .maybeSingle();
+
+  if (!message) {
+    return new Response(JSON.stringify({ delivered: 0, reason: 'message gone' }), { status: 200 });
+  }
+
+  // An expiring message says so, because "you have 10 seconds to look" changes
+  // whether someone opens the app now or later.
+  let expiryNote = '';
+  if (message.expires_at) {
+    const remainingMs = new Date(message.expires_at).getTime() - Date.now();
+    if (remainingMs <= 60_000) expiryNote = ' · disappears in under a minute';
+    else if (remainingMs <= 3_600_000) expiryNote = ` · disappears in ${Math.round(remainingMs / 60_000)} min`;
+  }
+
+  const { data: senderProfile } = await supabase
+    .from('profiles')
+    .select('display_name')
+    .eq('id', message.sender_id)
+    .maybeSingle();
+
+  const senderName = (senderProfile?.display_name as string) || 'New message';
+  // The body is deliberately not the message text: message content is encrypted
+  // client-side and the server cannot read it. Saying so is better than a blank
+  // notification, and better than pretending we can show it.
+  const body = `Encrypted message${expiryNote}`;
+
+  let delivered = 0;
+  let failed = 0;
+
+  await Promise.all(
+    recipients.map(async (target) => {
+      try {
+        const audience = new URL(target.endpoint).origin;
+        const authorization = await buildVapidHeader(audience, VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY, VAPID_SUBJECT);
+
+        const record = JSON.stringify({
+          title: senderName,
+          body,
+          conversationId: message.conversation_id,
+          kind: 'message',
+        });
+
+        const { body: ciphertext, salt, localPublicKey } = await encryptPayload(
+          record,
+          target.p256dh,
+          target.auth,
+        );
+
+        // aes128gcm body: salt(16) || rs(4) || idlen(1) || keyid(65) || ciphertext
+        const header = new Uint8Array(16 + 4 + 1 + 65);
+        header.set(salt, 0);
+        new DataView(header.buffer).setUint32(16, 4096, false);
+        header[20] = 65;
+        header.set(localPublicKey, 21);
+
+        const response = await fetch(target.endpoint, {
+          method: 'POST',
+          headers: {
+            Authorization: authorization,
+            'Content-Encoding': 'aes128gcm',
+            'Content-Type': 'application/octet-stream',
+            TTL: '2419200',
+            Urgency: 'high',
+          },
+          body: concat(header, ciphertext),
+        });
+
+        switch (classifyPushResponse(response.status)) {
+          case 'delivered':
+            delivered += 1;
+            return;
+
+          case 'retire':
+            // The push service says this endpoint is gone for good. Retire it so
+            // the sender stops trying, and the client re-subscribes on next
+            // launch. `p_increment_failure: false` is what marks it disabled.
+            await supabase.rpc('disable_push_subscription', {
+              p_endpoint: target.endpoint,
+              p_increment_failure: false,
+            });
+            failed += 1;
+            return;
+
+          case 'retry-later':
+            // Our problem or a transient one — a 401 means the VAPID key is
+            // wrong, which would fail for every device at once. The subscription
+            // is left intact and only the failure counter moves, so a bad deploy
+            // cannot delete the recipient list.
+            await supabase.rpc('disable_push_subscription', {
+              p_endpoint: target.endpoint,
+              p_increment_failure: true,
+            });
+            failed += 1;
+            return;
+        }
+      } catch (error) {
+        console.error('[GAYZE push] Delivery failed', (error as Error).message);
+        failed += 1;
+      }
+    }),
+  );
+
+  return new Response(JSON.stringify({ delivered, failed, total: recipients.length }), {
+    status: 200,
+    headers: { 'content-type': 'application/json' },
+  });
+});
diff --git a/supabase/migrations/20260928120000_profile_photos.sql b/supabase/migrations/20260928120000_profile_photos.sql
new file mode 100644
index 0000000..b33d6e7
--- /dev/null
+++ b/supabase/migrations/20260928120000_profile_photos.sql
@@ -0,0 +1,487 @@
+-- ============================================================================
+-- GAYZE — profile photos (identity media)
+-- ============================================================================
+-- Persistent identity media for a member: one primary photo plus an ordered
+-- album. This is NOT the Stories system. Stories are temporary intent/activity
+-- media with their own table and their own lifetime; profile photos are the
+-- member's lasting identity and live here.
+--
+-- Storage layout:  profile-photos/{user_id}/{photo_id}.{ext}
+-- Bucket is PRIVATE. Objects are never public and never linked directly: the
+-- client asks Storage for a short-lived signed URL, and Storage enforces the
+-- read policy below before signing anything.
+--
+-- Read model (the GAYZE rule): a member's photos are readable by
+--   * the member themselves, always;
+--   * anyone, while the member is live on the map (an unexpired, unpaused
+--     intent row exists) — the same window in which they are discoverable;
+--   * anyone who already shares a conversation with them, so photos do not
+--     vanish mid-conversation when an intent expires.
+-- Write model: strictly the owner. No cross-user writes, ever, by policy and
+-- by a path-shape constraint that pins each object to the owner's folder.
+--
+-- Safe to run more than once (idempotent). Apply it in the Supabase SQL editor
+-- or with `supabase db push`, then set VITE_SUPABASE_* as usual.
+-- ============================================================================
+
+-- ---------------------------------------------------------------------------
+-- 0. Preconditions
+-- ---------------------------------------------------------------------------
+create extension if not exists pgcrypto;
+
+-- `profiles.avatar_path` is the denormalised pointer to the primary photo. The
+-- discovery RPC already selects `avatar_path`, so nothing else has to change for
+-- a member's face to reach Right Now / Discover.
+alter table public.profiles add column if not exists avatar_path text;
+
+-- Interests were part of the client profile model with nowhere to live. They are
+-- the member's own words about themselves, capped and trimmed client-side.
+alter table public.profiles add column if not exists interests text[] not null default '{}';
+
+comment on column public.profiles.avatar_path is
+  'Storage path of the primary profile photo in the profile-photos bucket. Maintained by trigger from profile_photos; never written directly by clients.';
+
+-- ---------------------------------------------------------------------------
+-- 1. Table
+-- ---------------------------------------------------------------------------
+create table if not exists public.profile_photos (
+  id uuid primary key default gen_random_uuid(),
+  user_id uuid not null references public.profiles (id) on delete cascade,
+  storage_path text not null,
+  sort_order integer not null default 0,
+  is_primary boolean not null default false,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  constraint profile_photos_storage_path_key unique (storage_path),
+  constraint profile_photos_owner_path_key unique (user_id, storage_path),
+  constraint profile_photos_sort_order_check check (sort_order >= 0 and sort_order < 24),
+  -- The object must sit inside the owner's own folder and follow
+  -- {user_id}/{photo_id}.{jpg|jpeg|png|webp}. This makes a cross-user path
+  -- impossible to store even before Storage is consulted, and blocks any
+  -- traversal-style path.
+  constraint profile_photos_path_shape_check check (
+    storage_path ~ '^[0-9a-fA-F-]{36}/[0-9a-fA-F-]{36}\.(jpg|jpeg|png|webp)$'
+  )
+);
+
+comment on table public.profile_photos is
+  'Ordered identity photos for a GAYZE member. Files live in the private profile-photos bucket at {user_id}/{photo_id}.{ext}.';
+comment on column public.profile_photos.is_primary is
+  'Exactly one row per user is primary (enforced by a partial unique index). Mirrored into profiles.avatar_path by trigger.';
+
+-- Only one primary photo per member, enforced in the database.
+create unique index if not exists profile_photos_one_primary_per_user
+  on public.profile_photos (user_id)
+  where is_primary;
+
+create index if not exists profile_photos_user_order_idx
+  on public.profile_photos (user_id, is_primary desc, sort_order asc, created_at asc);
+
+-- ---------------------------------------------------------------------------
+-- 2. Visibility helper
+-- ---------------------------------------------------------------------------
+-- One SECURITY DEFINER function so that both the table policy and the Storage
+-- policy answer the "may this viewer see this member's identity media?"
+-- question identically. search_path is pinned, and nothing is returned beyond a
+-- boolean, so it cannot be used to read rows the caller could not otherwise
+-- read.
+-- Takes the owner as text because the Storage policy can only offer the first
+-- path segment (`{user_id}/...`) as text. The shape is validated before any
+-- cast, so a stray folder name can never raise inside a policy.
+create or replace function public.gayze_can_view_profile_media(p_owner text)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_owner uuid;
+begin
+  if p_owner is null or p_owner !~ '^[0-9a-fA-F-]{36}$' then
+    return false;
+  end if;
+
+  v_owner := p_owner::uuid;
+
+  if v_owner = auth.uid() then
+    return true;
+  end if;
+
+  -- Visible while the member is actually live on the map.
+  if exists (
+    select 1
+    from public.intents i
+    where i.user_id = v_owner
+      and i.expires_at > now()
+      and coalesce(i.is_paused, false) = false
+  ) then
+    return true;
+  end if;
+
+  -- Visible to people who already share a conversation with them.
+  return exists (
+    select 1
+    from public.conversation_members mine
+    join public.conversation_members theirs
+      on theirs.conversation_id = mine.conversation_id
+    where mine.user_id = auth.uid()
+      and theirs.user_id = v_owner
+  );
+end;
+$$;
+
+revoke all on function public.gayze_can_view_profile_media(text) from public;
+grant execute on function public.gayze_can_view_profile_media(text) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 3. Table policies
+-- ---------------------------------------------------------------------------
+alter table public.profile_photos enable row level security;
+
+drop policy if exists profile_photos_select_visible on public.profile_photos;
+create policy profile_photos_select_visible
+  on public.profile_photos
+  for select
+  to authenticated
+  using (public.gayze_can_view_profile_media(user_id::text));
+
+drop policy if exists profile_photos_insert_own on public.profile_photos;
+create policy profile_photos_insert_own
+  on public.profile_photos
+  for insert
+  to authenticated
+  with check (user_id = auth.uid());
+
+drop policy if exists profile_photos_update_own on public.profile_photos;
+create policy profile_photos_update_own
+  on public.profile_photos
+  for update
+  to authenticated
+  using (user_id = auth.uid())
+  with check (user_id = auth.uid());
+
+drop policy if exists profile_photos_delete_own on public.profile_photos;
+create policy profile_photos_delete_own
+  on public.profile_photos
+  for delete
+  to authenticated
+  using (user_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 4. Trigger: keep the album coherent
+-- ---------------------------------------------------------------------------
+-- * assigns sort_order when the client does not supply one,
+-- * promotes the first photo to primary, so an album with photos always has a
+--   primary image,
+-- * demotes any previous primary when a new primary is written,
+-- * refuses writes from anyone other than the owner (belt and braces: the RLS
+--   policy already does this),
+-- * refuses a seventh photo.
+create or replace function public.profile_photos_before_write()
+returns trigger
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_photo_count integer;
+  v_has_primary boolean;
+begin
+  -- RLS is the authority; this is a second gate that also catches a client
+  -- trying to write a row on someone else's behalf with a valid session.
+  -- Skipped when there is no end-user JWT at all (service-side maintenance).
+  if auth.uid() is not null and new.user_id is distinct from auth.uid() then
+    raise exception 'profile photos can only be written by their owner'
+      using errcode = '42501';
+  end if;
+
+  select count(*) into v_photo_count
+  from public.profile_photos
+  where user_id = new.user_id
+    and id <> new.id;
+
+  if v_photo_count >= 6 then
+    raise exception 'profile photo limit reached (6 per member)'
+      using errcode = '23514';
+  end if;
+
+  if new.sort_order is null or new.sort_order < 0 then
+    select coalesce(max(sort_order) + 1, 0) into new.sort_order
+    from public.profile_photos
+    where user_id = new.user_id;
+  end if;
+
+  select exists (
+    select 1 from public.profile_photos
+    where user_id = new.user_id
+      and is_primary
+      and id <> new.id
+  ) into v_has_primary;
+
+  if not v_has_primary then
+    new.is_primary := true;
+    new.sort_order := 0;
+  elsif new.is_primary then
+    update public.profile_photos
+      set is_primary = false
+      where user_id = new.user_id
+        and is_primary
+        and id <> new.id;
+  end if;
+
+  new.updated_at := now();
+  return new;
+end;
+$$;
+
+drop trigger if exists profile_photos_before_write on public.profile_photos;
+create trigger profile_photos_before_write
+  before insert or update on public.profile_photos
+  for each row execute function public.profile_photos_before_write();
+
+-- ---------------------------------------------------------------------------
+-- 5. Trigger: mirror the primary photo into profiles.avatar_path
+-- ---------------------------------------------------------------------------
+create or replace function public.profile_photos_sync_avatar_path()
+returns trigger
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := coalesce(new.user_id, old.user_id);
+  v_path text;
+  v_next_primary uuid;
+begin
+  select storage_path into v_path
+  from public.profile_photos
+  where user_id = v_user_id
+    and is_primary
+  limit 1;
+
+  -- Deleting the primary photo must not leave the album headless: promote the
+  -- next photo in album order so a member with photos always has a face.
+  if v_path is null then
+    select id into v_next_primary
+    from public.profile_photos
+    where user_id = v_user_id
+    order by sort_order asc, created_at asc
+    limit 1;
+
+    if v_next_primary is not null then
+      update public.profile_photos
+        set is_primary = true, sort_order = 0, updated_at = now()
+        where id = v_next_primary;
+
+      select storage_path into v_path
+      from public.profile_photos
+      where id = v_next_primary;
+    end if;
+  end if;
+
+  update public.profiles
+    set avatar_path = v_path
+    where id = v_user_id
+      and avatar_path is distinct from v_path;
+
+  return null;
+end;
+$$;
+
+drop trigger if exists profile_photos_sync_avatar_path on public.profile_photos;
+create trigger profile_photos_sync_avatar_path
+  after insert or update or delete on public.profile_photos
+  for each row execute function public.profile_photos_sync_avatar_path();
+
+-- ---------------------------------------------------------------------------
+-- 6. RPCs used by the client
+-- ---------------------------------------------------------------------------
+-- Both run as the caller (security invoker), so RLS is the authority and a
+-- member can only ever reorder or promote their own photos.
+
+create or replace function public.mark_primary_profile_photo(p_photo_id uuid)
+returns boolean
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_updated integer;
+begin
+  if v_user_id is null then
+    return false;
+  end if;
+
+  update public.profile_photos
+    set is_primary = false, updated_at = now()
+    where user_id = v_user_id
+      and is_primary
+      and id <> p_photo_id;
+
+  update public.profile_photos
+    set is_primary = true, sort_order = 0, updated_at = now()
+    where id = p_photo_id
+      and user_id = v_user_id;
+
+  get diagnostics v_updated = row_count;
+  return v_updated > 0;
+end;
+$$;
+
+create or replace function public.reorder_profile_photos(p_photo_ids uuid[])
+returns boolean
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_owned integer;
+  v_requested integer;
+begin
+  if v_user_id is null or p_photo_ids is null then
+    return false;
+  end if;
+
+  v_requested := array_length(p_photo_ids, 1);
+  if v_requested is null or v_requested = 0 then
+    return false;
+  end if;
+
+  select count(*) into v_owned
+  from public.profile_photos
+  where user_id = v_user_id
+    and id = any (p_photo_ids);
+
+  if v_owned <> v_requested then
+    -- A photo id from another member, or from a different album state.
+    raise exception 'reorder rejected: unknown photo in request'
+      using errcode = '42501';
+  end if;
+
+  -- One pass. `sort_order` carries no unique constraint, so there is no
+  -- intermediate state to collide with; the primary photo keeps position 0 and
+  -- the rest take their array position.
+  update public.profile_photos p
+    set sort_order = case
+          when p.is_primary then 0
+          else coalesce(ordinality, p.sort_order)
+        end,
+        updated_at = now()
+    from (
+      select id, ordinality
+      from unnest(p_photo_ids) with ordinality as t(id, ordinality)
+    ) as requested
+    where p.id = requested.id
+      and p.user_id = v_user_id;
+
+  return true;
+end;
+$$;
+
+revoke all on function public.mark_primary_profile_photo(uuid) from public;
+revoke all on function public.reorder_profile_photos(uuid[]) from public;
+grant execute on function public.mark_primary_profile_photo(uuid) to authenticated;
+grant execute on function public.reorder_profile_photos(uuid[]) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 7. Storage bucket + object policies
+-- ---------------------------------------------------------------------------
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values (
+  'profile-photos',
+  'profile-photos',
+  false,
+  5242880, -- 5 MB, matching the client-side guard
+  array['image/jpeg', 'image/png', 'image/webp']
+)
+on conflict (id) do update
+  set public = false,
+      file_size_limit = excluded.file_size_limit,
+      allowed_mime_types = excluded.allowed_mime_types;
+
+drop policy if exists profile_photos_objects_select on storage.objects;
+create policy profile_photos_objects_select
+  on storage.objects
+  for select
+  to authenticated
+  using (
+    bucket_id = 'profile-photos'
+    and public.gayze_can_view_profile_media((storage.foldername(name))[1])
+  );
+
+drop policy if exists profile_photos_objects_insert on storage.objects;
+create policy profile_photos_objects_insert
+  on storage.objects
+  for insert
+  to authenticated
+  with check (
+    bucket_id = 'profile-photos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
+
+drop policy if exists profile_photos_objects_update on storage.objects;
+create policy profile_photos_objects_update
+  on storage.objects
+  for update
+  to authenticated
+  using (
+    bucket_id = 'profile-photos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  )
+  with check (
+    bucket_id = 'profile-photos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
+
+drop policy if exists profile_photos_objects_delete on storage.objects;
+create policy profile_photos_objects_delete
+  on storage.objects
+  for delete
+  to authenticated
+  using (
+    bucket_id = 'profile-photos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
+
+-- ---------------------------------------------------------------------------
+-- 8. Backfill
+-- ---------------------------------------------------------------------------
+-- If avatar_path already pointed somewhere, adopt nothing here: the client
+-- uploads real files. This statement exists only so re-running the migration
+-- after a partial apply is safe.
+do $$
+begin
+  if not exists (select 1 from public.profile_photos) then
+    raise notice 'GAYZE profile_photos ready: no existing photos to adopt.';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 9. Rollback notes
+-- ---------------------------------------------------------------------------
+-- This migration only adds. To reverse it:
+--
+--   drop policy if exists profile_photos_objects_select on storage.objects;
+--   drop policy if exists profile_photos_objects_insert on storage.objects;
+--   drop policy if exists profile_photos_objects_update on storage.objects;
+--   drop policy if exists profile_photos_objects_delete on storage.objects;
+--   drop trigger  if exists profile_photos_before_write_trigger on public.profile_photos;
+--   drop function if exists public.reorder_profile_photos(uuid[]);
+--   drop function if exists public.mark_primary_profile_photo(uuid);
+--   drop function if exists public.gayze_can_view_profile_media(text);
+--   drop function if exists public.profile_photos_sync_avatar_path();
+--   drop function if exists public.profile_photos_before_write();
+--   drop table    if exists public.profile_photos;
+--   alter table public.profiles drop column if exists interests;
+--   alter table public.profiles drop column if exists avatar_path;
+--
+-- The `profile-photos` bucket is left in place: dropping it deletes every
+-- stored photo, which is a data loss the operator should choose deliberately
+-- rather than inherit from a rollback. Remove it manually once empty.
+--
+-- No existing profile data is modified by this migration: `avatar_path` and
+-- `interests` are added with defaults, and nothing is overwritten.
diff --git a/supabase/migrations/20260928130000_messaging_reliability.sql b/supabase/migrations/20260928130000_messaging_reliability.sql
new file mode 100644
index 0000000..3d8a3ae
--- /dev/null
+++ b/supabase/migrations/20260928130000_messaging_reliability.sql
@@ -0,0 +1,506 @@
+-- ============================================================================
+-- GAYZE — messaging reliability, unread state and enforced ephemerality
+-- ============================================================================
+-- Fixes the three defects in the current message layer:
+--
+--   1. Expiry was recorded but never enforced. `messages.expires_at` was written
+--      by the client, then ignored by every read path, so an expired message
+--      came back on the next page load.
+--   2. There was no unread model, so the UI had nothing to count.
+--   3. There was no dedupe key, so a message could be applied twice (Realtime
+--      echo + optimistic insert) and notify twice.
+--
+-- Design notes
+-- ------------
+-- * Existing policies are NOT dropped or redefined. The client repository does
+--   not own the live policy definitions, and replacing a permissive policy by
+--   guessing its name would be reckless. Every rule added here is a
+--   RESTRICTIVE policy, which Postgres ANDs with the existing permissive set.
+--   This can only ever narrow access, never widen it.
+-- * Expiry is enforced in three independent places, so no single failure opens
+--   a hole: an RLS predicate (reads), a purge routine (storage), and the
+--   client's own display timer (UI only).
+-- * Safe to run more than once. Safe to run before or after the other
+--   migrations in this directory.
+-- ============================================================================
+
+-- ---------------------------------------------------------------------------
+-- 0. Preconditions
+-- ---------------------------------------------------------------------------
+create extension if not exists pgcrypto;
+
+-- ---------------------------------------------------------------------------
+-- 1. messages: dedupe key, and the indexes the read paths actually need
+-- ---------------------------------------------------------------------------
+-- `client_id` is generated once per send attempt by the client. If the same send
+-- is retried after a timeout, or arrives twice over Realtime, the unique index
+-- makes the duplicate a no-op instead of a second bubble and a second toast.
+alter table public.messages add column if not exists client_id uuid;
+
+-- A sender's own idempotency scope. `null` is allowed for legacy rows and for
+-- server-authored system messages.
+create unique index if not exists messages_sender_client_id_key
+  on public.messages (sender_id, client_id)
+  where client_id is not null;
+
+-- Conversation timeline reads (and pagination) walk this order.
+create index if not exists messages_conversation_created_idx
+  on public.messages (conversation_id, created_at desc);
+
+-- The purge routine scans only rows that can actually expire.
+create index if not exists messages_expires_at_idx
+  on public.messages (expires_at)
+  where expires_at is not null;
+
+comment on column public.messages.client_id is
+  'Client-generated idempotency key for one send attempt. Unique per sender. Prevents duplicate delivery from retries or Realtime echo.';
+
+-- ---------------------------------------------------------------------------
+-- 1b. Membership, decided without depending on the live membership policy
+-- ---------------------------------------------------------------------------
+-- Every policy below needs the same answer: "is the caller in this
+-- conversation?". Doing that with a subquery against conversation_members makes
+-- each policy depend on whatever RLS is configured on that table — which this
+-- repository cannot see — and a membership policy that itself queries
+-- conversation_members recurses infinitely.
+--
+-- SECURITY DEFINER here is not a privilege escalation: the function answers
+-- only about auth.uid(), takes no user id, and returns a boolean. It is the
+-- standard Supabase pattern for exactly this reason.
+create or replace function public.gayze_is_conversation_member(p_conversation_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1
+    from public.conversation_members m
+    where m.conversation_id = p_conversation_id
+      and m.user_id = auth.uid()
+  );
+$$;
+
+comment on function public.gayze_is_conversation_member(uuid) is
+  'True when the calling user is a member of the conversation. SECURITY DEFINER so it does not depend on, or recurse through, the membership policy itself.';
+
+revoke all on function public.gayze_is_conversation_member(uuid) from public;
+grant execute on function public.gayze_is_conversation_member(uuid) to authenticated, service_role;
+
+-- ---------------------------------------------------------------------------
+-- 2. Expiry: enforced reads
+-- ---------------------------------------------------------------------------
+-- RESTRICTIVE: ANDed with whatever permissive SELECT policies already exist.
+-- An expired message is not readable by anyone, including its author — the
+-- ciphertext is gone from the API surface, not merely hidden in the UI.
+--
+-- `burned_at` is honoured at the same time: a burned message is logically gone.
+drop policy if exists messages_not_expired_read on public.messages;
+create policy messages_not_expired_read
+  on public.messages
+  as restrictive
+  for select
+  to authenticated
+  using (
+    coalesce(burned_at is null, true)
+    and (expires_at is null or expires_at > now())
+  );
+
+-- ---------------------------------------------------------------------------
+-- 3. Writes: a member may only send as themselves, into a conversation they
+--    are actually in. RESTRICTIVE, so it holds regardless of existing policy.
+-- ---------------------------------------------------------------------------
+drop policy if exists messages_sender_is_member_write on public.messages;
+create policy messages_sender_is_member_write
+  on public.messages
+  as restrictive
+  for insert
+  to authenticated
+  with check (
+    sender_id = auth.uid()
+    and public.gayze_is_conversation_member(messages.conversation_id)
+  );
+
+-- Updates are limited to the sender (used to burn a message they authored).
+drop policy if exists messages_sender_owns_update on public.messages;
+create policy messages_sender_owns_update
+  on public.messages
+  as restrictive
+  for update
+  to authenticated
+  using (sender_id = auth.uid())
+  with check (sender_id = auth.uid());
+
+-- Deletes are limited to the sender. The purge routine runs as definer and is
+-- unaffected by this.
+drop policy if exists messages_sender_owns_delete on public.messages;
+create policy messages_sender_owns_delete
+  on public.messages
+  as restrictive
+  for delete
+  to authenticated
+  using (sender_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 4. Realtime: DELETE events need the full old row
+-- ---------------------------------------------------------------------------
+-- With REPLICA IDENTITY DEFAULT, a DELETE event carries only the primary key.
+-- FULL lets the client match a removal to the right conversation without a
+-- follow-up read.
+alter table public.messages replica identity full;
+
+-- Make sure the table is actually published. Guarded, because adding a table
+-- that is already published is an error.
+do $$
+begin
+  if exists (select 1 from pg_publication where pubname = 'supabase_realtime')
+     and not exists (
+       select 1
+       from pg_publication_tables
+       where pubname = 'supabase_realtime'
+         and schemaname = 'public'
+         and tablename = 'messages'
+     )
+  then
+    alter publication supabase_realtime add table public.messages;
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 5. Unread state
+-- ---------------------------------------------------------------------------
+-- One row per member per conversation, holding the last time they read it.
+-- Deliberately not a counter: counters drift under concurrent writes and cannot
+-- recover from a missed event. A timestamp is idempotent — re-stating it is
+-- safe, and a missed update self-heals on the next read.
+create table if not exists public.conversation_reads (
+  conversation_id uuid not null references public.conversations (id) on delete cascade,
+  user_id uuid not null references public.profiles (id) on delete cascade,
+  last_read_at timestamptz not null default now(),
+  primary key (conversation_id, user_id)
+);
+
+comment on table public.conversation_reads is
+  'Per-member read watermark for a conversation. Unread is computed as messages after last_read_at, so it survives missed events and multiple devices.';
+
+create index if not exists conversation_reads_user_idx
+  on public.conversation_reads (user_id, last_read_at desc);
+
+alter table public.conversation_reads enable row level security;
+
+drop policy if exists conversation_reads_select_own on public.conversation_reads;
+create policy conversation_reads_select_own
+  on public.conversation_reads
+  for select
+  to authenticated
+  using (user_id = auth.uid());
+
+drop policy if exists conversation_reads_write_own on public.conversation_reads;
+create policy conversation_reads_write_own
+  on public.conversation_reads
+  for insert
+  to authenticated
+  with check (user_id = auth.uid());
+
+drop policy if exists conversation_reads_update_own on public.conversation_reads;
+create policy conversation_reads_update_own
+  on public.conversation_reads
+  for update
+  to authenticated
+  using (user_id = auth.uid())
+  with check (user_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 5b. The conversation's default disappearing-message timer
+-- ---------------------------------------------------------------------------
+-- The UI has always offered an auto-delete setting, but it lived only in React
+-- state: reopening the app silently reverted it to "off" while the member
+-- believed their messages were expiring. The setting is now stored.
+--
+-- This is a DEFAULT for new messages, not a rule that rewrites existing ones.
+-- Each message keeps the lifetime it was sent with, visible at a glance in the
+-- thread, so changing the timer never retroactively exposes or destroys
+-- anything.
+alter table public.conversations
+  add column if not exists default_ttl_seconds integer not null default 0;
+
+alter table public.conversations
+  drop constraint if exists conversations_default_ttl_check;
+
+alter table public.conversations
+  add constraint conversations_default_ttl_check
+  check (default_ttl_seconds in (0, 10, 60, 300, 3600, 86400, 604800));
+
+comment on column public.conversations.default_ttl_seconds is
+  'Default disappearing-message lifetime for NEW messages in this conversation. 0 disables it. Existing messages keep the expires_at they were sent with.';
+
+-- Only a member may change it, and only for a conversation they belong to.
+-- RESTRICTIVE, so it narrows whatever update policy already exists.
+drop policy if exists conversations_member_updates_ttl on public.conversations;
+create policy conversations_member_updates_ttl
+  on public.conversations
+  as restrictive
+  for update
+  to authenticated
+  using (public.gayze_is_conversation_member(conversations.id))
+  with check (public.gayze_is_conversation_member(conversations.id));
+
+-- ---------------------------------------------------------------------------
+-- 5b-ii. Ensuring a permissive policy exists where the feature needs one
+-- ---------------------------------------------------------------------------
+-- This is the subtlest thing in the file, so it is worth stating plainly.
+--
+-- PostgreSQL combines policies as: (any PERMISSIVE matches) AND (all RESTRICTIVE
+-- match). If a table has RLS enabled and NO permissive policy for a command,
+-- that command is denied for everyone — and a RESTRICTIVE policy CANNOT grant
+-- access back. It only ever narrows.
+--
+-- Every policy this migration adds to `messages` and `conversations` is
+-- RESTRICTIVE, deliberately: the live permissive policies are not in this
+-- repository, and redefining a policy whose definition you cannot read risks
+-- widening access. But that means the restrictive policies are only effective
+-- if a permissive policy already exists for each command — and if one does not,
+-- the feature this migration exists to fix stays broken:
+--
+--   * no permissive UPDATE on `conversations`
+--       → the disappearing-message timer silently never saves, which is the
+--         exact bug the column below was added to fix;
+--   * no permissive SELECT/INSERT on `messages`
+--       → messaging cannot work at all.
+--
+-- So each is created ONLY when none exists. Where the live project already has
+-- one, this block does nothing and widens nothing. It never drops or replaces a
+-- policy. The NOTICE below reports exactly what it found and what it added, so
+-- the change is visible in the apply output rather than silent.
+do $$
+declare
+  v_found text[] := '{}';
+  v_added text[] := '{}';
+begin
+  if exists (select 1 from pg_policies where schemaname='public' and tablename='messages'
+             and cmd='SELECT' and permissive='PERMISSIVE') then
+    v_found := array_append(v_found, 'messages SELECT');
+  else
+    execute $ddl$create policy messages_members_read on public.messages
+      for select to authenticated
+      using (public.gayze_is_conversation_member(conversation_id))$ddl$;
+    v_added := array_append(v_added, 'messages SELECT (members only)');
+  end if;
+
+  if exists (select 1 from pg_policies where schemaname='public' and tablename='messages'
+             and cmd='INSERT' and permissive='PERMISSIVE') then
+    v_found := array_append(v_found, 'messages INSERT');
+  else
+    execute $ddl$create policy messages_members_send on public.messages
+      for insert to authenticated
+      with check (
+        sender_id = auth.uid()
+        and public.gayze_is_conversation_member(conversation_id)
+      )$ddl$;
+    v_added := array_append(v_added, 'messages INSERT (as yourself, into your own conversations)');
+  end if;
+
+  if exists (select 1 from pg_policies where schemaname='public' and tablename='messages'
+             and cmd='UPDATE' and permissive='PERMISSIVE') then
+    v_found := array_append(v_found, 'messages UPDATE');
+  else
+    -- Needed for one thing only: burning a message you sent.
+    execute $ddl$create policy messages_sender_burn on public.messages
+      for update to authenticated
+      using (sender_id = auth.uid())
+      with check (sender_id = auth.uid())$ddl$;
+    v_added := array_append(v_added, 'messages UPDATE (sender only, for burning)');
+  end if;
+
+  if exists (select 1 from pg_policies where schemaname='public' and tablename='messages'
+             and cmd='DELETE' and permissive='PERMISSIVE') then
+    v_found := array_append(v_found, 'messages DELETE');
+  else
+    execute $ddl$create policy messages_sender_delete on public.messages
+      for delete to authenticated
+      using (sender_id = auth.uid())$ddl$;
+    v_added := array_append(v_added, 'messages DELETE (sender only)');
+  end if;
+
+  if exists (select 1 from pg_policies where schemaname='public' and tablename='conversations'
+             and cmd='UPDATE' and permissive='PERMISSIVE') then
+    v_found := array_append(v_found, 'conversations UPDATE');
+  else
+    execute $ddl$create policy conversations_members_update on public.conversations
+      for update to authenticated
+      using (public.gayze_is_conversation_member(id))
+      with check (public.gayze_is_conversation_member(id))$ddl$;
+    v_added := array_append(v_added, 'conversations UPDATE (members only, for the timer)');
+  end if;
+
+  raise notice 'GAYZE messaging: permissive policies already present → %', coalesce(array_to_string(v_found, ', '), '(none)');
+  if array_length(v_added, 1) > 0 then
+    raise notice 'GAYZE messaging: created the missing permissive policies → %', array_to_string(v_added, ', ');
+  else
+    raise notice 'GAYZE messaging: no permissive policy was needed; the existing set was left untouched.';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 5c. Grants
+-- ---------------------------------------------------------------------------
+-- Supabase projects usually carry default privileges that grant new tables to
+-- anon/authenticated automatically. Depending on that is how a migration works
+-- in one project and fails closed in another, so the privileges this feature
+-- needs are stated explicitly.
+--
+-- `anon` is deliberately granted NOTHING: there is no anonymous messaging
+-- surface, and the absence of a grant is a second barrier behind RLS.
+grant select, insert, update on public.conversation_reads to authenticated;
+grant all on public.conversation_reads to service_role;
+
+-- ---------------------------------------------------------------------------
+-- 6. RPCs
+-- ---------------------------------------------------------------------------
+
+-- Unread counts for every conversation the caller belongs to, in one round trip.
+-- Counts only messages the caller can actually read (not their own, not
+-- expired, not burned) so the badge can never point at invisible content.
+create or replace function public.conversation_unread_counts()
+returns table (conversation_id uuid, unread_count bigint, last_message_at timestamptz)
+language sql
+stable
+security invoker
+set search_path = public, pg_temp
+as $$
+  select
+    m.conversation_id,
+    count(msg.id) filter (
+      where msg.sender_id <> auth.uid()
+        and msg.burned_at is null
+        and (msg.expires_at is null or msg.expires_at > now())
+        and msg.created_at > coalesce(r.last_read_at, 'epoch'::timestamptz)
+    ) as unread_count,
+    max(msg.created_at) as last_message_at
+  from public.conversation_members m
+  left join public.conversation_reads r
+    on r.conversation_id = m.conversation_id
+   and r.user_id = m.user_id
+  left join public.messages msg
+    on msg.conversation_id = m.conversation_id
+  where m.user_id = auth.uid()
+  group by m.conversation_id;
+$$;
+
+revoke all on function public.conversation_unread_counts() from public;
+grant execute on function public.conversation_unread_counts() to authenticated;
+
+-- Move the read watermark forward. Never backwards: a stale device reporting an
+-- older timestamp must not resurrect unread messages on another device.
+create or replace function public.mark_conversation_read(p_conversation_id uuid, p_read_at timestamptz default now())
+returns boolean
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    return false;
+  end if;
+
+  -- Membership is required. The RLS policy on conversation_reads already
+  -- enforces ownership; this makes the failure explicit rather than silent.
+  if not exists (
+    select 1 from public.conversation_members
+    where conversation_id = p_conversation_id and user_id = v_user_id
+  ) then
+    return false;
+  end if;
+
+  insert into public.conversation_reads (conversation_id, user_id, last_read_at)
+  values (p_conversation_id, v_user_id, coalesce(p_read_at, now()))
+  on conflict (conversation_id, user_id)
+  do update set last_read_at = greatest(public.conversation_reads.last_read_at, excluded.last_read_at);
+
+  return true;
+end;
+$$;
+
+revoke all on function public.mark_conversation_read(uuid, timestamptz) from public;
+grant execute on function public.mark_conversation_read(uuid, timestamptz) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 7. Server-side cleanup
+-- ---------------------------------------------------------------------------
+-- The client is never the thing that deletes expired content. This routine is
+-- the authority. It is written to be safe to call from pg_cron, from a Supabase
+-- scheduled function, or manually.
+create or replace function public.purge_expired_messages(p_grace interval default interval '1 hour')
+returns integer
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_deleted integer;
+begin
+  -- The grace window keeps a just-expired message around briefly so a client
+  -- that is mid-read can settle, while still guaranteeing eventual removal.
+  delete from public.messages
+  where expires_at is not null
+    and expires_at < now() - p_grace;
+
+  get diagnostics v_deleted = row_count;
+  return v_deleted;
+end;
+$$;
+
+revoke all on function public.purge_expired_messages(interval) from public;
+-- Deliberately not granted to `authenticated`: cleanup is server-side only.
+-- It IS granted to service_role, because the scheduled caller runs as it and a
+-- revoke without a matching grant would leave the job unable to run at all.
+grant execute on function public.purge_expired_messages(interval) to service_role;
+
+do $$
+begin
+  if exists (select 1 from pg_extension where extname = 'pg_cron') then
+    begin
+      perform cron.unschedule('gayze-purge-expired-messages');
+    exception when others then
+      null; -- no existing job; nothing to unschedule
+    end;
+    perform cron.schedule(
+      'gayze-purge-expired-messages',
+      '*/15 * * * *',
+      $cron$select public.purge_expired_messages();$cron$
+    );
+    raise notice 'GAYZE: scheduled purge_expired_messages every 15 minutes.';
+  else
+    raise notice 'GAYZE: pg_cron is not enabled. Schedule public.purge_expired_messages() externally (Supabase Scheduled Edge Function or a cron worker) every 15 minutes.';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 8. Rollback notes
+-- ---------------------------------------------------------------------------
+-- This migration only adds. To reverse it:
+--   drop policy messages_not_expired_read on public.messages;   -- and the other
+--   drop policy ...;                                            -- three policies
+--   drop function public.conversation_unread_counts();
+--   drop function public.mark_conversation_read(uuid, timestamptz);
+--   drop function public.purge_expired_messages(interval);
+--   drop table public.conversation_reads;
+--   drop index public.messages_sender_client_id_key;            -- etc.
+--   alter table public.messages replica identity default;
+--   alter table public.messages drop column client_id;
+--   alter table public.conversations drop column default_ttl_seconds;     -- 5b
+--   -- 5b-ii: drop only the policies this block actually created. The NOTICE
+--   -- in the apply output names which those were; anything already present was
+--   -- left alone and must not be dropped by this rollback.
+--   drop policy if exists messages_members_read   on public.messages;
+--   drop policy if exists messages_members_send   on public.messages;
+--   drop policy if exists messages_sender_burn    on public.messages;
+--   drop policy if exists messages_sender_delete  on public.messages;
+--   drop policy if exists conversations_members_update on public.conversations;
+-- No existing message data is modified or deleted by this migration.
diff --git a/supabase/migrations/20260928140000_call_signalling.sql b/supabase/migrations/20260928140000_call_signalling.sql
new file mode 100644
index 0000000..c243ce4
--- /dev/null
+++ b/supabase/migrations/20260928140000_call_signalling.sql
@@ -0,0 +1,521 @@
+-- ============================================================================
+-- GAYZE — call signalling: persisted, authorised, recoverable
+-- ============================================================================
+-- Why this exists
+-- ---------------
+-- The previous implementation signalled entirely over Supabase Realtime
+-- *broadcast*. Broadcast is fire-and-forget: if the callee's socket is not
+-- joined at that instant — which is the normal state on iOS when the app has
+-- been backgrounded, or during any socket reconnect — the call-request, the SDP
+-- offer and the ICE candidates are all silently discarded. Nothing is stored,
+-- so nothing can be recovered, and the caller sits in "calling" until it times
+-- out. Worse, broadcast channels carry no authorisation: anyone who knows a
+-- conversation id can publish signals into it.
+--
+-- This migration replaces that with a small, durable signalling plane:
+--
+--   calls         one row per call attempt, with an authoritative state machine
+--   call_signals  the SDP and ICE messages, persisted and consumed in order
+--
+-- Both are protected by RLS: only the two participants can see or write them,
+-- and a participant can only write signals as themselves. Clients still use
+-- Realtime (postgres_changes) for latency, but they also drain unconsumed
+-- signals on join, so a dropped socket delays a call instead of losing it.
+--
+-- TURN credentials are minted server-side (coturn REST scheme) so no static
+-- TURN password ever reaches the browser bundle.
+--
+-- Safe to run more than once.
+-- ============================================================================
+
+create extension if not exists pgcrypto;
+
+-- ---------------------------------------------------------------------------
+-- 1. Server-held secrets
+-- ---------------------------------------------------------------------------
+-- RLS enabled with NO policies: unreadable and unwritable through the API by
+-- anon or authenticated roles. Only SECURITY DEFINER functions and the service
+-- role can touch it.
+create table if not exists public.app_secrets (
+  key text primary key,
+  value text not null,
+  updated_at timestamptz not null default now()
+);
+
+alter table public.app_secrets enable row level security;
+
+comment on table public.app_secrets is
+  'Server-side secrets (e.g. the TURN shared secret). RLS is enabled with no policies, so it is unreachable through the API; only SECURITY DEFINER functions may read it.';
+
+-- The operator sets this once:
+--   insert into public.app_secrets (key, value)
+--   values ('turn_shared_secret', '<coturn static-auth-secret>')
+--   on conflict (key) do update set value = excluded.value, updated_at = now();
+do $$
+begin
+  if not exists (select 1 from public.app_secrets where key = 'turn_shared_secret') then
+    raise notice 'GAYZE: app_secrets.turn_shared_secret is not set. get_turn_credentials() will return no relay and calls will fall back to STUN only (direct connections only).';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 2. calls
+-- ---------------------------------------------------------------------------
+create table if not exists public.calls (
+  id uuid primary key default gen_random_uuid(),
+  conversation_id uuid not null references public.conversations (id) on delete cascade,
+  caller_id uuid not null references public.profiles (id) on delete cascade,
+  callee_id uuid not null references public.profiles (id) on delete cascade,
+  kind text not null default 'audio',
+  state text not null default 'ringing',
+  created_at timestamptz not null default now(),
+  answered_at timestamptz,
+  ended_at timestamptz,
+  ended_reason text,
+  last_heartbeat_at timestamptz not null default now(),
+  constraint calls_kind_check check (kind in ('audio', 'video')),
+  constraint calls_state_check check (
+    state in ('ringing', 'accepted', 'connected', 'ended', 'declined', 'missed', 'failed')
+  ),
+  constraint calls_distinct_participants check (caller_id <> callee_id)
+);
+
+comment on table public.calls is
+  'One row per call attempt. `state` is the authoritative call state machine; clients render it and may request transitions, but only the server rules decide terminal states.';
+
+-- At most one live call per conversation, enforced by the database rather than
+-- by client etiquette. This is what stops two devices racing into a second call
+-- while the first is still ringing.
+create unique index if not exists calls_one_live_per_conversation
+  on public.calls (conversation_id)
+  where state in ('ringing', 'accepted', 'connected');
+
+create index if not exists calls_caller_idx on public.calls (caller_id, created_at desc);
+create index if not exists calls_callee_idx on public.calls (callee_id, created_at desc);
+
+alter table public.calls enable row level security;
+
+-- Participants only, in both directions.
+drop policy if exists calls_participants_select on public.calls;
+create policy calls_participants_select
+  on public.calls
+  for select
+  to authenticated
+  using (caller_id = auth.uid() or callee_id = auth.uid());
+
+-- You may only open a call as yourself, to a member you actually share a
+-- conversation with. The membership check is the authorisation: having a
+-- conversation id is not enough.
+drop policy if exists calls_caller_insert on public.calls;
+create policy calls_caller_insert
+  on public.calls
+  for insert
+  to authenticated
+  with check (
+    caller_id = auth.uid()
+    and callee_id <> auth.uid()
+    and public.gayze_is_conversation_member(calls.conversation_id)
+    and exists (
+      -- The callee must be a member too: holding a conversation id is not
+      -- enough to ring somebody who is not in that conversation.
+      select 1 from public.conversation_members them
+      where them.conversation_id = calls.conversation_id
+        and them.user_id = calls.callee_id
+    )
+  );
+
+drop policy if exists calls_participants_update on public.calls;
+create policy calls_participants_update
+  on public.calls
+  for update
+  to authenticated
+  using (caller_id = auth.uid() or callee_id = auth.uid())
+  with check (caller_id = auth.uid() or callee_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 3. call_signals
+-- ---------------------------------------------------------------------------
+create table if not exists public.call_signals (
+  id bigserial primary key,
+  call_id uuid not null references public.calls (id) on delete cascade,
+  sender_id uuid not null references public.profiles (id) on delete cascade,
+  kind text not null,
+  payload jsonb,
+  created_at timestamptz not null default now(),
+  constraint call_signals_kind_check check (kind in ('offer', 'answer', 'ice', 'renegotiate')),
+  -- An offer/answer with no SDP, or ICE with no candidate, is malformed and
+  -- would only produce a confusing failure later.
+  constraint call_signals_payload_check check (
+    (kind in ('offer', 'answer', 'renegotiate') and payload ? 'sdp')
+    or (kind = 'ice' and payload ? 'candidate')
+  )
+);
+
+create index if not exists call_signals_call_idx on public.call_signals (call_id, id);
+
+alter table public.call_signals enable row level security;
+
+-- Only the two participants of the parent call can read its signals.
+drop policy if exists call_signals_participants_select on public.call_signals;
+create policy call_signals_participants_select
+  on public.call_signals
+  for select
+  to authenticated
+  using (
+    exists (
+      select 1 from public.calls c
+      where c.id = call_signals.call_id
+        and (c.caller_id = auth.uid() or c.callee_id = auth.uid())
+    )
+  );
+
+-- You may only append signals as yourself, into a call you are part of. This is
+-- what stops a third party who has guessed a call id from injecting an SDP.
+drop policy if exists call_signals_participant_insert on public.call_signals;
+create policy call_signals_participant_insert
+  on public.call_signals
+  for insert
+  to authenticated
+  with check (
+    sender_id = auth.uid()
+    and exists (
+      select 1 from public.calls c
+      where c.id = call_signals.call_id
+        and (c.caller_id = auth.uid() or c.callee_id = auth.uid())
+    )
+  );
+
+-- Signals are append-only: no update or delete policy is defined, so the API
+-- cannot rewrite a negotiation in flight. The purge routine below removes them
+-- as a definer.
+
+-- ---------------------------------------------------------------------------
+-- 4. Realtime
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  t text;
+begin
+  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then
+    foreach t in array array['calls', 'call_signals'] loop
+      if not exists (
+        select 1 from pg_publication_tables
+        where pubname = 'supabase_realtime' and schemaname = 'public' and tablename = t
+      ) then
+        execute format('alter publication supabase_realtime add table public.%I', t);
+      end if;
+    end loop;
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 5. RPCs — the call state machine
+-- ---------------------------------------------------------------------------
+
+-- Open a call. Refuses when either party is already in a live call, so two
+-- devices cannot race the same person, and returns the existing call id when
+-- this exact attempt already exists (idempotent for retries).
+create or replace function public.start_call(
+  p_conversation_id uuid,
+  p_callee_id uuid,
+  p_kind text default 'audio'
+)
+returns public.calls
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_row public.calls;
+begin
+  if v_user_id is null then
+    return null;
+  end if;
+
+  if p_kind not in ('audio', 'video') then
+    raise exception 'unsupported call kind' using errcode = '22023';
+  end if;
+
+  if exists (
+    select 1 from public.calls c
+    where c.state in ('ringing', 'accepted', 'connected')
+      and (c.caller_id in (v_user_id, p_callee_id) or c.callee_id in (v_user_id, p_callee_id))
+  ) then
+    raise exception 'participant is already in a call' using errcode = '55006';
+  end if;
+
+  insert into public.calls (conversation_id, caller_id, callee_id, kind, state)
+  values (p_conversation_id, v_user_id, p_callee_id, p_kind, 'ringing')
+  returning * into v_row;
+
+  return v_row;
+end;
+$$;
+
+-- Transition a call. Only sensible transitions are accepted, and only by a
+-- participant. Terminal states are final.
+create or replace function public.update_call_state(
+  p_call_id uuid,
+  p_state text,
+  p_reason text default null
+)
+returns public.calls
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_row public.calls;
+begin
+  if v_user_id is null then
+    return null;
+  end if;
+
+  select * into v_row
+  from public.calls
+  where id = p_call_id
+    and (caller_id = v_user_id or callee_id = v_user_id)
+  for update;
+
+  if not found then
+    return null;
+  end if;
+
+  if v_row.state in ('ended', 'declined', 'missed', 'failed') then
+    return v_row; -- already terminal; ignore late transitions
+  end if;
+
+  if p_state not in ('ringing', 'accepted', 'connected', 'ended', 'declined', 'missed', 'failed') then
+    raise exception 'unsupported call state' using errcode = '22023';
+  end if;
+
+  update public.calls
+  set state = p_state,
+      answered_at = case when p_state = 'accepted' and answered_at is null then now() else answered_at end,
+      ended_at = case when p_state in ('ended', 'declined', 'missed', 'failed') then now() else ended_at end,
+      ended_reason = case when p_state in ('ended', 'declined', 'missed', 'failed') then coalesce(p_reason, p_state) else ended_reason end,
+      last_heartbeat_at = now()
+  where id = p_call_id
+  returning * into v_row;
+
+  return v_row;
+end;
+$$;
+
+-- Keep-alive from both clients. A call whose participants stop reporting is
+-- ended by expire_stale_calls(), which is how a vanished peer (crash, tunnel,
+-- iOS suspension) becomes a definite "call ended" on the other side.
+create or replace function public.touch_call(p_call_id uuid)
+returns boolean
+language plpgsql
+security invoker
+set search_path = public, pg_temp
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_updated integer;
+begin
+  if v_user_id is null then
+    return false;
+  end if;
+
+  update public.calls
+  set last_heartbeat_at = now()
+  where id = p_call_id
+    and (caller_id = v_user_id or callee_id = v_user_id)
+    and state in ('ringing', 'accepted', 'connected');
+
+  get diagnostics v_updated = row_count;
+  return v_updated > 0;
+end;
+$$;
+
+-- The live call the caller is part of, if any. Used on sign-in and on
+-- foreground to recover a call the client slept through.
+-- `returns setof`, not `returns public.calls`.
+--
+-- A non-SETOF composite-returning function always yields exactly one row, so
+-- "no active call" arrives as a row of NULLs rather than an empty result, and a
+-- caller checking `data?.id` would have to special-case it. `setof` returns
+-- zero rows, which is unambiguous. The DROP is required because a changed
+-- return type cannot be replaced in place, and it makes re-running this file
+-- safe.
+drop function if exists public.get_active_call();
+
+create or replace function public.get_active_call()
+returns setof public.calls
+language sql
+stable
+security invoker
+set search_path = public, pg_temp
+as $$
+  select *
+  from public.calls
+  where state in ('ringing', 'accepted', 'connected')
+    and (caller_id = auth.uid() or callee_id = auth.uid())
+  order by created_at desc
+  limit 1;
+$$;
+
+revoke all on function public.start_call(uuid, uuid, text) from public;
+revoke all on function public.update_call_state(uuid, text, text) from public;
+revoke all on function public.touch_call(uuid) from public;
+revoke all on function public.get_active_call() from public;
+grant execute on function public.start_call(uuid, uuid, text) to authenticated;
+grant execute on function public.update_call_state(uuid, text, text) to authenticated;
+grant execute on function public.touch_call(uuid) to authenticated;
+grant execute on function public.get_active_call() to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 6. Maintenance: expire stale calls and purge old signals
+-- ---------------------------------------------------------------------------
+create or replace function public.expire_stale_calls(
+  p_ring_timeout interval default interval '50 seconds',
+  p_heartbeat_timeout interval default interval '45 seconds'
+)
+returns integer
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_affected integer := 0;
+  v_n integer;
+begin
+  -- Never answered.
+  update public.calls
+  set state = 'missed', ended_at = now(), ended_reason = 'no answer'
+  where state = 'ringing'
+    and created_at < now() - p_ring_timeout;
+  get diagnostics v_n = row_count;
+  v_affected := v_affected + v_n;
+
+  -- Answered, then both sides went quiet.
+  update public.calls
+  set state = 'ended', ended_at = now(), ended_reason = 'connection lost'
+  where state in ('accepted', 'connected')
+    and last_heartbeat_at < now() - p_heartbeat_timeout;
+  get diagnostics v_n = row_count;
+  v_affected := v_affected + v_n;
+
+  -- Signalling rows for finished calls are dead weight; keep a short window so
+  -- a late-joining participant can still drain a final offer.
+  delete from public.call_signals s
+  using public.calls c
+  where s.call_id = c.id
+    and c.state in ('ended', 'declined', 'missed', 'failed')
+    and c.ended_at < now() - interval '10 minutes';
+
+  return v_affected;
+end;
+$$;
+
+revoke all on function public.expire_stale_calls(interval, interval) from public;
+
+do $$
+begin
+  if exists (select 1 from pg_extension where extname = 'pg_cron') then
+    begin
+      perform cron.unschedule('gayze-expire-stale-calls');
+    exception when others then
+      null;
+    end;
+    perform cron.schedule(
+      'gayze-expire-stale-calls',
+      '* * * * *',
+      $cron$select public.expire_stale_calls();$cron$
+    );
+    raise notice 'GAYZE: scheduled expire_stale_calls every minute.';
+  else
+    raise notice 'GAYZE: pg_cron is not enabled. Schedule public.expire_stale_calls() externally every minute.';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 6b. Grants
+-- ---------------------------------------------------------------------------
+-- Without these a stock project returns "permission denied for table calls"
+-- before RLS is ever consulted, and the call feature is dead on arrival.
+grant select, insert, update on public.calls to authenticated;
+grant select, insert on public.call_signals to authenticated;
+
+-- call_signals.id is a bigserial: inserting requires USAGE on its sequence,
+-- which a table-level grant does not provide. This is the classic omission.
+grant usage, select on sequence public.call_signals_id_seq to authenticated;
+
+grant all on public.calls, public.call_signals to service_role;
+grant all on sequence public.call_signals_id_seq to service_role;
+
+-- app_secrets gets NO grant to anyone. RLS is enabled with no policies, so it
+-- is already unreachable through the API; withholding the grant means a future
+-- policy mistake alone cannot expose it. Only the SECURITY DEFINER functions
+-- and a superuser can read it.
+
+-- The maintenance routines are invoked by the scheduler as service_role.
+grant execute on function public.expire_stale_calls(interval, interval) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- 7. TURN credentials, minted server-side
+-- ---------------------------------------------------------------------------
+-- Implements the coturn REST scheme: a short-lived username of the form
+-- "<unix-expiry>:<user-id>" and an HMAC-SHA1 of that username keyed by the
+-- shared secret. The client never sees the secret, and a leaked credential is
+-- useless within minutes.
+--
+-- Returns an empty set when TURN is not configured, which the client reports
+-- honestly instead of pretending relay connectivity exists.
+create or replace function public.get_turn_credentials(p_ttl_seconds integer default 3600)
+returns table (urls text, username text, credential text, ttl_seconds integer)
+language plpgsql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_secret text;
+  v_user uuid := auth.uid();
+  v_expiry bigint;
+  v_username text;
+begin
+  if v_user is null then
+    return;
+  end if;
+
+  select value into v_secret from public.app_secrets where key = 'turn_shared_secret';
+  if v_secret is null or length(v_secret) = 0 then
+    return; -- TURN not configured
+  end if;
+
+  v_expiry := extract(epoch from (now() + make_interval(secs => greatest(60, least(p_ttl_seconds, 86400)))))::bigint;
+  v_username := v_expiry::text || ':' || v_user::text;
+
+  return query
+    select
+      (select value from public.app_secrets where key = 'turn_urls') as urls,
+      v_username,
+      encode(hmac(v_username, v_secret, 'sha1'), 'base64'),
+      (v_expiry - extract(epoch from now())::bigint)::integer;
+end;
+$$;
+
+revoke all on function public.get_turn_credentials(integer) from public;
+grant execute on function public.get_turn_credentials(integer) to authenticated;
+
+-- ---------------------------------------------------------------------------
+-- 8. Rollback notes
+-- ---------------------------------------------------------------------------
+--   drop function public.get_turn_credentials(integer);
+--   drop function public.expire_stale_calls(interval, interval);
+--   drop function public.get_active_call();

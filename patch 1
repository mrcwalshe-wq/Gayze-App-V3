@@ -0,0 +1,81 @@
+import React, { useEffect, useState } from 'react';
+import { ProfileAlbum } from './ProfileAlbum';
+import { PhotoViewer } from './PhotoViewer';
+import { loadProfilePhotos } from '../services/profilePhotoService';
+import type { ProfilePhoto } from '../services/profilePhotoService';
+
+interface MemberPhotoRailProps {
+  /** Member's user id. Null/undefined renders nothing. */
+  userId?: string | null;
+  name: string;
+  /** Optional label above the rail; omitted inside tight sheets. */
+  label?: string;
+}
+
+/**
+ * Another member's photos, view-only.
+ *
+ * This is the other-user half of the profile presentation model: it reuses the
+ * same album and viewer as the owner's Profile (no second photo implementation),
+ * and is deliberately read-only — no upload, reorder or set-primary affordances
+ * exist on this path.
+ *
+ * Loading is gated by the same RLS rule as everything else, so a member you are
+ * not allowed to see simply returns no rows and the rail renders nothing at all
+ * rather than a broken frame.
+ */
+export const MemberPhotoRail: React.FC<MemberPhotoRailProps> = ({ userId, name, label }) => {
+  const [photos, setPhotos] = useState<ProfilePhoto[]>([]);
+  const [viewerIndex, setViewerIndex] = useState<number | null>(null);
+
+  useEffect(() => {
+    if (!userId) {
+      setPhotos([]);
+      return;
+    }
+    let cancelled = false;
+    void loadProfilePhotos(userId).then((result) => {
+      if (cancelled) return;
+      // An unavailable library or a refused read both mean "nothing to show".
+      // Neither is an error the viewer needs to act on.
+      setPhotos(result.ok ? result.photos : []);
+    });
+    return () => {
+      cancelled = true;
+      setPhotos([]);
+    };
+  }, [userId]);
+
+  if (!userId || photos.length === 0) return null;
+
+  const ordered = [...photos].sort((a, b) => {
+    if (a.isPrimary !== b.isPrimary) return a.isPrimary ? -1 : 1;
+    if (a.sortOrder !== b.sortOrder) return a.sortOrder - b.sortOrder;
+    return a.createdAt.localeCompare(b.createdAt);
+  });
+
+  return (
+    <div>
+      {label && <span className="g-label">{label}</span>}
+      <div className={label ? 'mt-2.5' : undefined}>
+        <ProfileAlbum
+          photos={ordered}
+          name={name}
+          editable={false}
+          variant="rail"
+          onOpenViewer={(index) => setViewerIndex(index)}
+        />
+      </div>
+
+      {viewerIndex !== null && (
+        <PhotoViewer
+          photos={ordered}
+          index={Math.min(viewerIndex, ordered.length - 1)}
+          name={name}
+          onIndexChange={setViewerIndex}
+          onClose={() => setViewerIndex(null)}
+        />
+      )}
+    </div>
+  );
+};
diff --git a/src/attic/PhotoViewer.tsx b/src/attic/PhotoViewer.tsx

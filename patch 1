@@ -0,0 +1,84 @@
+import { useCallback, useEffect, useState } from 'react';
+import { getProfilePhotoUrl } from '../services/profilePhotoService';
+
+/**
+ * True when the value is a private-bucket path that needs signing rather than a
+ * URL that can be used directly. `getProfilePhotoUrl` resolves both, so this is
+ * only used to decide whether a surface is still waiting for an image.
+ */
+function isStoragePath(value?: string | null): boolean {
+  if (!value) return false;
+  return !(
+    value.startsWith('http://')
+    || value.startsWith('https://')
+    || value.startsWith('data:image/')
+    || value === 'user'
+  );
+}
+
+export interface SignedPhotoUrlState {
+  /** Signed URL for the private object, or null when there is nothing to show. */
+  url: string | null;
+  /** True while the first resolution is in flight. */
+  loading: boolean;
+  /** True when a path was supplied but no URL could be produced. */
+  failed: boolean;
+  /** Re-resolve, e.g. after a signed URL expired while the surface stayed open. */
+  retry: () => void;
+}
+
+/**
+ * Resolves a private-bucket storage path into a short-lived signed URL.
+ *
+ * The path never reaches the DOM — only the resolved URL does — and resolution
+ * is shared through the service cache, so rendering the same member in a list
+ * twice costs one Storage request.
+ */
+function isDirectImageUrl(value?: string | null): boolean {
+  return Boolean(value && (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('data:image/')));
+}
+
+export function useSignedPhotoUrl(path?: string | null): SignedPhotoUrlState {
+  const [url, setUrl] = useState<string | null>(null);
+  const [loading, setLoading] = useState<boolean>(isStoragePath(path));
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    // Local/demo fixtures carry plain URLs; those are used as-is. A private
+    // bucket path is signed. Anything else renders no image at all.
+    if (isDirectImageUrl(path)) {
+      setUrl(path as string);
+      setLoading(false);
+      setFailed(false);
+      return;
+    }
+
+    if (!isStoragePath(path)) {
+      setUrl(null);
+      setLoading(false);
+      setFailed(false);
+      return;
+    }
+
+    setLoading(true);
+    setFailed(false);
+
+    void getProfilePhotoUrl(path).then((resolved) => {
+      if (cancelled) return;
+      setUrl(resolved);
+      setFailed(resolved === null);
+      setLoading(false);
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [path, attempt]);
+
+  const retry = useCallback(() => setAttempt((value) => value + 1), []);
+
+  return { url, loading, failed, retry };
+}

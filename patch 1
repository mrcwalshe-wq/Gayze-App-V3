@@ -0,0 +1,104 @@
+/**
+ * The chat-attachment size budget, pinned against the real constraint.
+ *
+ * A chat image does not travel as an image. It travels as a data URL inside the
+ * encrypted message body, and the encoding chain expands it roughly 2.67x:
+ * base64 (+4/3), a JSON envelope, an AES-GCM tag, and finally HEX (+2, the
+ * expensive step).
+ *
+ * Supabase's Postgres Changes payload limit is 1,024 KB on every plan. When a
+ * payload exceeds it the service does NOT error — it drops the fields whose
+ * value is larger than 64 bytes. So an oversized attachment arrives at the
+ * recipient with `ciphertext` missing: a message that appears to send and
+ * silently never arrives.
+ *
+ * An earlier revision of this code guessed a 2 MB ceiling. Measured, that
+ * produces a 4.19 MB ciphertext and an 8.39 MB UPDATE payload — 8x over the
+ * limit. These tests compute the real numbers so the budget cannot drift back
+ * over the boundary through a well-meaning edit.
+ */
+
+import { describe, expect, it } from 'vitest';
+import { CHAT_ATTACHMENT_MAX_DATA_URL_CHARS } from './imageEncoding';
+
+/** Supabase's Postgres Changes payload limit: 1,024 KB, every plan. */
+const REALTIME_PAYLOAD_LIMIT_BYTES = 1024 * 1024;
+
+/**
+ * Mirrors the storage encoding in `cryptoService`:
+ * AES-GCM ciphertext, hex-encoded — two characters per byte.
+ */
+async function storedCiphertextLength(bodyChars: number): Promise<number> {
+  const key = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt']);
+  const nonce = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = await crypto.subtle.encrypt(
+    { name: 'AES-GCM', iv: nonce, tagLength: 128 },
+    key,
+    new TextEncoder().encode('x'.repeat(bodyChars)),
+  );
+  return (ciphertext.byteLength * 2); // hex
+}
+
+describe('a chat attachment cannot exceed the Realtime payload limit', () => {
+  it('the budget keeps an UPDATE payload inside the limit', async () => {
+    // The realistic worst case for the budget: a body at the full data URL
+    // allowance, plus the JSON envelope.
+    const envelope = JSON.stringify({ text: '', mediaUrl: '' }).length; // ~28
+    const bodyChars = CHAT_ATTACHMENT_MAX_DATA_URL_CHARS + envelope;
+    const ciphertext = await storedCiphertextLength(bodyChars);
+    const rowBytes = ciphertext + 120; // ids, timestamps, nonce
+
+    // REPLICA IDENTITY FULL means an UPDATE carries old AND new.
+    const updatePayload = rowBytes * 2;
+
+    expect(
+      updatePayload,
+      `an UPDATE payload of ${updatePayload} bytes exceeds the ${REALTIME_PAYLOAD_LIMIT_BYTES}-byte limit, ` +
+        'at which point Supabase drops the ciphertext field instead of erroring',
+    ).toBeLessThan(REALTIME_PAYLOAD_LIMIT_BYTES);
+  });
+
+  it('leaves meaningful headroom rather than sitting on the boundary', async () => {
+    const bodyChars = CHAT_ATTACHMENT_MAX_DATA_URL_CHARS + 30;
+    const rowBytes = (await storedCiphertextLength(bodyChars)) + 120;
+    const usage = (rowBytes * 2) / REALTIME_PAYLOAD_LIMIT_BYTES;
+
+    // At least 15% headroom, so a change to any other column, to the envelope,
+    // or to the entropy of a particular image cannot tip it over.
+    expect(usage, `the budget uses ${(usage * 100).toFixed(1)}% of the limit`).toBeLessThan(0.85);
+  });
+
+  it('the shipped size — 2 MB — would have been rejected by this test', async () => {
+    // The guarantee that this test would have caught the original defect.
+    const previousCeiling = 2 * 1024 * 1024;
+    const bodyChars = previousCeiling + 30;
+    const rowBytes = (await storedCiphertextLength(bodyChars)) + 120;
+    const updatePayload = rowBytes * 2;
+
+    expect(
+      updatePayload,
+      'the previous ceiling must fail this assertion, or the test proves nothing',
+    ).toBeGreaterThan(REALTIME_PAYLOAD_LIMIT_BYTES);
+    // Measured at roughly 8x over, which is worth stating in the failure output.
+    expect(updatePayload / REALTIME_PAYLOAD_LIMIT_BYTES).toBeGreaterThan(4);
+  });
+
+  it('a plain image fits easily, so the cap is not absurdly tight', async () => {
+    // A 60 KB image is an ordinary downscaled phone photo. It must pass with
+    // room to spare, or the cap would reject normal use.
+    const imageBytes = 60_000;
+    const dataUrlChars = Math.ceil((imageBytes / 3) * 4) + 23;
+    expect(dataUrlChars).toBeLessThan(CHAT_ATTACHMENT_MAX_DATA_URL_CHARS);
+
+    const rowBytes = (await storedCiphertextLength(dataUrlChars + 30)) + 120;
+    expect((rowBytes * 2) / REALTIME_PAYLOAD_LIMIT_BYTES).toBeLessThan(0.5);
+  });
+
+  it('the budget corresponds to a usable image size', () => {
+    // Documents the real product constraint rather than hiding it: the largest
+    // image that can be sent inline is roughly 140 KB.
+    const maxImageBytes = Math.floor(((CHAT_ATTACHMENT_MAX_DATA_URL_CHARS - 23) / 4) * 3);
+    expect(maxImageBytes).toBeGreaterThan(100_000);
+    expect(maxImageBytes).toBeLessThan(200_000);
+  });
+});

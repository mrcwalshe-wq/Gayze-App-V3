+/**
+ * iOS audio unlock.
+ *
+ * The previous implementation constructed a fresh `AudioContext` inside
+ * `notifySound()`, every time it played. iOS will not start an AudioContext
+ * outside a user gesture, and one created later is born suspended, so every
+ * chime was dropped and notification sound was silent on every iPhone.
+ *
+ * The fix is a single shared context, primed from the first real interaction.
+ * These tests pin the properties that make it work, using a fake AudioContext
+ * so the behaviour is observed rather than assumed.
+ *
+ * The context is a module-level singleton, so each test re-imports the module.
+ * Sharing one across tests would mean the first test to prime it decided what
+ * every later test saw, which is exactly the kind of coupling that makes a
+ * suite pass for the wrong reason.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+class FakeAudioContext {
+  state: 'suspended' | 'running' | 'closed';
+  currentTime = 0;
+  oscillators = 0;
+  resumes = 0;
+  closes = 0;
+
+  constructor() {
+    if (FakeAudioContext.throwOnConstruct) throw new Error('audio is unavailable');
+    this.state = FakeAudioContext.initialState;
+    FakeAudioContext.instances.push(this);
+  }
+
+  static instances: FakeAudioContext[] = [];
+  static initialState: 'suspended' | 'running' = 'suspended';
+  static throwOnConstruct = false;
+
+  resume() {
+    this.resumes += 1;
+    this.state = 'running';
+    return Promise.resolve();
+  }
+
+  close() {
+    this.closes += 1;
+    this.state = 'closed';
+    return Promise.resolve();
+  }
+
+  createOscillator() {
+    this.oscillators += 1;
+    return {
+      type: 'sine',
+      frequency: { value: 0 },
+      connect: () => undefined,
+      start: () => undefined,
+      stop: () => undefined,
+    };
+  }
+
+  createGain() {
+    return {
+      gain: {
+        setValueAtTime: () => undefined,
+        exponentialRampToValueAtTime: () => undefined,
+      },
+      connect: () => undefined,
+    };
+  }
+}
+
+vi.stubGlobal('navigator', { userAgent: 'vitest', onLine: true });
+// soundEnabled defaults to true, so the stub returns null and the module's own
+// defaults apply — the state a fresh install is in.
+vi.stubGlobal('localStorage', { getItem: () => null, setItem: () => undefined });
+vi.stubGlobal('window', {
+  matchMedia: () => ({ matches: false }),
+  AudioContext: FakeAudioContext,
+});
+
+/** A fresh module, and therefore a fresh singleton, for each test. */
+async function loadAudio() {
+  vi.resetModules();
+  return import('./notificationService');
+}
+
+describe('the shared audio context on iOS', () => {
+  beforeEach(() => {
+    FakeAudioContext.instances = [];
+    FakeAudioContext.initialState = 'suspended';
+    FakeAudioContext.throwOnConstruct = false;
+  });
+
+  it('builds exactly one context however many times it is primed', async () => {
+    const { primeAudio } = await loadAudio();
+    primeAudio();
+    primeAudio();
+    primeAudio();
+    expect(FakeAudioContext.instances.length, 'each call built another context').toBe(1);
+  });
+
+  it('resumes a suspended context when the user interacts', async () => {
+    const { primeAudio } = await loadAudio();
+    primeAudio();
+    const [context] = FakeAudioContext.instances;
+    expect(context.resumes, 'a suspended context was never resumed').toBe(1);
+    expect(context.state).toBe('running');
+  });
+
+  it('does not re-resume a context that is already running', async () => {
+    FakeAudioContext.initialState = 'running';
+    const { primeAudio } = await loadAudio();
+    primeAudio();
+    primeAudio();
+    expect(FakeAudioContext.instances[0].resumes, 'a running context was resumed again').toBe(0);
+  });
+
+  it('survives a platform that refuses to build a context at all', async () => {
+    // Graceful failure: nothing throws, and notifications still happen — they
+    // are simply silent.
+    const { primeAudio, notifySound } = await loadAudio();
+    FakeAudioContext.throwOnConstruct = true;
+    expect(() => primeAudio()).not.toThrow();
+    expect(() => notifySound('message')).not.toThrow();
+  });
+
+  it('never builds a context while playing a notification', async () => {
+    // The defect this replaces: `new AudioContext()` inside notifySound.
+    const { primeAudio, notifySound } = await loadAudio();
+    primeAudio();
+    const afterPriming = FakeAudioContext.instances.length;
+
+    for (let i = 0; i < 10; i += 1) notifySound(i % 2 ? 'call' : 'message');
+
+    expect(FakeAudioContext.instances.length, 'a notification built a context of its own').toBe(afterPriming);
+  });
+
+  it('plays the chime once the context is running', async () => {
+    // The positive case, so the silent cases below cannot pass vacuously.
+    const { primeAudio, notifySound } = await loadAudio();
+    primeAudio();
+    notifySound('message');
+    expect(FakeAudioContext.instances[0].oscillators, 'no sound was produced for a message').toBeGreaterThan(0);
+  });
+
+  it('stays silent, without throwing, before any user interaction', async () => {
+    // Nothing has been primed, so iOS would ignore anything played. Silence is
+    // the honest outcome, and no context may be created to achieve it.
+    const { notifySound } = await loadAudio();
+    expect(() => notifySound('message')).not.toThrow();
+    expect(FakeAudioContext.instances.length, 'a notification created a context without a gesture').toBe(0);
+  });
+
+  it('stays silent while the platform has the context suspended', async () => {
+    // A backgrounded iOS app suspends audio. Playing into a suspended context
+    // would queue a sound that fires at some unrelated moment after the user
+    // returns — worse than silence.
+    const { primeAudio, notifySound } = await loadAudio();
+    primeAudio();
+    const [context] = FakeAudioContext.instances;
+    context.state = 'suspended';
+
+    expect(() => notifySound('message')).not.toThrow();
+    expect(context.oscillators, 'a sound was played into a suspended context').toBe(0);
+  });
+
+  it('does not close the context after playing, so it can be reused', async () => {
+    // A closed context cannot be resumed, so the old implementation's close()
+    // after each chime was itself part of the problem.
+    const { primeAudio, notifySound } = await loadAudio();
+    primeAudio();
+    notifySound('message');
+    expect(FakeAudioContext.instances[0].closes, 'the shared context was closed after playing').toBe(0);
+  });
+
+  it('resumes again after the platform suspends it, so sound returns', async () => {
+    // The foreground/return cycle: iOS suspends audio with the app, and
+    // `primeAudio` is called again on visibility change.
+    const { primeAudio, notifySound } = await loadAudio();
+    primeAudio();
+    const [context] = FakeAudioContext.instances;
+
+    context.state = 'suspended';
+    primeAudio();
+    expect(context.resumes, 'returning to the app did not resume audio').toBe(2);
+
+    notifySound('message');
+    expect(context.oscillators, 'sound did not come back after resuming').toBeGreaterThan(0);
+  });
+});
+
+describe('chat attachments are bounded before they are encrypted', () => {
+  /**
+   * The chat image path previously did no preparation at all: a 5 MB file
+   * became a ~6.7 MB base64 string inside the encrypted message body. That is
+   * a reliability problem rather than a tidiness one — a message body that size
+   * is unlikely to fit the Realtime event carrying it, so the recipient would
+   * not see the message until something forced a refetch.
+   *
+   * `preparePhotoAttachment` reads through `FileReader`, which does not exist
+   * here, so what is checked is the contract around the encoding: the limits,
+   * the fallbacks, and that a rejected file is rejected loudly.
+   */
+  it('accepts only images, and only within the file limit', async () => {
+    vi.stubGlobal('FileReader', class {
+      result: string | null = null;
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;

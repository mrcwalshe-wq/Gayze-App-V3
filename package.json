{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:setup": "npm install --no-save @electric-sql/pglite jsdom @testing-library/react @testing-library/dom",
    "test:push-sql": "node scripts/push-tests/sql.test.mjs",
    "test:push-sw": "node scripts/push-tests/sw.test.mjs",
    "test:profile-migration": "node scripts/profile-tests/migration.test.mjs",
    "test:profile": "tsx --import ./scripts/profile-tests/register-hooks.mjs scripts/profile-tests/profile.test.tsx",
    "test": "npm run test:push-sql && npm run test:push-e2e && npm run test:push-sw && npm run test:e2ee && npm run test:messaging && npm run test:icons && npm run test:discovery && npm run test:inspect-script && npm run test:interaction && npm run test:profile-migration && npm run test:profile",
    "test:push-e2e": "node scripts/push-tests/e2e.test.mjs",
    "test:e2ee": "tsx scripts/e2ee-tests/e2ee.test.mjs && node --test scripts/e2ee-tests/pipeline.test.mjs",
    "test:icons": "node --test scripts/icon-tests/icons.test.mjs",
    "test:timeline": "node --test scripts/chat-timeline-tests/timeline.test.mjs",
    "test:peek": "node --test scripts/profile-peek-tests/peek.test.mjs",
    "test:discovery": "node scripts/discovery-tests/public-wrapper.test.mjs",
    "test:inspect-script": "node scripts/discovery-tests/inspect-script.test.mjs",
    "test:interaction": "tsx --import ./scripts/interaction-tests/register-hooks.mjs scripts/interaction-tests/interaction.test.tsx",
    "test:messaging": "node --test scripts/messaging-tests/rls.test.mjs scripts/messaging-tests/keyring.test.mjs",
    "test:admin": "node --test scripts/admin-tests/sql.test.mjs && tsx --test scripts/admin-tests/handler.test.ts scripts/admin-tests/insights-text.test.ts",
    "test:notices": "node --test scripts/notices-tests/notices.test.mjs",
    "test:presence": "tsx --test scripts/presence-tests/label.test.ts scripts/presence-tests/unsend.test.ts scripts/presence-tests/sounds.test.ts scripts/presence-tests/note.test.ts scripts/presence-tests/rooms.test.ts scripts/presence-tests/decrypt-classify.test.ts scripts/chat-tests/auto-rekey.test.ts scripts/presence-tests/chat-archive.test.ts scripts/presence-tests/consent.test.ts scripts/presence-tests/gayze-cooldown.test.ts scripts/presence-tests/app-sounds.test.ts scripts/presence-tests/audio-unlock.test.ts scripts/presence-tests/age-gate.test.ts scripts/presence-tests/single-flight.test.ts scripts/presence-tests/haptic-pattern.test.ts scripts/presence-tests/intent-model.test.ts scripts/presence-tests/discovery-rows.test.ts scripts/presence-tests/events-model.test.ts scripts/presence-tests/online-merge.test.ts scripts/presence-tests/snack-kind.test.ts scripts/call-tests/voip.test.ts scripts/presence-tests/outbox.test.ts",
    "test:places": "tsx --test scripts/place-tests/place.test.ts scripts/place-tests/journey.test.ts scripts/place-tests/meetup.test.ts",
    "test:auth": "tsx --test scripts/auth-tests/auth.test.ts scripts/auth-tests/ios-google.test.ts",
    "test:location-fog": "node --test scripts/location-fog-tests/fog.test.mjs",
    "test:email": "node scripts/email-templates/build.mjs && node --test scripts/email-templates/templates.test.mjs",
    "test:visual": "bash scripts/e2e-docker.sh",
    "test:visual:update": "bash scripts/e2e-docker.sh --update-snapshots",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:pin": "node scripts/check-playwright-pin.mjs",
    "test:privacy": "node --test scripts/privacy-tests/privacy.test.mjs",
    "test:reliability": "node --test scripts/privacy-tests/reliability.test.mjs",
    "test:native-call": "node --test scripts/privacy-tests/native-call.test.mjs",
    "test:call-mailbox": "node --test scripts/privacy-tests/call-mailbox.test.mjs",
    "test:albums": "node --test scripts/privacy-tests/albums.test.mjs && tsx --test scripts/album-tests/crypto.test.ts scripts/album-tests/wire.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gayze-apple-sign-in": "file:plugins/gayze-apple-sign-in",
    "gayze-callkit": "file:plugins/gayze-callkit",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

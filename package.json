{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:setup": "npm install --no-save @electric-sql/pglite jsdom @testing-library/react @testing-library/dom",
    "test:push-sql": "node scripts/push-tests/sql.test.mjs",
    "test:push-sw": "node scripts/push-tests/sw.test.mjs",
    "test:profile-migration": "node scripts/profile-tests/migration.test.mjs",
    "test:profile": "tsx --import ./scripts/profile-tests/register-hooks.mjs scripts/profile-tests/profile.test.tsx",
    "test": "npm run test:push-sql && npm run test:push-e2e && npm run test:push-sw && npm run test:e2ee && npm run test:discovery && npm run test:inspect-script && npm run test:interaction && npm run test:profile-migration && npm run test:profile",
    "test:push-e2e": "node scripts/push-tests/e2e.test.mjs",
    "test:e2ee": "tsx scripts/e2ee-tests/e2ee.test.mjs && node --test scripts/e2ee-tests/pipeline.test.mjs",
    "test:discovery": "node scripts/discovery-tests/public-wrapper.test.mjs",
    "test:inspect-script": "node scripts/discovery-tests/inspect-script.test.mjs",
    "test:interaction": "tsx --import ./scripts/interaction-tests/register-hooks.mjs scripts/interaction-tests/interaction.test.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (publishable / anon key only — never put the service-role key in frontend env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Auth redirect URLs are derived at runtime from window.location.origin
# (local Vite and Cloudflare; workers.dev redirects use the permanent domain).
# Configure the same origins in the Supabase Dashboard → Authentication → URL Configuration.

# ---------------------------------------------------------------------------
# Web Push (PWA notifications)
# ---------------------------------------------------------------------------
# PUBLIC VAPID key. This is an application-server public key and is designed to
# be shipped to the browser — it is embedded in the client bundle at build time.
# Use the existing project public key. For a NEW setup only, generate a pair
# with: node scripts/generate-vapid-keys.mjs (do not casually rotate live keys).
VITE_VAPID_PUBLIC_KEY=

# The matching PRIVATE key is a SERVER SECRET. It must NEVER appear here, in
# any VITE_* variable, in the client bundle, or in Git. Set it only as a
# Supabase Edge Function secret:
#
#   supabase secrets set \
#     VAPID_PUBLIC_KEY=<public>  \
#     VAPID_PRIVATE_KEY=<private> \
#     VAPID_SUBJECT=mailto:support@gayze.co.uk \
#     PUSH_DISPATCH_SECRET=<long random string>
#
# See docs/PUSH_NOTIFICATIONS.md for the full setup.

# WebRTC: Cloudflare TURN is fetched at runtime from the authenticated Supabase
# function `webrtc-ice-servers`. Provider API keys remain in that function's
# server-side secrets. Its response should include iceServers and expiresAt
# (epoch seconds/milliseconds or ISO), ttlSeconds, or ttl (seconds).
# Optional PUBLIC STUN-only override. Never put TURN credentials/API keys in
# VITE_* variables; all Vite variables are public build output.
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.cloudflare.com:3478"}]

# Push server configuration is NOT a VITE_* value. Keep the existing VAPID
# pair in Supabase secrets; the public half above must match registered devices.
# Server-only PUSH_ALLOWED_ORIGINS lists exact approved browser origins
# (default https://gayze.co.uk). ECE_KEYLOG must be unset or 0, never 1.
# The durable inbox migration, Vault dispatch settings and drain schedule are
# required before a future coordinated release: see docs/PUSH_NOTIFICATIONS.md.

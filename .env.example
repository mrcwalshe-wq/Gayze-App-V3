# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (publishable / anon key only — never put the service-role key in frontend env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Auth redirect URLs are derived at runtime from window.location.origin
# (works for local Vite http://localhost:3000 and Vercel production).
# Configure the same origins in the Supabase Dashboard → Authentication → URL Configuration.

# ---------------------------------------------------------------------------
# Web Push (PWA notifications)
# ---------------------------------------------------------------------------
# PUBLIC VAPID key. This is an application-server public key and is designed to
# be shipped to the browser — it is embedded in the client bundle at build time.
# Generate a pair with: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=

# The matching PRIVATE key is a SERVER SECRET. It must NEVER appear here, in
# any VITE_* variable, in the client bundle, or in Git. Set it only as a
# Supabase Edge Function secret:
#
#   supabase secrets set \
#     VAPID_PUBLIC_KEY=<public>  \
#     VAPID_PRIVATE_KEY=<private> \
#     VAPID_SUBJECT=mailto:support@gayze.co.uk \
#     PUSH_DISPATCH_SECRET=<long random string>
#
# See docs/PUSH_NOTIFICATIONS.md for the full setup.
